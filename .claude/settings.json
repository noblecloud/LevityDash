{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "_openlore": true,
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes openlore orient --json"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "_openlore": true,
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes openlore orient --inject"
          }
        ]
      }
    ]
  }
}
