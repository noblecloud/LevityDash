        x: 6.579%
        y: 6.102%
        width: 86.842%
        height: 87.797%
      items:
      - type: group
        name: planes
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 100%
        items:
        - type: text
          text: OVERHEAD · NM
          font: Barlow Condensed
          weight: SemiBold
          color: $info
          alignment: BottomLeft
          geometry:
            x: 0.0%
            y: 0.0%
            width: 60.0%
            height: 5.792%
          matchingGroup:
            group: global.cap
            matchAll: true
          tracking: 0.16
          format-hint: HEADING
        - type: realtime.text
          key: aircraft.count
          title: false
          alignment: TopRight
          display:
            unitPosition: Hidden
            precision: 0
            valueLabel:
              color: $info
              font: $mono
              weight: Bold
            format-hint: '00'
          geometry:
            x: 60.0%
            y: -1.544%
            width: 40.0%
            height: 8.88%
        - type: polar
          name: radar
          plot: radar
          prefix: aircraft
          slots: 15
          max: 30
          labels: 4
          sweep: true
          rings: 3
          accent: $info
          gradient:
          - at: 0
            color: $bad
          - at: 8000
            color: $warn
          - at: 40000
            color: $info
          geometry:
            x: -2.525%
            y: 7.336%
            width: 105.051%
            height: 92.664%
        when: aircraft.active
      - type: group
        name: dayClock
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 100%
