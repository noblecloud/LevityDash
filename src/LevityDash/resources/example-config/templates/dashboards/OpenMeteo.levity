        bottom: 0%
      environment.light.irradiance.irradiance:
        plot:
          type: plot
          weight: 0.5
          opacity: 0.75
          fill:
            opacity: 0.35
            fade: true
          color: $warn
          glow: *id001
      min: 0
      max: 1000
  - type: realtime.text
    key: astronomy.sun.remaining
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
