# The default dashboard for OpenMeteo, the forecast LevityDash starts with.
#
# Top: the clock (the date on its own line, the time, the moon over am or pm), the temperature with the day's high and
# low in bold colour, and the daylight left over today's sunlight. Middle: two and a half days ahead, with
# today's temperature round a 24 hour clock. Bottom: wind, rain, pressure, the sky, and the last 24 hours.
#
# Every key comes from OpenMeteo or the built-in Astronomy plugin. Fonts are the bundled Nunito and Barlow Condensed.
# Colours are theme tokens: pick a theme from Dashboard > Theme to recolour it.
#
# Generated by docs/design-references/showcase/default.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity src/LevityDash/resources/example-config/templates/dashboards/OpenMeteo.levity
#           --scenario docs/design-references/showcase/scenarios/default.yaml --size 2880x1800 --freeze-time 2026-06-21T09:20:00
items:
- type: group
  name: board
  items:
  - type: clock
    name: clock
    frozen: true
    geometry:
      height: 22.2%
      width: 36.5%
      x: 0%
      y: 1.6%
    items:
    - format: '%A, %B %-d'
      alignment: CenterRight
      filters:
      - AddOrdinal
      geometry:
        height: 27%
        width: 100%
        x: 0%
        y: 0%
      margins:
        left: 10px
    - format: '%-I:%M'
      alignment: CenterRight
      format-hint: '10:00'
      geometry:
        height: 73%
        width: 80%
        x: 1.2%
        y: 27%
      margins:
        right: 10px
    - type: moon
      geometry:
        height: 45%
        width: 18.8%
        x: 81.2%
        y: 27%
      glowStrength: 2
      interval:
        minutes: 20
    - format: '%p'
      filters:
      - Lower
      geometry:
        height: 29.6%
        width: 18.8%
        x: 81.2%
        y: 70.4%
  - type: text
    text: OUTSIDE
    font: Barlow Condensed
    weight: SemiBold
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 39.5%
      y: 2.8%
      width: 12%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.temperature
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color:
          scale: $temperature
          of: environment.temperature.temperature
        font: $body
        weight: Black
        tracking: -0.04
      format-hint: 00°
    geometry:
      x: 39.1%
      y: 4.6%
      width: 16%
      height: 15.6%
  - type: text
    text: HIGH
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 56.1%
      y: 4.8%
      width: 7%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.high
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $bad
        font: $body
        weight: Bold
        matchingGroup:
          group: global.hilo
          matchAll: true
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 56.1%
      y: 6.8%
      width: 8%
      height: 5.8%
  - type: text
    text: LOW
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 56.1%
      y: 13.4%
      width: 7%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.low
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $info
        font: $body
        weight: Bold
        matchingGroup:
          group: global.hilo
          matchAll: true
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 56.1%
      y: 15.4%
      width: 8%
      height: 5.8%
  - type: realtime.bar
    key: environment.temperature.temperature
    title: false
    geometry:
      x: 39.5%
      y: 20.9%
      width: 24.6%
      height: 2.2%
    display:
      range:
        min: 30
        max: 100
      track:
        weight: 42%
        color: $rule
      fill:
        color: $accent
        from: environment.temperature.low
        to: environment.temperature.high
        gradient: $temperature
        weight: 42%
        glow: &id001
          strength: 1.2
          reach: 2.0
          passes: 6
      value-label:
        visible: false
      pointer:
        type: line
        color: $accent
        size: 100%
  - type: realtime.text
    key: environment.condition.condition
    title: false
    alignment: CenterLeft
    geometry:
      x: 39.5%
      y: 23.6%
      width: 10%
      height: 2.4%
    display:
      valueLabel:
        color: $muted
        font: $body
        weight: Light
        italic: true
        matchingGroup:
          group: global.line
          matchAll: true
  - type: text
    text: feels
    font: $body
    weight: Light
    color: $faint
    alignment: CenterRight
    geometry:
      x: 49.7%
      y: 23.6%
      width: 3.6%
      height: 2.4%
    matchingGroup:
      group: global.line
      matchAll: true
    italic: true
  - type: realtime.text
    key: environment.temperature.feelsLike
    title: false
    alignment: CenterLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $text
        font: $body
        weight: SemiBold
        matchingGroup:
          group: global.line
          matchAll: true
      format-hint: 00°
    geometry:
      x: 53.7%
      y: 23.6%
      width: 4%
      height: 2.4%
  - type: text
    text: dew
    font: $body
    weight: Light
    color: $faint
    alignment: CenterRight
    geometry:
      x: 57.7%
      y: 23.6%
      width: 2.8%
      height: 2.4%
    matchingGroup:
      group: global.line
      matchAll: true
    italic: true
  - type: realtime.text
    key: environment.temperature.dewpoint
    title: false
    alignment: CenterLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $good
        font: $body
        weight: SemiBold
        matchingGroup:
          group: global.line
          matchAll: true
      format-hint: 00°
    geometry:
      x: 60.9%
      y: 23.6%
      width: 4%
      height: 2.4%
  - type: text
    text: DAYLIGHT LEFT
    font: Barlow Condensed
    weight: SemiBold
    color: $warn
    alignment: BottomLeft
    geometry:
      x: 68.5%
      y: 2.8%
      width: 16%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: mini-graph
    geometry:
      x: 68.5%
      y: 7%
      width: 18%
      height: 13.6%
    timeframe:
      hours: 24
      lookback:
        hours: 48
      offset:
        hours: -24
    annotations:
      dayLabels:
        enabled: false
      hourLabels:
        enabled: false
      lines:
        enabled: false
    indicator:
      opacity: 0
    figures:
    - figure: fig1
      margins:
        top: 25%
        bottom: 0%
      environment.light.irradiance.irradiance:
        plot:
          type: plot
          weight: 0.5
          opacity: 0.75
          fill:
            opacity: 0.35
            fade: true
          color: $warn
          glow: *id001
      min: 0
      max: 1000
  - type: realtime.text
    key: astronomy.sun.remaining
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $text
        font: $body
        weight: ExtraLight
        tracking: -0.02
      format-hint: 00h 00m
      format: duration
    geometry:
      x: 68.5%
      y: 4.6%
      width: 18%
      height: 9%
  - type: realtime.bar
    key: astronomy.sun.remaining
    title: false
    geometry:
      x: 68.5%
      y: 21.2%
      width: 18%
      height: 2.2%
    display:
      range:
        min: 0
        max: 960
      track:
        weight: 100%
        color: $rule
        segments: 16
        gap: 18%
      fill:
        color: $accent
        gradient:
          0: $accent
          1: $warn
        segments: 16
        gap: 18%
        weight: 100%
        glow: *id001
      value-label:
        visible: false
  - type: text
    text: SUNRISE
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 88.3%
      y: 4.6%
      width: 9.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.sunrise
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 88.3%
      y: 6.5%
      width: 9.6%
      height: 5.2%
  - type: text
    text: SUNSET
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 88.3%
      y: 12.2%
      width: 9.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.sunset
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $accent
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 88.3%
      y: 14.1%
      width: 9.6%
      height: 5.2%
  - type: text
    text: SUN · W/M²
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 88.3%
      y: 19.8%
      width: 9.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.irradiance.irradiance
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '000'
    geometry:
      x: 88.3%
      y: 21.7%
      width: 9.6%
      height: 4.4%
  - type: graph
    name: forecast
    geometry:
      x: 1.5%
      y: 28.5%
      width: 69.5%
      height: 37%
    timeframe:
      days: 2
      hours: 18
      offset:
        hours: -6
    annotations:
      dayLabels:
        position: Center
        alignment: Center
        opacity: 12%
        height: 38%
      hourLabels:
        alignment: BottomCenter
        spacingIntervals: 6, 12
        height: 4%
      lines:
        spacing: 12 mm
        weight: 0.4
    figures:
    - figure: sky
      margins:
        top: 3%
        bottom: 87%
      environment.temperature.dewpoint:
        plot:
          type: strip
          pins:
            key: environment.precipitation.precipitation
            size: 30
            at: 0.5
            color: $info
            spacing: 3.2
            steps:
            - - 0
              - wi:day-cloudy
            - - 0.02
              - wi:sprinkle
            - - 0.1
              - wi:showers
            - - 0.2
              - wi:rain
    - figure: arrows
      margins:
        top: 13%
        bottom: 80%
      environment.temperature.dewpoint:
        plot:
          type: strip
          pins:
            key: environment.wind.direction.direction
            glyph: wi:direction-up
            rotate: 180
            size: 24
            at: 0.5
            spacing: 3.4
            color: $faint
    - figure: temperature
      margins:
        top: 28%
        bottom: 30%
      environment.temperature.temperature:
        labels:
          enabled: true
        plot:
          type: plot
          gradient: TemperatureGradient
          weight: 1.0
          glow: *id001
          fill:
            opacity: 0.35
            fade: true
        resolution: 2
      environment.temperature.feelsLike:
        plot:
          type: plot
          gradient: TemperatureGradient
          weight: 0.3
          opacity: 0.6
      environment.temperature.dewpoint:
        plot:
          type: plot
          color: $good
          dashPattern: 5, 5
          weight: 0.35
          cap: square
    - figure: clouds
      margins:
        top: 72%
        bottom: 9%
      min: 0
      max: 1
      environment.clouds.cover.cover:
        plot:
          type: plot
          color: $faint
          weight: 0.3
          opacity: 0.6
          fill:
            opacity: 0.12
            fade: true
    - figure: rain
      margins:
        top: 70%
        bottom: 9%
      min: 0
      max: 0.4
      environment.precipitation.precipitation:
        plot:
          type: bar
          color: $info
          width: 0.62
          radius: 0.5
          glow: *id001
        smooth: false
  - type: text
    text: TODAY, ROUND THE CLOCK
    font: Barlow Condensed
    weight: SemiBold
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 74%
      y: 28.5%
      width: 24%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: polar
    name: dayClock
    plot: clock
    key: environment.temperature.temperature
    window: today
    gradient: $temperature
    marks: false
    geometry:
      x: 74.5%
      y: 31.4%
      width: 23%
      height: 34%
  - type: group
    name: windCard
    geometry:
      x: 2.0%
      y: 68.5%
      width: 18.24%
      height: 29.5%
    items:
    - type: text
      text: WIND · MPH
      font: Barlow Condensed
      weight: SemiBold
      color: $series-6
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 6.102%
        width: 86.842%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: mini-graph
      geometry:
        x: 6.579%
        y: 13.22%
        width: 42.763%
        height: 33.898%
      timeframe:
        hours: 12
        lookback:
          hours: 0
        offset:
          hours: 0
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
        opacity: 0
      figures:
      - figure: fig2
        margins:
          top: 55%
          bottom: 2%
        environment.wind.speed.speed:
          plot:
            type: plot
            weight: 0.45
            opacity: 0.6
            fill:
              opacity: 0.25
              fade: true
            color: $series-6
            glow: *id001
        min: 0
    - type: realtime.text
      key: environment.wind.speed.speed
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $series-6
          font: $body
          weight: Bold
          matchingGroup:
            group: global.hero
            matchAll: true
          tracking: -0.03
        format-hint: '00'
      geometry:
        x: 6.579%
        y: 13.22%
        width: 42.763%
        height: 33.898%
    - type: polar
      name: rose
      plot: rose
      direction: environment.wind.direction.direction
      speed: environment.wind.speed.speed
      window: 24h
      legend: false
      rings: 3
      compass: 4
      gradient: WindSpeedGradient
      geometry:
        x: 47.149%
        y: 2.712%
        width: 49.342%
        height: 55.593%
    - type: text
      text: GUST
      font: Barlow Condensed
      weight: SemiBold
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 66.441%
        width: 27.412%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: environment.wind.speed.gust
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $warn
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '00'
      geometry:
        x: 6.579%
        y: 72.881%
        width: 27.412%
        height: 17.627%
    - type: text
      text: PEAK
      font: Barlow Condensed
      weight: SemiBold
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 36.184%
        y: 66.441%
        width: 29.605%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: environment.wind.speed.gustMax
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $bad
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '00'
      geometry:
        x: 36.184%
        y: 72.881%
        width: 29.605%
        height: 17.627%
    - type: text
      text: FROM
      font: Barlow Condensed
      weight: SemiBold
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 67.982%
        y: 66.441%
        width: 25.219%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: environment.wind.direction.direction
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $info
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: SSW
      geometry:
        x: 67.982%
        y: 72.881%
        width: 25.219%
        height: 17.627%
    border:
      enabled: true
      radius: 24px
      fill: $surface
      weight: 0
  - type: group
    name: rainCard
    geometry:
      x: 21.44%
      y: 68.5%
      width: 18.24%
      height: 29.5%
    items:
    - type: text
      text: RAIN · INCHES
      font: Barlow Condensed
      weight: SemiBold
      color: $info
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 6.102%
        width: 86.842%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: environment.precipitation.daily
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $info
          font: $body
          weight: Bold
          matchingGroup:
            group: global.hero
            matchAll: true
          tracking: -0.03
        format-hint: '0.00'
      geometry:
        x: 6.579%
        y: 13.22%
        width: 52.632%
        height: 33.898%
    - type: text
      text: today
      font: $body
      weight: Light
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 60.307%
        y: 34.237%
        width: 32.895%
        height: 8.814%
      italic: true
    - type: mini-graph
      geometry:
        x: 6.579%
        y: 48.814%
        width: 86.842%
        height: 15.593%
      timeframe:
        hours: 24
        lookback:
          hours: 0
        offset:
          hours: 0
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
        opacity: 0
      figures:
      - figure: fig3
        margins:
          top: 4%
          bottom: 2%
        environment.precipitation.precipitation:
          plot:
            type: bar
            opacity: 1
            width: 0.6
            color: $info
            glow: *id001
            radius: 0.5
          smooth: false
        min: 0
        max: 0.4
    - type: text
      text: NOW
      font: Barlow Condensed
      weight: SemiBold
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 66.441%
        width: 28.509%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: environment.precipitation.precipitation
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $info
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '0.00'
      geometry:
        x: 6.579%
        y: 72.881%
        width: 28.509%
        height: 14.915%
    - type: text
      text: PEAK
      font: Barlow Condensed
      weight: SemiBold
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 37.281%
        y: 66.441%
        width: 28.509%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: max(environment.precipitation.precipitation, today)
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $series-4
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '0.00'
      geometry:
        x: 37.281%
        y: 72.881%
        width: 28.509%
        height: 14.915%
    - type: text
      text: +12 H
      font: Barlow Condensed
      weight: SemiBold
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 67.982%
        y: 66.441%
        width: 25.219%
        height: 5.085%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.16
      format-hint: HEADING
    - type: realtime.text
      key: at(environment.precipitation.precipitation, 12h)
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $faint
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '0.00'
      geometry:
        x: 67.982%
        y: 72.881%
        width: 25.219%
