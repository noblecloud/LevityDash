    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 62.9%
      y: 12.0%
      width: 4.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.dewpoint
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $good
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00°
    geometry:
      x: 62.9%
      y: 13.9%
      width: 4.6%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: DAYLIGHT LEFT
    font: Barlow Condensed
    weight: SemiBold
    color: $warn
    alignment: BottomLeft
    geometry:
      x: 68.5%
      y: 2.8%
      width: 16%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
