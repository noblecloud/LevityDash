        font: $mono
        weight: Light
        matchingGroup:
          group: global.room
          matchAll: true
        tracking: -0.04
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00h 00m
      format: duration
    geometry:
      x: 68.5%
      y: 4.6%
      width: 18%
      height: 9%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: realtime.bar
    key: astronomy.sun.remaining
    title: false
    geometry:
      x: 68.5%
      y: 21.2%
      width: 18%
      height: 2.2%
    display:
      range:
        min: 0
        max: 960
      track:
        weight: 100%
        color: $rule
        segments: 16
        gap: 18%
      fill:
        color: $accent
        gradient:
          0: $accent
          1: $warn
        segments: 16
        gap: 18%
        weight: 100%
        glow: *id001
      value-label:
        visible: false
  - type: text
    text: SUNRISE
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomRight
    geometry:
      x: 88.3%
      y: 2.8%
      width: 9.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.sunrise
    title: false
    alignment: BottomRight
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomRight
        margins:
          left: 10%
          right: 0
          top: 0
          bottom: 0
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 88.3%
      y: 4.7%
      width: 9.6%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: SUNSET
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomRight
    geometry:
      x: 88.3%
      y: 10.4%
      width: 9.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.sunset
    title: false
    alignment: BottomRight
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $accent
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomRight
        margins:
          left: 10%
          right: 0
          top: 0
          bottom: 0
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 88.3%
      y: 12.3%
      width: 9.6%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: SUN · W/M²
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomRight
    geometry:
      x: 88.3%
      y: 18.0%
      width: 9.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.irradiance.irradiance
    title: false
    alignment: BottomRight
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomRight
        margins:
          left: 10%
          right: 0
          top: 0
          bottom: 0
      format-hint: '000'
    geometry:
      x: 88.3%
      y: 19.9%
      width: 9.6%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: graph
    name: forecast
    geometry:
      x: 1.5%
      y: 28.5%
      width: 69.5%
      height: 37%
    timeframe:
      days: 2
      hours: 18
      offset:
        hours: -6
    annotations:
      dayLabels:
        position: Center
        alignment: Center
        opacity: 12%
        height: 38%
      hourLabels:
        alignment: BottomCenter
        spacingIntervals: 6, 12
        height: 4%
      lines:
        spacing: 12 mm
        weight: 0.4
    figures:
    - figure: sky
      margins:
        top: 3%
        bottom: 87%
      environment.temperature.dewpoint:
        plot:
          type: strip
          pins:
            key: environment.precipitation.precipitation
            size: 30
            at: 0.5
            color: $info
            spacing: 3.2
            steps:
            - - 0
              - wi:day-cloudy
            - - 0.02
              - wi:sprinkle
            - - 0.1
              - wi:showers
            - - 0.2
              - wi:rain
    - figure: arrows
      margins:
        top: 13%
        bottom: 80%
      environment.temperature.dewpoint:
        plot:
          type: strip
          pins:
            key: environment.wind.direction.direction
            glyph: wi:direction-up
            rotate: 180
            size: 24
            at: 0.5
            spacing: 3.4
            color: $faint
    - figure: temperature
      margins:
        top: 28%
        bottom: 30%
      environment.temperature.temperature:
        labels:
          enabled: true
        plot:
          type: plot
          gradient: TemperatureGradient
          weight: 1.0
          glow: *id001
          fill:
            opacity: 0.35
            fade: true
        resolution: 2
      environment.temperature.feelsLike:
        plot:
          type: plot
          gradient: TemperatureGradient
          weight: 0.3
          opacity: 0.6
      environment.temperature.dewpoint:
        plot:
          type: plot
          color: $good
          dashPattern: 5, 5
          weight: 0.35
          cap: square
    - figure: clouds
      margins:
        top: 72%
        bottom: 9%
      min: 0
      max: 1
      environment.clouds.cover.cover:
        plot:
          type: plot
          color: $faint
          weight: 0.3
          opacity: 0.6
          fill:
            opacity: 0.12
            fade: true
    - figure: rain
      margins:
        top: 70%
        bottom: 9%
      min: 0
      max: 0.4
      environment.precipitation.precipitation:
        plot:
          type: bar
          color: $info
          width: 0.62
          radius: 0.5
          glow: *id001
        smooth: false
  - type: text
    text: INDOOR
    font: Barlow Condensed
    weight: SemiBold
    color: $series-2
    alignment: BottomLeft
    geometry:
      x: 74.5%
      y: 28.5%
