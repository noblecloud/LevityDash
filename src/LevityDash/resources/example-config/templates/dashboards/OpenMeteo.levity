# The default dashboard for OpenMeteo, the forecast LevityDash starts with.
#
# Top: the clock (the date on its own line, the time, the moon over am or pm), the temperature with the day's high and
# low, and the daylight left over today's sunlight. Middle: two and a half days ahead, and indoors (a Govee sensor's
# temperature over its last day, humidity, dew point, feels like). Bottom: wind, rain, pressure, the sky, and today's
# temperature round a 24 hour clock.
#
# Every outdoor key comes from OpenMeteo or the built-in Astronomy plugin; the indoor ones need a Govee sensor and stay
# empty without one. Fonts are the bundled Nunito, Roboto Mono (the numbers) and Barlow Condensed (the labels). Colours
# are theme tokens: pick a theme from Dashboard > Theme to recolour it.
#
# Generated by docs/design-references/showcase/default.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity src/LevityDash/resources/example-config/templates/dashboards/OpenMeteo.levity
#           --scenario docs/design-references/showcase/scenarios/default.yaml --size 2880x1800 --freeze-time 2026-06-21T09:20:00
background:
  sky: true
  haze: environment.clouds.cover.cover
  stars: true
theme:
  extends: default
  colors:
    moon-shade:
      color: '#000000'
      alpha: 0.2
items:
- type: group
  name: board
  items:
  - type: clock
    name: clock
    frozen: true
    geometry:
      height: 22.2%
      width: 36.5%
      x: 0%
      y: 1.6%
    items:
    - format: '%A, %B %-d'
      alignment: CenterRight
      filters:
      - AddOrdinal
      geometry:
        height: 27%
        width: 100%
        x: 0%
        y: 0%
      margins:
        left: 10px
    - format: '%-I:%M'
      alignment: BottomRight
      format-hint: '10:00'
      geometry:
        height: 73%
        width: 80%
        x: 1.2%
        y: 27%
      margins:
        right: 10px
    - type: moon
      geometry:
        height: 45%
        width: 18.8%
        x: 81.2%
        y: 27%
      glowStrength: 0
      interval:
        minutes: 20
    - format: '%p'
      filters:
      - Lower
      alignment: BottomLeft
      format-hint: am
      geometry:
        height: 29.6%
        width: 18.8%
        x: 81.2%
        y: 70.4%
  - type: text
    text: OUTSIDE
    font: Barlow Condensed
    weight: SemiBold
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 39.5%
      y: 2.8%
      width: 12%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.temperature
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color:
          scale: $temperature
          of: environment.temperature.temperature
        font: Allo Variable
        weight: Black
        tracking: -0.04
        font-axes:
          range:
          - 20°F
          - 95°F
          wght:
          - 600
          - 900
          ROND:
          - 0
          - 100
          opsz: 32
          corner:
          - 0
          - 0.05
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00°
    geometry:
      x: 39.5%
      y: 4.6%
      width: 15.4%
      height: 15.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: HIGH
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 56.1%
      y: 2.8%
      width: 7%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.high
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $bad
        font: Allo Variable
        weight: Bold
        matchingGroup:
          group: global.room
          matchAll: true
        font-axes:
          range:
          - 20°F
          - 95°F
          wght:
          - 500
          - 800
          ROND:
          - 0
          - 100
          opsz: 32
          corner:
          - 0
          - 0.05
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 56.1%
      y: 4.6%
      width: 8%
      height: 5.8%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: LOW
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 56.1%
      y: 12.0%
      width: 7%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.low
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $info
        font: Allo Variable
        weight: Bold
        matchingGroup:
          group: global.room
          matchAll: true
        font-axes:
          range:
          - 20°F
          - 95°F
          wght:
          - 500
          - 800
          ROND:
          - 0
          - 100
          opsz: 32
          corner:
          - 0
          - 0.05
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 56.1%
      y: 13.8%
      width: 8%
      height: 5.8%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: realtime.bar
    key: environment.temperature.temperature
    title: false
    geometry:
      x: 39.5%
      y: 20.9%
      width: 24.6%
      height: 2.2%
    display:
      range:
        min: 30
        max: 100
      track:
        weight: 42%
        color: $rule
      fill:
        color: $accent
        from: environment.temperature.low
        to: environment.temperature.high
        gradient: $temperature
        weight: 42%
        glow: &id001
          strength: 1.2
          reach: 2.0
          passes: 6
      value-label:
        visible: false
      pointer:
        type: line
        color: $accent
        size: 100%
  - type: realtime.text
    key: environment.condition.condition
    title: false
    alignment: CenterLeft
    geometry:
      x: 39.5%
      y: 23.6%
      width: 10%
      height: 2.4%
    display:
      valueLabel:
        color: $muted
        font: $body
        weight: Light
        italic: true
        matchingGroup:
          group: global.detail
          matchAll: true
  - type: text
    text: feels
    font: $body
    weight: Light
    color: $faint
    alignment: CenterRight
    geometry:
      x: 49.7%
      y: 23.6%
      width: 3.6%
      height: 2.4%
    matchingGroup:
      group: global.detail
      matchAll: true
    italic: true
  - type: realtime.text
    key: environment.temperature.feelsLike
