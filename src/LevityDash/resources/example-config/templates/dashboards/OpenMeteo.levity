  - type: realtime.bar
    key: indoor.battery.battery
    title: false
    geometry:
      x: 88.55%
      y: 28.725%
      width: 2.4%
      height: 1.05%
    display:
      style: battery
      range:
        min: 0
        max: 100
      fill:
        color: zone
      zones:
      - to: 20
        color: $bad
        opacity: 0
      - from: 20
        to: 50
        color: $warn
        opacity: 0
      - from: 50
        color: $good
        opacity: 0
      value-label:
        visible: false
  - type: mini-graph
    geometry:
      x: 74.5%
      y: 30.8%
      width: 23.5%
      height: 27.1%
    timeframe:
      hours: 24
      lookback:
        hours: 48
      offset:
        hours: -24
    annotations:
      dayLabels:
        enabled: false
      hourLabels:
        enabled: false
      lines:
        enabled: false
    indicator:
      opacity: 0
    figures:
    - figure: fig2
      margins:
        top: 42%
        bottom: 0%
      indoor.temperature.temperature:
        plot:
          type: plot
          weight: 0.5
          opacity: 0.8
          fill:
            opacity: 0.3
            fade: true
          color: $series-2
          glow: *id001
  - type: realtime.text
    key: indoor.temperature.temperature
    title: false
    alignment: TopLeft
    display:
      unitPosition: Inline
      precision: 1
      valueLabel:
        color: $text
        font: Allo Variable
        weight: Bold
        matchingGroup:
          group: global.room
          matchAll: true
        tracking: -0.06
        font-axes:
          range:
          - 20°F
          - 95°F
          wght:
          - 500
          - 800
          ROND:
          - 0
          - 100
          opsz: 32
        alignment: TopLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
        decimal-scale: 0.36
        decimal-align: baseline
      format-hint: 00.0°
    geometry:
      x: 74.5%
      y: 30.8%
      width: 16.45%
      height: 11.5%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: RH
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 74.5%
      y: 60.1%
      width: 7.233%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: indoor.humidity.humidity
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $info
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00%
    geometry:
      x: 74.5%
      y: 62.0%
      width: 7.233%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: DEW
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 82.333%
      y: 60.1%
      width: 7.233%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: indoor.temperature.dewpoint
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $good
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00°
    geometry:
      x: 82.333%
      y: 62.0%
      width: 7.233%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: FEELS
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomRight
    geometry:
      x: 90.167%
      y: 60.1%
      width: 7.233%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: indoor.temperature.heatIndex
    title: false
    alignment: BottomRight
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $warn
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomRight
        margins:
          left: 10%
          right: 0
          top: 0
          bottom: 0
      format-hint: 00°
    geometry:
      x: 90.167%
      y: 62.0%
      width: 7.233%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: band
    name: cards
    mode: step
