    alignment: CenterLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $text
        font: $mono
        weight: SemiBold
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: CenterLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00°
    geometry:
      x: 53.7%
      y: 23.6%
      width: 4%
      height: 2.4%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: RH
    font: Barlow Condensed
    weight: SemiBold
    color: $faint
    alignment: BottomLeft
    geometry:
      x: 62.9%
      y: 2.8%
      width: 4.6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.16
    format-hint: HEADING
  - type: realtime.text
    key: environment.humidity.humidity
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $info
        font: $mono
        weight: Regular
        matchingGroup:
          group: global.detail
          matchAll: true
        alignment: BottomLeft
        margins:
          left: 0
          right: 10%
          top: 0
          bottom: 0
      format-hint: 00%
    geometry:
      x: 62.9%
      y: 4.7%
      width: 4.6%
      height: 3.6%
    margins:
      left: 0
      right: 0
      top: 0
      bottom: 0
  - type: text
    text: DEW
