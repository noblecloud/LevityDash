# Gauge showcase: a board of 32 cards in the style of gauge-ui (github.com/thordursk/gauge-ui, MIT).
# Rows: Weather, System monitor, Vehicle / power / home, Health and variants.
# Weather values come from the real sources (or a --scenario). The System, Vehicle, Power,
# Health, Air quality, Thermostat and Timer cards read made-up values from the Mock plugin
# (src/LevityDash/lib/plugins/builtin/Mock.py), which is off until Mock.ini says `enabled = True`.
#
# Look: dark grey track (`arc: {color}`), a coloured accent per section, Roboto Mono for the
# numbers on instrument cards, values capped at 12-15% of the dial (`value-label: {size}`),
# small mono captions (size group `cap`) under larger titles (size group `title`).
# Every size is a share of the card, so the board scales with the window. Target 1934x1170.
# Hex colours are quoted; unquoted, '#' starts a YAML comment.
# Render: render_dashboard.py OUT.png --levity THIS --scenario stormy-day --size 1934x1170 --settle 14

- type: group
  name: main
  items:
    - type: group
      name: temperature
      geometry: {x: 0.0%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: temperatureTitle
          text: "Temperature"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffb454'}
        - type: text
          name: temperatureCap
          text: "feels like 54, 270 degree sweep"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: temperatureGauge
          key: environment.temperature.temperature
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 7%, color: '#2a2a31', cap: flat}
            range: {min: 40, max: 100}
            zones:
            - {from: 40, to: 60, color: '#4aa3ff'}
            - {from: 60, to: 80, color: '#ffb454'}
            - {from: 80, to: 100, color: '#ff4b3e'}
            fill: {weight: 7%, color: zone}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 20
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 4}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 14%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 12%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: wind
      geometry: {x: 12.5%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: windTitle
          text: "Wind direction"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#5ab4ff'}
        - type: text
          name: windCap
          text: "compass card, triangle needle"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: compassGauge
          key: environment.wind.direction.direction
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 90%
            arc: {start-angle: 0, end-angle: 360, weight: 1.2%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 360}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 45
              labels:
                position: inside
                height: 20%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
                text: compass
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 5}
            micro: {enabled: false}
            needle: {type: triangle, length: 11%, width: 7%, color: '#5ab4ff'}
            value-label: {position: center, size: 14%, color: '#ffffff', value-padding: 7%}
    - type: group
      name: pressure
      geometry: {x: 25.0%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: pressureTitle
          text: "Pressure"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#4dd0c4'}
        - type: text
          name: pressureCap
          text: "barometer, set hand 3 h ago"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: pressureGauge
          key: environment.pressure.pressure
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 1.5%, color: '#2a2a31', cap: flat}
            range: {min: 28, max: 32}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 2
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 0.2}
            micro: {enabled: false}
            needle: {type: needle, length: 72%, width: 4%, color: '#4dd0c4'}
            markers:
            - {value: at(environment.pressure.pressure, -3h), type: marker, length: 9%, color: '#ffffff'}
            value-label: {position: below, size: 11%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 12%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: windSpeed
      geometry: {x: 37.5%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: windSpeedTitle
          text: "Wind speed"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ff8a3d'}
        - type: text
          name: windSpeedCap
          text: "wind gradient, gust marker"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: speedGauge
          key: environment.wind.speed.speed
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 94%
            arc: {start-angle: -120, end-angle: 120, weight: 6%, color: '#2a2a31', cap: flat, gradient: WindSpeedGradient}
            range: {min: 0, max: 60}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 20
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 5}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            markers:
            - {value: environment.wind.speed.gust, type: marker, length: 12%, color: '#ff4b3e'}
            value-label: {position: center, size: 14%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 12%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: humidity
      geometry: {x: 50.0%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: humidityTitle
          text: "Humidity"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#4dd0c4'}
        - type: text
          name: humidityCap
          text: "half dial, comfort gradient"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: humidityGauge
          key: environment.humidity.humidity
          title: false
          geometry: {x: 8%, y: 14%, width: 84%, height: 70%}
          display:
            radius: 78%
            arc: {start-angle: -90, end-angle: 90, weight: 8%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 100}
            zones:
            - {to: 30, color: '#e5a135'}
            - {from: 30, to: 60, color: '#4caf50'}
            - {from: 60, color: '#4aa3ff'}
            fill: {weight: 8%, color: zone}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 50
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: below, size: 15%, color: '#ffffff', value-padding: 7%}
    - type: group
      name: clouds
      geometry: {x: 62.5%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: cloudsTitle
          text: "Cloud cover"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#9fb2c4'}
        - type: text
          name: cloudsCap
          text: "eight segments, one per okta"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: cloudsGauge
          key: environment.clouds.cover.cover
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 88%
            arc: {start-angle: 0, end-angle: 360, weight: 12%, color: '#23262b', cap: flat}
            range: {min: 0, max: 100}
            fill: {weight: 12%, color: '#9fb2c4', segments: 8, gap: 3%}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: '#9fb2c4'}
            value-label: {position: center, size: 13%, color: '#ffffff', value-padding: 7%}
    - type: group
      name: uv
      geometry: {x: 75.0%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: uvTitle
          text: "UV index"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#b48cff'}
        - type: text
          name: uvCap
          text: "11 steps, published colours"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: uvGauge
          key: environment.light.uvi
          title: false
          geometry: {x: 8%, y: 14%, width: 84%, height: 70%}
          display:
            radius: 92%
            arc: {start-angle: -90, end-angle: 90, weight: 10%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 11}
            zones:
            - {from: 0, to: 3, color: '#4caf50'}
            - {from: 3, to: 6, color: '#fdd835'}
            - {from: 6, to: 8, color: '#fb8c00'}
            - {from: 8, to: 11, color: '#e53935'}
            fill: {weight: 10%, segments: 11, gap: 2%, color: zone}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: below, size: 15%, color: '#ffffff', value-padding: 7%}
    - type: group
      name: rain
      geometry: {x: 87.5%, y: 0.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: rainTitle
          text: "Rain rate"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#4a9dff'}
        - type: text
          name: rainCap
          text: "quarter dial"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: rainGauge
          key: environment.precipitation.precipitation
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 94%
            arc: {start-angle: 0, end-angle: 90, weight: 6%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 20}
            fill: {weight: 6%, color: '#4a9dff'}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 10
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 2}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 13%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 12%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: cpu
      geometry: {x: 0.0%, y: 25.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: cpuTitle
          text: "CPU"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#3ddc97'}
        - type: text
          name: cpuCap
          text: "thick arc, 240 degrees"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: cpuGauge
          key: system.cpu.usage
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 84%
            arc: {start-angle: -120, end-angle: 120, weight: 10%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 100}
            zones:
            - {from: 0, to: 60, color: '#3ddc97'}
            - {from: 60, to: 85, color: '#ffb454'}
            - {from: 85, to: 100, color: '#ff4b3e'}
            fill: {weight: 10%, color: zone}
            major:
              length: 7%
              width: 2px
              color: '#c9c9d0'
              interval: 50
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
                font: Roboto Mono
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 5}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 14%, color: '#ffffff', value-padding: 7%, font: Roboto Mono}
    - type: group
      name: memory
      geometry: {x: 12.5%, y: 25.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: memoryTitle
          text: "Memory"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#4fd8ff'}
        - type: text
          name: memoryCap
          text: "thin progress ring"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: memoryGauge
          key: system.memory.usage
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 90%
            arc: {start-angle: 0, end-angle: 360, weight: 2.5%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 100}
            fill: {weight: 2.5%, color: '#4fd8ff'}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: '#4fd8ff'}
            value-label: {position: center, size: 14%, color: '#ffffff', value-padding: 7%, font: Roboto Mono}
    - type: group
      name: disk
      geometry: {x: 25.0%, y: 25.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: diskTitle
          text: "Disk"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffb454'}
        - type: text
          name: diskCap
          text: "half dial"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: diskGauge
          key: system.disk.usage
          title: false
          geometry: {x: 8%, y: 14%, width: 84%, height: 70%}
          display:
            radius: 92%
            arc: {start-angle: -90, end-angle: 90, weight: 7%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 100}
            fill: {weight: 7%, color: '#ffb454'}
            major: {enabled: false}
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 10}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffb454'}
            value-label: {position: below, size: 14%, color: '#ffffff', value-padding: 7%, font: Roboto Mono}
    - type: group
      name: network
      geometry: {x: 37.5%, y: 25.0%, width: 12.15%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: networkTitle
          text: "Download"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 60.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#4fd8ff'}
        - type: text
          name: networkCap
          text: "Mbit/s, fine graduations"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: networkGauge
          key: system.network.down
          title: false
          geometry: {x: 6%, y: 12%, width: 88%, height: 78%}
          display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 3%, color: '#2a2a31', cap: flat}
            range: {min: 0, max: 1000}
            fill: {weight: 3%, color: '#4fd8ff'}
            major:
              length: 9%
              width: 3px
              color: '#c9c9d0'
              interval: 500
              labels:
                position: inside
                height: 18%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
                font: Roboto Mono
            minor: {length: 45%, width: 1px, color: '#5d5d66', interval: 50}
            micro: {enabled: false}
            needle: {type: needle, length: 72%, width: 3%, color: '#ffffff'}
            value-label: {position: below, size: 12%, color: '#ffffff', value-padding: 7%, font: Roboto Mono}
    - type: group
      name: nested
      geometry: {x: 50.0%, y: 25.0%, width: 24.65%, height: 24.45%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: nestedTitle
          text: "Nested rings"
          alignment: CenterLeft
          geometry: {x: 5%, y: 3%, width: 30.0%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#3ddc97'}
        - type: text
          name: nestedCap
          text: "three gauges, decreasing radius"
          alignment: Center
          geometry: {x: 5%, y: 91.5%, width: 90%, height: 5.0%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: ringCpu
          key: system.cpu.usage
          title: false
          geometry: {x: 2%, y: 12%, width: 50%, height: 79%}
          display:
            radius: 94%
            arc: {start-angle: 0, end-angle: 360, weight: 8%, color: '#202026', cap: round}
            range: {min: 0, max: 100}
            fill: {weight: 8%, color: '#3ddc97'}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: '#3ddc97'}
            value-label: {visible: false}
        - type: realtime.gauge
          name: ringMem
          key: system.memory.usage
          title: false
          geometry: {x: 2%, y: 12%, width: 50%, height: 79%}
          display:
            radius: 74%
            arc: {start-angle: 0, end-angle: 360, weight: 8%, color: '#202026', cap: round}
            range: {min: 0, max: 100}
            fill: {weight: 8%, color: '#4fd8ff'}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: '#4fd8ff'}
            value-label: {visible: false}
        - type: realtime.gauge
          name: ringDisk
          key: system.disk.usage
          title: false
          geometry: {x: 2%, y: 12%, width: 50%, height: 79%}
          display:
            radius: 54%
            arc: {start-angle: 0, end-angle: 360, weight: 8%, color: '#202026', cap: round}
            range: {min: 0, max: 100}
            fill: {weight: 8%, color: '#ffb454'}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: '#ffb454'}
            value-label: {visible: false}
        - type: text
          name: nestLabel0
          text: "CPU"
          alignment: CenterLeft
          geometry: {x: 58%, y: 22%, width: 22%, height: 7%}
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono, color: '#3ddc97'}
