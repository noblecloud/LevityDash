# Gauge showcase, in the style of gauge-ui's Weather, Dashboard and Cockpit tabs.
# Five sections on a card grid: Weather (big feature dials), Conditions (small metric
# cards), Instruments, Variants (one dial per gauge feature), and Rings (identical dials).
# Every size is a share of the card, so the board scales with the window.
#
# Look: dark grey track (`arc: {color}`), white value fill, value text capped at a share
# of the dial (`value-label: {size}`), one caption size (the `caption` size group), tick
# labels only on the big dials. Render with --scenario stormy-day or short-values.
# Hex colours are quoted; unquoted, '#' starts a YAML comment.
# Cards that recreate a template from github.com/thordursk/gauge-ui (MIT, commit cfe5341)
# say so in docs/tasks/gauge-presets.md. Cards use a square border: no rounded corners yet.

- type: group
  name: main
  items:
    - type: group
      name: temperature
      geometry: {x: 0.0%, y: 0%, width: 24.1%, height: 32%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: temperatureTitle
        text: "Temperature"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: temperatureSub
        text: "feels like, high, low"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: temperatureGauge
        key: environment.temperature.temperature
        title: false
        geometry: {x: 8%, y: 14%, width: 84%, height: 80%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 4%, color: '#3c3c44', cap: flat}
            range: {min: 40, max: 100}
            fill: {weight: 4%, color: '#ffffff'}
            major:
              interval: 20
              length: 6%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 9%, color: '#8d8d96', offset: 3%}
            minor: {interval: 4, length: 50%, width: 1px, color: '#5d5d66'}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 22%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 9%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: wind
      geometry: {x: 25.3%, y: 0%, width: 24.1%, height: 32%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: windTitle
        text: "Wind"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: windSub
        text: "direction and speed"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: compassGauge
        key: environment.wind.direction.direction
        title: false
        geometry: {x: 8%, y: 14%, width: 84%, height: 80%}
        display:
            radius: 90%
            arc: {start-angle: 0, end-angle: 360, weight: 1.2%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 360}
            major:
              interval: 90
              length: 6%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 14%, color: '#8d8d96', offset: 3%}
            minor: {interval: 10, length: 50%, width: 1px, color: '#5d5d66'}
            micro: {enabled: false}
            needle: {type: triangle, length: 11%, width: 7%, color: '#ffffff'}
            value-label: {position: center, size: 22%, color: '#ffffff', value-padding: 7%}
    - type: group
      name: pressure
      geometry: {x: 50.6%, y: 0%, width: 24.1%, height: 32%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: pressureTitle
        text: "Pressure"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: pressureSub
        text: "inHg, set hand 3 h ago"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: pressureGauge
        key: environment.pressure.pressure
        title: false
        geometry: {x: 8%, y: 14%, width: 84%, height: 80%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 1.5%, color: '#3c3c44', cap: flat}
            range: {min: 28, max: 32}
            major:
              interval: 1
              length: 6%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 9%, color: '#8d8d96', offset: 3%}
            minor: {interval: 0.1, length: 50%, width: 1px, color: '#5d5d66'}
            micro: {enabled: false}
            needle: {type: needle, length: 72%, width: 4%, color: '#ffffff'}
            markers:
            - {value: 'at(environment.pressure.pressure, -3h)', type: marker, length: 9%, color: '#ffffff'}
            value-label: {position: below, size: 17%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 8%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: windSpeed
      geometry: {x: 75.9%, y: 0%, width: 24.1%, height: 32%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: windSpeedTitle
        text: "Wind speed"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: windSpeedSub
        text: "gust marked on the dial"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 3.75%, width: 46%, height: 7.5%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: speedGauge
        key: environment.wind.speed.speed
        title: false
        geometry: {x: 8%, y: 14%, width: 84%, height: 80%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 4%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 60}
            fill: {weight: 4%, color: '#ffffff'}
            major:
              interval: 20
              length: 6%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 9%, color: '#8d8d96', offset: 3%}
            minor: {interval: 5, length: 50%, width: 1px, color: '#5d5d66'}
            micro: {enabled: false}
            markers:
            - {value: 'environment.wind.speed.gust', type: marker, length: 12%, color: '#ff5a4a'}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 22%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 9%, color: '#8d8d96', value-padding: 14%}
    - type: group
      name: humidity
      geometry: {x: 0.0%, y: 33.2%, width: 24.1%, height: 19.5%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: humidityTitle
        text: "Humidity"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: humiditySub
        text: "comfort 30 to 60"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: humidityGauge
        key: environment.humidity.humidity
        title: false
        geometry: {x: 12%, y: 16%, width: 76%, height: 70%}
        display:
            radius: 92%
            arc: {start-angle: -90, end-angle: 90, weight: 6%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 100}
            fill: {weight: 6%, color: '#ffffff'}
            major:
              enabled: false
              labels: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, length: 10%, width: 8%, color: '#ffffff'}
            value-label: {position: below, size: 24%, color: '#ffffff', value-padding: 7%}
      - type: text
        name: humidityCap
        text: "relative humidity"
        alignment: Center
        geometry: {x: 10%, y: 87%, width: 80%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
    - type: group
      name: clouds
      geometry: {x: 25.3%, y: 33.2%, width: 24.1%, height: 19.5%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: cloudsTitle
        text: "Cloud cover"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: cloudsSub
        text: "sky"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: cloudsGauge
        key: environment.clouds.cover.cover
        title: false
        geometry: {x: 12%, y: 16%, width: 76%, height: 70%}
        display:
            radius: 92%
            arc: {start-angle: 0, end-angle: 360, weight: 8%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 100}
            fill: {weight: 8%, color: '#ffffff'}
            major:
              enabled: false
              labels: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: "#ffffff"}
            value-label: {position: center, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: text
        name: cloudsCap
        text: "of the sky"
        alignment: Center
        geometry: {x: 10%, y: 87%, width: 80%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
    - type: group
      name: uv
      geometry: {x: 50.6%, y: 33.2%, width: 24.1%, height: 19.5%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: uvTitle
        text: "UV index"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: uvSub
        text: "burn risk"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: uvGauge
        key: environment.light.uvi
        title: false
        geometry: {x: 12%, y: 16%, width: 76%, height: 70%}
        display:
            radius: 92%
            arc: {start-angle: -90, end-angle: 90, weight: 6%, color: '#3c3c44', cap: flat, gradient: UVIndexGradient}
            range: {min: 0, max: 12}
            major:
              enabled: false
              labels: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, length: 10%, width: 8%, color: '#ffffff'}
            value-label: {position: below, size: 24%, color: '#ffffff', value-padding: 7%}
      - type: text
        name: uvCap
        text: "index 0 to 12"
        alignment: Center
        geometry: {x: 10%, y: 87%, width: 80%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
    - type: group
      name: rain
      geometry: {x: 75.9%, y: 33.2%, width: 24.1%, height: 19.5%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: rainTitle
        text: "Rain rate"
        alignment: CenterLeft
        geometry: {x: 5.39%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: rainSub
        text: "now"
        alignment: CenterRight
        geometry: {x: 48.61%, y: 6.15%, width: 46%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: rainGauge
        key: environment.precipitation.precipitation
        title: false
        geometry: {x: 12%, y: 16%, width: 76%, height: 70%}
        display:
            radius: 92%
            arc: {start-angle: -120, end-angle: 120, weight: 6%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 0.7}
            fill: {weight: 6%, color: '#4aa3ff'}
            major:
              enabled: false
              labels: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 24%, color: '#ffffff', value-padding: 7%}
            unit-label: {visible: true, position: float-under, height: 9%, color: '#8d8d96', value-padding: 14%}
      - type: text
        name: rainCap
        text: "per hour"
        alignment: Center
        geometry: {x: 10%, y: 87%, width: 80%, height: 12.31%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
    - type: group
      name: instruments
      geometry: {x: 0.0%, y: 53.9%, width: 49.400000000000006%, height: 27%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: instrumentsTitle
        text: "Instruments"
        alignment: CenterLeft
        geometry: {x: 2.63%, y: 4.44%, width: 46%, height: 8.89%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: instrumentsSub
        text: "needle dials"
        alignment: CenterRight
        geometry: {x: 51.37%, y: 4.44%, width: 46%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: tachGauge
        key: environment.wind.speed.gust
        title: false
        geometry: {x: 5%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 2%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 80}
            fill: {from: 65, to: 80, weight: 5%, color: '#ff5a4a'}
            major:
              interval: 20
              length: 8%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 13%, color: '#8d8d96', offset: 3%}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: needle, length: 72%, width: 4%, color: '#ffffff'}
            value-label: {position: below, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: realtime.gauge
        name: powerGauge
        key: environment.temperature.feelsLike
        title: false
        geometry: {x: 29%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -90, end-angle: 90, weight: 3%, color: '#3c3c44', cap: flat}
            range: {min: 40, max: 80}
            fill: {from: 60, weight: 3%, color: '#4aa3ff'}
            major:
              interval: 20
              length: 8%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 13%, color: '#8d8d96', offset: 3%}
            minor: {enabled: false}
            micro: {enabled: false}
            value-label: {position: below, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: realtime.gauge
        name: fuelGauge
        key: environment.clouds.cover.cover
        title: false
        geometry: {x: 53%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -90, end-angle: 90, weight: 2%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 100}
            fill: {from: 0, to: 20, weight: 5%, color: '#ff5a4a'}
            major:
              interval: 50
              length: 8%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 13%, color: '#8d8d96', offset: 3%, format: {precision: 0}}
            minor: {interval: 10, length: 50%, width: 1px, color: '#5d5d66'}
            micro: {enabled: false}
            needle: {type: needle, length: 72%, width: 4%, color: '#ffffff'}
            value-label: {position: below, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: realtime.gauge
        name: dewGauge
        key: environment.temperature.dewpoint
        title: false
        geometry: {x: 77%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 1.5%, color: '#3c3c44', cap: flat}
            range: {min: 40, max: 80}
            major:
              interval: 20
              length: 8%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 13%, color: '#8d8d96', offset: 3%}
            minor: {interval: 4, length: 50%, width: 1px, color: '#5d5d66'}
            micro: {enabled: false}
            needle: {type: needle, length: 72%, width: 4%, color: '#ffffff'}
            value-label: {position: below, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: text
        name: tachCap
        text: "Gust"
        alignment: Center
        geometry: {x: 3%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: powerCap
        text: "Feels like"
        alignment: Center
        geometry: {x: 27%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: fuelCap
        text: "Cloud"
        alignment: Center
        geometry: {x: 51%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: dewCap
        text: "Dew point"
        alignment: Center
        geometry: {x: 75%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
    - type: group
      name: variants
      geometry: {x: 50.6%, y: 53.9%, width: 49.400000000000006%, height: 27%}
      border: {enabled: true, color: '#ffffff', opacity: 0.16, weight: 1}
      items:
      - type: text
        name: variantsTitle
        text: "Variants"
        alignment: CenterLeft
        geometry: {x: 2.63%, y: 4.44%, width: 46%, height: 8.89%}
        opacity: 0.95
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: variantsSub
        text: "curved labels, markers, fills"
        alignment: CenterRight
        geometry: {x: 51.37%, y: 4.44%, width: 46%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: realtime.gauge
        name: warpGauge
        key: environment.humidity.humidity
        title: false
        geometry: {x: 5%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -170, end-angle: 170, weight: 2%, color: '#3c3c44', cap: flat}
            range: {min: 0, max: 100}
            major:
              interval: 25
              labels: {curve: warp, height: 7%, position: inside, format: {precision: 0}}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: realtime.gauge
        name: markersGauge
        key: environment.temperature.temperature
        title: false
        geometry: {x: 29%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -90, end-angle: 90, weight: 2%, color: '#3c3c44', cap: flat}
            range: {min: 40, max: 90}
            major:
              interval: 25
              length: 8%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 13%, color: '#8d8d96', offset: 3%}
            minor: {enabled: false}
            micro: {enabled: false}
            markers:
            - {value: 'min(environment.temperature.temperature, today)', type: marker, length: 12%, color: '#4aa3ff'}
            - {value: 'max(environment.temperature.temperature, today)', type: marker, length: 12%, color: '#ff5a4a'}
            value-label: {position: below, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: realtime.gauge
        name: rangeGauge
        key: environment.temperature.temperature
        title: false
        geometry: {x: 53%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 2%, color: '#3c3c44', cap: flat}
            range: {min: 40, max: 90}
            fill: {from: 'min(environment.temperature.temperature, today)', to: 'max(environment.temperature.temperature, today)', weight: 5%, color: '#ff8a3d'}
            major:
              interval: 25
              length: 8%
              width: 2px
              color: '#c9c9d0'
              labels: {position: inside, height: 13%, color: '#8d8d96', offset: 3%}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, length: 8%, width: 5%, color: '#ffffff'}
            value-label: {position: center, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: realtime.gauge
        name: capGauge
        key: environment.wind.speed.speed
        title: false
        geometry: {x: 77%, y: 15%, width: 18%, height: 70%}
        display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 9%, color: '#3c3c44', cap: round}
            range: {min: 0, max: 60}
            major:
              enabled: false
              labels: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: triangle, length: 12%, width: 8%, color: '#ffffff'}
            value-label: {position: center, size: 20%, color: '#ffffff', value-padding: 7%}
      - type: text
        name: warpCap
        text: "Curved labels"
        alignment: Center
        geometry: {x: 3%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: markersCap
        text: "Day low and high"
        alignment: Center
        geometry: {x: 27%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
        display: {matchingGroup: {group: "global.caption", matchAll: true}}
      - type: text
        name: rangeCap
        text: "Fill, day range"
        alignment: Center
        geometry: {x: 51%, y: 86%, width: 22%, height: 8.89%}
        opacity: 0.55
