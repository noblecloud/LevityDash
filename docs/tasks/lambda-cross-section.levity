    - type: graph
      name: forecast
      timeframe:
        days: 2
        hours: 12
        offset:
          hours: -1
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          alignment: BottomCenter
          spacingIntervals: 3, 6, 12
        lines:
          spacing: 8 mm
          weight: 0.5
      figures:
      - figure: glyphs
        margins:
          top: 7%
          bottom: 85%
        environment.temperature.dewpoint:
          plot:
            type: strip
            pins:
              key: environment.precipitation.precipitation
              size: 24
              at: 0.5
              color: $cloud
              steps:
              - - 0
                - wi:day-sunny
              - - 0.02
                - wi:sprinkle
              - - 0.1
                - wi:showers
              - - 0.3
                - wi:rain
      - figure: windarrows
        margins:
          top: 15%
          bottom: 79%
        environment.temperature.dewpoint:
          plot:
            type: strip
            pins:
              key: environment.wind.direction.direction
              glyph: wi:direction-up
              rotate: 180
              size: 20
              at: 0.5
              color: $wind
      - figure: temperature
        margins:
          bottom: 30%
          top: 25%
        environment.temperature.temperature:
          labels:
            enabled: true
          plot:
            type: plot
            gradient: TemperatureGradient
            weight: 1.0
            glow: *id001
            fill:
              opacity: 0.45
              fade: true
          resolution: 2
        environment.temperature.feelsLike:
          plot:
            type: plot
            gradient: TemperatureGradient
            weight: 0.35
            opacity: 0.6
          resolution: 2
        environment.temperature.dewpoint:
          plot:
            type: plot
            cap: square
            color: $good
            dashPattern: 5, 5
            weight: 0.35
      - figure: chance
        margins:
          bottom: 5%
          top: 68%
        min: 0
        max: 1
        environment.precipitation.probability:
          plot:
            type: plot
            color: $pink
            dashPattern: 3, 3
            weight: 0.5
            opacity: 0.9
      - figure: precipitation
        margins:
          bottom: 5%
          top: 68%
        min: 0
        max: 0.5
        environment.precipitation.precipitation:
          plot:
            type: bar
            color: $rain
            width: 0.9
            glow: *id001
          smooth: false
