      name: wind
      size: 20%
      title:
        text: WIND MPH
        height: 10mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - preset: compass
        geometry:
          x: 0%
          y: 0%
          width: 54%
          height: 54%
        props:
          label: mph
          caption_size: 34%
          label_size: 13%
          arc_weight: 2.5%
        display:
          arc:
            color: $rule
            glow: *id001
          needle:
            color: $wind
            glow: *id001
          major:
            labels:
              height: 14%
              color: $muted
      - type: text
        text: GUST
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
