# Cross-section, neon: sky, surface, ground. The room display on lambda (1680x1050 logical).
# Generated by docs/tasks/lambda-cross-section-gen.py. Tiles: a small caption over a number that fills its cell; tables where a column of numbers
# must line up. Only keys lambda publishes (OpenMeteo, Astronomy, the bedroom and terrarium Govee sensors).
theme:
  extends: default
  colors:
    background: '#000000'
    surface: '#100c22'
    text: '#f4f1ff'
    muted: '#d2ccf5'
    faint: '#9a92c8'
    rule: '#3b3372'
    accent: '#00f0ff'
    good: '#39ff88'
    warn: '#ffe600'
    bad: '#ff3b3b'
    info: '#38b6ff'
    rain: '#3d8bff'
    wind: '#b6ff00'
    cloud: '#c9b8ff'
    cloud-2: '#b08cff'
    soil: '#ff9a1f'
    pink: '#ff2bd6'
    series-1: '#00e5ff'
    series-2: '#ff9a1f'
    series-3: '#b6ff00'
    series-4: '#ffe600'
    series-5: '#8a5cff'
    series-6: '#ff9a1f'
  fonts:
    display: SF Compact Display
    body: SF Pro Display
    mono: Roboto Mono
  scales:
    TemperatureGradient:
      10°F: '#8a2bff'
      30°F: '#3d6bff'
      45°F: '#00e5ff'
      58°F: '#00ffa8'
      68°F: '#b6ff00'
      77°F: '#ffe600'
      86°F: '#ff9a1f'
      96°F: '#ff4a3d'
      108°F: '#ff2a2a'
    UVIndexGradient:
      0: '#39ff88'
      3: '#ffe600'
      6: '#ff9a1f'
      8: '#ff3b3b'
      11: '#9d5cff'
    WindSpeedGradient:
      0: '#3d8bff'
      8: '#00e5ff'
      16: '#b6ff00'
      26: '#ffe600'
      40: '#ff3b3b'
    PressureGradient:
      0: '#8a5cff'
      1: '#00e5ff'
items:
- type: stack
  defaultType: group
  name: main
  padding: 3mm
  spacing: 3mm
  dividers:
    enabled: true
    opacity: 70%
    size: 99%
  items:
  - type: stack
    name: sky
    direction: Horizontal
    size: 22%
    spacing: 4mm
    dividers:
      enabled: true
      opacity: 60%
      size: 80%
    items:
    - type: clock
      name: clock
      size: 22%
      items:
      - type: moon
        glowStrength: 0
        interval:
          minutes: 20
        geometry:
          x: 0%
          y: 0%
          width: 22%
          height: 38%
      - format: '%A'
        alignment: BottomLeft
        font: $display
        weight: SemiBold
        color: $accent
        format-hint: Wednesday
        margins: 0
        geometry:
          x: 26%
          y: 0%
          width: 74%
          height: 20%
      - format: '%B %-d'
        alignment: TopLeft
        filters:
        - AddOrdinal
        font: $display
        weight: Medium
        format-hint: September 30th
        color: $muted
        margins: 0
        geometry:
          x: 26%
          y: 21%
          width: 74%
          height: 17%
      - format: '%-I:%M'
        font: $display
        weight: SemiBold
        alignment: BottomRight
        format-hint: '10:00'
        margins: 0
        geometry:
          x: 0%
          y: 40%
          width: 82%
          height: 60%
      - format: '%p'
        font: $display
        weight: SemiBold
        filters:
        - Lower
        color: $info
        alignment: BottomLeft
        format-hint: am
        margins: 0
        geometry:
          x: 83%
          y: 78%
          width: 17%
          height: 22%
    - type: titled-group
      name: cloud
      size: 16%
      title:
        text: CLOUD
        height: 10mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - type: text
        text: TOTAL
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0%
          y: 0%
          width: 48%
          height: 14%
        matchingGroup:
          group: global.cap-cloud
          matchAll: true
      - type: realtime.text
        key: environment.clouds.cover.cover
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $cloud
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-cloud
              matchAll: true
          format-hint: 000%
        geometry:
          x: 0%
          y: 14%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.cover
        title: false
        geometry:
          x: 0%
          y: 42%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud
            glow: &id001
              strength: 1.5
              reach: 2.0
              passes: 6
          value-label:
            visible: false
      - type: text
        text: HIGH
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 52%
          y: 0%
          width: 48%
          height: 14%
        matchingGroup:
          group: global.cap-cloud
          matchAll: true
      - type: realtime.text
        key: environment.clouds.cover.high
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $cloud-2
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-cloud
              matchAll: true
          format-hint: 000%
        geometry:
          x: 52%
          y: 14%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.high
        title: false
        geometry:
          x: 52%
          y: 42%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud-2
            glow: *id001
          value-label:
            visible: false
      - type: text
        text: MID
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0%
          y: 52%
          width: 48%
          height: 14%
        matchingGroup:
          group: global.cap-cloud
          matchAll: true
      - type: realtime.text
        key: environment.clouds.cover.mid
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $cloud-2
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-cloud
              matchAll: true
          format-hint: 000%
        geometry:
          x: 0%
          y: 66%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.mid
        title: false
        geometry:
          x: 0%
          y: 94%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud-2
            glow: *id001
          value-label:
            visible: false
      - type: text
        text: LOW
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 52%
          y: 52%
          width: 48%
          height: 14%
        matchingGroup:
          group: global.cap-cloud
          matchAll: true
      - type: realtime.text
        key: environment.clouds.cover.low
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $cloud-2
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-cloud
              matchAll: true
          format-hint: 000%
        geometry:
          x: 52%
          y: 66%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.low
        title: false
        geometry:
          x: 52%
          y: 94%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud-2
            glow: *id001
          value-label:
            visible: false
    - type: titled-group
      name: sun
      size: 16%
      title:
        text: SUN AND MOON
        height: 10mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - type: text
        text: RISE
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0.0%
          y: 0.0%
          width: 50.0%
          height: 15.0%
        matchingGroup:
          group: global.cap-sun
          matchAll: true
      - type: realtime.text
        key: astronomy.sun.rise
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $warn
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-sun
              matchAll: true
          format-hint: 0:00
          format: '%-I:%M'
        geometry:
          x: 0.0%
          y: 15.0%
          width: 50.0%
          height: 35.0%
      - type: text
        text: SET
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 50.0%
          y: 0.0%
          width: 50.0%
          height: 15.0%
        matchingGroup:
          group: global.cap-sun
          matchAll: true
      - type: realtime.text
        key: astronomy.sun.set
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $pink
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-sun
              matchAll: true
          format-hint: 0:00
          format: '%-I:%M'
        geometry:
          x: 50.0%
          y: 15.0%
          width: 50.0%
          height: 35.0%
      - type: text
        text: DAY LEFT
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0.0%
          y: 50.0%
          width: 50.0%
          height: 15.0%
        matchingGroup:
          group: global.cap-sun
          matchAll: true
      - type: realtime.text
        key: astronomy.sun.remaining
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $warn
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-sun
              matchAll: true
          format-hint: 0h 00m
          format: duration
        geometry:
          x: 0.0%
          y: 65.0%
          width: 50.0%
          height: 35.0%
      - type: text
        text: MOON
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 50.0%
          y: 50.0%
          width: 50.0%
          height: 15.0%
        matchingGroup:
          group: global.cap-sun
          matchAll: true
      - type: realtime.text
        key: astronomy.moon.phase
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $cloud
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-sun
              matchAll: true
          format-hint: 00%
        geometry:
          x: 50.0%
          y: 65.0%
          width: 50.0%
          height: 35.0%
    - type: titled-group
      name: pressure
      title:
        text: PRESSURE INHG
        height: 10mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - preset: sparkline
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 58%
        props:
          key: environment.pressure.pressure
          hours: 12
          figure: pressure
          plot:
            type: plot
            gradient: PressureGradient
            weight: 0.7
            opacity: 0.8
            glow: *id001
            fill:
              opacity: 0.3
              fade: true
          top: 8%
          bottom: 4%
      - type: realtime.text
        key: environment.pressure.pressure
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 2
          valueLabel:
            text-height: 19mm
            color: $text
            font: $body
            weight: Bold
            matchingGroup:
              group: global.hero2
              matchAll: true
          format-hint: '00.00'
        geometry:
          x: 0%
          y: 0%
          width: 62%
          height: 46%
      - type: switch
        name: tendency
        hold: 10m
        fade: 0.4s
        geometry:
          x: 0%
          y: 46%
          width: 62%
          height: 13%
        items:
        - type: text
          text: RISING ▲
          font: $display
          weight: SemiBold
          text-height: 5.6mm
          color: $good
          alignment: CenterLeft
          when: environment.pressure.pressure - at(environment.pressure.pressure, -3h) > 0.03 inHg
        - type: text
          text: FALLING ▼
          font: $display
          weight: SemiBold
          text-height: 5.6mm
          color: $bad
          alignment: CenterLeft
          when: at(environment.pressure.pressure, -3h) - environment.pressure.pressure > 0.03 inHg
        - type: text
          text: STEADY
          font: $display
          weight: SemiBold
          text-height: 5.6mm
          color: $muted
          alignment: CenterLeft
      - type: text
        text: 3 H
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0.0%
          y: 60.0%
          width: 33.33%
          height: 12.0%
        matchingGroup:
          group: global.cap-pressure
          matchAll: true
      - type: realtime.text
        key: environment.pressure.pressure - at(environment.pressure.pressure, -3h)
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 2
          valueLabel:
            text-height: 16mm
            color: $info
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-pressure
              matchAll: true
          format-hint: '-0.00'
        geometry:
          x: 0.0%
          y: 72.0%
          width: 33.33%
          height: 28.0%
      - type: text
        text: 24 H
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 33.33%
          y: 60.0%
          width: 33.33%
          height: 12.0%
        matchingGroup:
          group: global.cap-pressure
          matchAll: true
      - type: realtime.text
        key: environment.pressure.pressure - at(environment.pressure.pressure, -24h)
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 2
          valueLabel:
            text-height: 16mm
            color: $info
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-pressure
              matchAll: true
          format-hint: '-0.00'
        geometry:
          x: 33.33%
          y: 72.0%
          width: 33.33%
          height: 28.0%
      - type: text
        text: VIS MI
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 66.67%
          y: 60.0%
          width: 33.33%
          height: 12.0%
        matchingGroup:
          group: global.cap-pressure
          matchAll: true
      - type: mini-graph
        geometry:
          x: 66.67%
          y: 72.0%
          width: 31.330199999999998%
          height: 28.0%
        timeframe:
          hours: 12
          lookback:
            hours: 14
          offset:
            hours: -0.5
        annotations:
          dayLabels:
            enabled: false
          hourLabels:
            enabled: false
          lines:
            enabled: false
        indicator:
          opacity: 0
        figures:
        - figure: mini1
          margins:
            top: 60%
            bottom: 2%
          environment.visibility:
            plot:
              type: plot
              weight: 0.45
              opacity: 0.55
              fill:
                opacity: 0.25
                fade: true
              color: $muted
      - type: realtime.text
        key: environment.visibility
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Hidden
          precision: 1
          valueLabel:
            text-height: 16mm
            color: $text
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-pressure
              matchAll: true
          format-hint: '00.0'
        geometry:
          x: 66.67%
          y: 72.0%
          width: 33.33%
          height: 28.0%
  - type: stack
    name: surface
    direction: Horizontal
    spacing: 4mm
    items:
    - type: group
      name: now
      size: 20%
      items:
      - type: realtime.text
        key: environment.temperature.temperature
        title: false
        alignment: CenterLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 30mm
            color:
              scale: $temperature
              of: environment.temperature.temperature
            font: $body
            weight: Bold
          format-hint: 00°
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 33%
      - type: realtime.text
        key: environment.condition.condition
        title: false
        alignment: CenterLeft
        display:
          valueLabel:
            color: $info
            text-height: 6mm
            font: $display
            weight: SemiBold
        geometry:
          x: 0%
          y: 33%
          width: 100%
          height: 8%
      - type: realtime.bar
        key: environment.temperature.temperature
        title: false
        geometry:
          x: 0%
          y: 41%
          width: 100%
          height: 13%
        display:
          range:
            min: 30
            max: 100
          track:
            weight: 26%
            color: $rule
          fill:
            from: environment.temperature.low
            to: environment.temperature.high
            gradient: TemperatureGradient
            glow: *id001
          pointer:
            type: triangle
            color: $text
            side: before
          major:
            interval: 10
            side: after
            labels: true
            size: 45%
          value-label:
            visible: false
      - type: text
        text: LOW
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0.0%
          y: 55.0%
          width: 33.33%
          height: 6.75%
        matchingGroup:
          group: global.cap-now
          matchAll: true
      - type: realtime.text
        key: environment.temperature.low
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $info
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-now
              matchAll: true
          format-hint: 00°
        geometry:
          x: 0.0%
          y: 61.75%
          width: 33.33%
          height: 15.749999999999998%
      - type: text
        text: HIGH
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 33.33%
          y: 55.0%
          width: 33.33%
          height: 6.75%
        matchingGroup:
          group: global.cap-now
          matchAll: true
      - type: realtime.text
        key: environment.temperature.high
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $bad
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-now
              matchAll: true
          format-hint: 00°
        geometry:
          x: 33.33%
          y: 61.75%
          width: 33.33%
          height: 15.749999999999998%
      - type: text
        text: FEELS
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 66.67%
          y: 55.0%
          width: 33.33%
          height: 6.75%
        matchingGroup:
          group: global.cap-now
          matchAll: true
      - type: mini-graph
        geometry:
          x: 66.67%
          y: 61.75%
          width: 31.330199999999998%
          height: 15.749999999999998%
        timeframe:
          hours: 12
          lookback:
            hours: 14
          offset:
            hours: -0.5
        annotations:
          dayLabels:
            enabled: false
          hourLabels:
            enabled: false
          lines:
            enabled: false
        indicator:
          opacity: 0
        figures:
        - figure: mini2
          margins:
            top: 60%
            bottom: 2%
          environment.temperature.feelsLike:
            plot:
              type: plot
              weight: 0.45
              opacity: 0.55
              fill:
                opacity: 0.25
                fade: true
              gradient: TemperatureGradient
      - type: realtime.text
        key: environment.temperature.feelsLike
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color:
              scale: $temperature
              of: environment.temperature.feelsLike
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-now
              matchAll: true
          format-hint: 00°
        geometry:
          x: 66.67%
          y: 61.75%
          width: 33.33%
          height: 15.749999999999998%
      - type: text
        text: DEW
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 0.0%
          y: 77.5%
          width: 33.33%
          height: 6.75%
        matchingGroup:
          group: global.cap-now
          matchAll: true
      - type: mini-graph
        geometry:
          x: 0.0%
          y: 84.25%
          width: 31.330199999999998%
          height: 15.749999999999998%
        timeframe:
          hours: 12
          lookback:
            hours: 14
          offset:
            hours: -0.5
        annotations:
          dayLabels:
            enabled: false
          hourLabels:
            enabled: false
          lines:
            enabled: false
        indicator:
          opacity: 0
        figures:
        - figure: mini3
          margins:
            top: 60%
            bottom: 2%
          environment.temperature.dewpoint:
            plot:
              type: plot
              weight: 0.45
              opacity: 0.55
              fill:
                opacity: 0.25
                fade: true
              color: $good
      - type: realtime.text
        key: environment.temperature.dewpoint
        title: false
        alignment: BottomLeft
        display:
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 16mm
            color: $good
            font: $body
            weight: Regular
            matchingGroup:
              group: global.tile-now
              matchAll: true
          format-hint: 00°
        geometry:
          x: 0.0%
          y: 84.25%
          width: 33.33%
          height: 15.749999999999998%
      - type: text
        text: HUMID
