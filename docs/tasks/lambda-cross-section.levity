        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 5.6mm
        geometry:
          x: 58.0%
          y: 27.0%
          width: 42.0%
          height: 8.1%
        matchingGroup:
          group: global.cap-wind
          matchAll: true
      - type: realtime.text
        key: max(environment.wind.speed.gust, today)
