          x: 58.0%
          y: 35.1%
          width: 42.0%
          height: 18.9%
      - preset: table
        geometry:
          x: 0%
          y: 57%
          width: 100%
          height: 43%
        props:
          labelWidth: 36%
          alignment: Right
          font: $body
          labelFont: $display
          titleGroup: global.aloft-head
          valueGroup: global.aloft-cell
          columns:
          - head: MPH
            key: environment.wind.speed.{row}
            precision: 0
            hint: '00'
            color: $wind
          - head: FROM
            key: environment.wind.direction.{row}
            hint: SSW
            color: $info
          rows:
          - label: 180 M
            row: 180m
          - label: 120 M
            row: 120m
          - label: 80 M
            row: 80m
