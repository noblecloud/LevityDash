          group: global.cap-wind
          matchAll: true
      - type: mini-graph
        geometry:
          x: 58.0%
          y: 8.1%
          width: 39.48%
          height: 18.9%
        timeframe:
          hours: 12
          lookback:
            hours: 14
          offset:
            hours: -0.5
        annotations:
          dayLabels:
