# Cross-section, neon: sky, surface, ground. The room display on lambda (1680x1050 logical).
# Generated by gen5.py. Tiles: a small caption over a number that fills its cell; tables where a column of numbers
# must line up. Only keys lambda publishes (OpenMeteo, Astronomy, the bedroom and terrarium Govee sensors).
theme:
  extends: default
  colors:
    background: '#05030b'
    surface: '#0e0a1c'
    text: '#f4f1ff'
    muted: '#a99de0'
    faint: '#6a5f9e'
    rule: '#2b2350'
    accent: '#ff2bd6'
    good: '#39ff88'
    warn: '#ffe600'
    bad: '#ff2a55'
    info: '#00e5ff'
    rain: '#3d8bff'
    wind: '#b6ff00'
    cloud: '#c9b8ff'
    cloud-2: '#8a5cff'
    soil: '#ff9a1f'
    series-1: '#00e5ff'
    series-2: '#ff2bd6'
    series-3: '#b6ff00'
    series-4: '#ffe600'
    series-5: '#8a5cff'
    series-6: '#ff9a1f'
  fonts:
    display: Barlow Condensed
    body: Roboto
    mono: Roboto Mono
  scales:
    TemperatureGradient:
      10°F: '#8a2bff'
      30°F: '#3d6bff'
      45°F: '#00e5ff'
      58°F: '#00ffa8'
      68°F: '#b6ff00'
      77°F: '#ffe600'
      86°F: '#ff9a1f'
      96°F: '#ff2a6d'
      108°F: '#ff00e6'
    UVIndexGradient:
      0: '#39ff88'
      3: '#ffe600'
      6: '#ff9a1f'
      8: '#ff2a55'
      11: '#d400ff'
    WindSpeedGradient:
      0: '#3d8bff'
      8: '#00e5ff'
      16: '#b6ff00'
      26: '#ffe600'
      40: '#ff2a55'
    PressureGradient:
      0: '#8a5cff'
      1: '#00e5ff'
items:
- type: stack
  defaultType: group
  name: main
  padding: 3mm
  spacing: 3mm
  dividers:
    enabled: true
    opacity: 70%
    size: 99%
  items:
  - type: stack
    name: sky
    direction: Horizontal
    size: 23%
    spacing: 4mm
    dividers:
      enabled: true
      opacity: 60%
      size: 80%
    items:
    - type: clock
      name: clock
      size: 19%
      items:
      - format: '%A, %B %-d'
        alignment: TopLeft
        filters:
        - AddOrdinal
        font: $display
        weight: Medium
        color: $accent
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 18%
      - format: '%-I:%M'
        font: $body
        weight: Light
        alignment: BottomRight
        format-hint: '10:00'
        margins: 0
        geometry:
          x: 0%
          y: 22%
          width: 76%
          height: 78%
      - type: moon
        glowStrength: 2
        interval:
          minutes: 20
        geometry:
          x: 79%
          y: 24%
          width: 21%
          height: 40%
      - format: '%p'
        font: $body
        filters:
        - Lower
        color: $info
        alignment: BottomLeft
        format-hint: am
        margins: 0
        geometry:
          x: 79%
          y: 74%
          width: 21%
          height: 26%
    - type: titled-group
      name: cloud
      size: 15%
      title:
        text: CLOUD
        height: 7mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - type: text
        text: TOTAL
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0%
          y: 0%
          width: 48%
          height: 14%
      - type: realtime.text
        key: environment.clouds.cover.cover
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $cloud
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 0%
          y: 14%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.cover
        title: false
        geometry:
          x: 0%
          y: 42%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud
            glow: &id001
              strength: 1.0
              reach: 1.6
              passes: 5
          value-label:
            visible: false
      - type: text
        text: HIGH
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 52%
          y: 0%
          width: 48%
          height: 14%
      - type: realtime.text
        key: environment.clouds.cover.high
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $cloud-2
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 52%
          y: 14%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.high
        title: false
        geometry:
          x: 52%
          y: 42%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud-2
            glow: *id001
          value-label:
            visible: false
      - type: text
        text: MID
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0%
          y: 52%
          width: 48%
          height: 14%
      - type: realtime.text
        key: environment.clouds.cover.mid
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $cloud-2
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 0%
          y: 66%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.mid
        title: false
        geometry:
          x: 0%
          y: 94%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud-2
            glow: *id001
          value-label:
            visible: false
      - type: text
        text: LOW
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 52%
          y: 52%
          width: 48%
          height: 14%
      - type: realtime.text
        key: environment.clouds.cover.low
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $cloud-2
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 52%
          y: 66%
          width: 48%
          height: 26%
      - type: realtime.bar
        key: environment.clouds.cover.low
        title: false
        geometry:
          x: 52%
          y: 94%
          width: 48%
          height: 6%
        display:
          range:
            min: 0
            max: 100
          track:
            weight: 60%
          fill:
            color: $cloud-2
            glow: *id001
          value-label:
            visible: false
    - type: titled-group
      name: windAloft
      size: 15%
      title:
        text: WIND ALOFT
        height: 7mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - preset: table
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 100%
        props:
          labelWidth: 34%
          alignment: Right
          font: $body
          titleGroup: global.aloft-head
          valueGroup: global.aloft-cell
          columns:
          - head: mph
            key: environment.wind.speed.{row}
            precision: 0
            hint: '00'
            color: $wind
          - head: from
            key: environment.wind.direction.{row}
            hint: SSW
            color: $info
          rows:
          - label: 180 m
            row: 180m
          - label: 120 m
            row: 120m
          - label: 80 m
            row: 80m
          - label: Ground
            keys:
            - environment.wind.speed.speed
            - environment.wind.direction.direction
    - type: titled-group
      name: sun
      size: 15%
      title:
        text: SUN AND MOON
        height: 7mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - type: text
        text: RISE
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0.0%
          y: 0.0%
          width: 50.0%
          height: 15.0%
      - type: realtime.text
        key: astronomy.sun.rise
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $warn
            matchingGroup:
              group: global.tile
              matchAll: true
          format: '%-I:%M'
        geometry:
          x: 0.0%
          y: 15.0%
          width: 50.0%
          height: 35.0%
      - type: text
        text: SET
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 50.0%
          y: 0.0%
          width: 50.0%
          height: 15.0%
      - type: realtime.text
        key: astronomy.sun.set
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $accent
            matchingGroup:
              group: global.tile
              matchAll: true
          format: '%-I:%M'
        geometry:
          x: 50.0%
          y: 15.0%
          width: 50.0%
          height: 35.0%
      - type: text
        text: DAYLIGHT LEFT
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0.0%
          y: 50.0%
          width: 50.0%
          height: 15.0%
      - type: realtime.text
        key: astronomy.sun.remaining
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $warn
            matchingGroup:
              group: global.tile
              matchAll: true
          format: duration
        geometry:
          x: 0.0%
          y: 65.0%
          width: 50.0%
          height: 35.0%
      - type: text
        text: MOON
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 50.0%
          y: 50.0%
          width: 50.0%
          height: 15.0%
      - type: realtime.text
        key: astronomy.moon.phase
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $cloud
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 50.0%
          y: 65.0%
          width: 50.0%
          height: 35.0%
    - type: titled-group
      name: pressure
      title:
        text: PRESSURE INHG
        height: 7mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - preset: sparkline
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 58%
        props:
          key: environment.pressure.pressure
          hours: 12
          figure: pressure
          plot:
            type: plot
            gradient: PressureGradient
            weight: 0.7
            opacity: 0.8
            glow: *id001
          top: 8%
          bottom: 4%
      - type: realtime.text
        key: environment.pressure.pressure
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Light
          unitPosition: Hidden
          precision: 2
          valueLabel:
            text-height: 15mm
            color: $text
            matchingGroup:
              group: global.hero2
              matchAll: true
          format-hint: '00.00'
        geometry:
          x: 0%
          y: 0%
          width: 60%
          height: 46%
      - type: switch
        name: tendency
        hold: 10m
        fade: 0.4s
        geometry:
          x: 0%
          y: 44%
          width: 60%
          height: 14%
        items:
        - type: text
          text: RISING ▲
          font: $display
          weight: SemiBold
          text-height: 3.8mm
          color: $good
          alignment: CenterLeft
          when: environment.pressure.pressure - at(environment.pressure.pressure, -3h) > 0.03 inHg
        - type: text
          text: FALLING ▼
          font: $display
          weight: SemiBold
          text-height: 3.8mm
          color: $bad
          alignment: CenterLeft
          when: environment.pressure.pressure - at(environment.pressure.pressure, -3h) < -0.03 inHg
        - type: text
          text: STEADY
          font: $display
          weight: SemiBold
          text-height: 3.8mm
          color: $muted
          alignment: CenterLeft
      - type: text
        text: 3 H
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0.0%
          y: 62.0%
          width: 33.33%
          height: 11.4%
      - type: realtime.text
        key: environment.pressure.pressure - at(environment.pressure.pressure, -3h)
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 2
          valueLabel:
            text-height: 8.5mm
            color: $info
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 0.0%
          y: 73.4%
          width: 33.33%
          height: 26.599999999999998%
      - type: text
        text: 24 H
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 33.33%
          y: 62.0%
          width: 33.33%
          height: 11.4%
      - type: realtime.text
        key: environment.pressure.pressure - at(environment.pressure.pressure, -24h)
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 2
          valueLabel:
            text-height: 8.5mm
            color: $info
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 33.33%
          y: 73.4%
          width: 33.33%
          height: 26.599999999999998%
      - type: text
        text: VIS MI
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 66.67%
          y: 62.0%
          width: 33.33%
          height: 11.4%
      - type: realtime.text
        key: environment.visibility
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 1
          valueLabel:
            text-height: 8.5mm
            color: $text
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 66.67%
          y: 73.4%
          width: 33.33%
          height: 26.599999999999998%
  - type: stack
    name: surface
    direction: Horizontal
    spacing: 4mm
    items:
    - type: group
      name: now
      size: 20%
      items:
      - type: realtime.text
        key: environment.temperature.temperature
        title: false
        alignment: CenterLeft
        display:
          font: $body
          weight: Light
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 30mm
            color:
              scale: $temperature
              of: environment.temperature.temperature
          format-hint: 00°
        geometry:
          x: 0%
          y: 0%
          width: 100%
          height: 36%
      - type: realtime.text
        key: environment.condition.condition
        title: false
        alignment: CenterLeft
        display:
          font: $display
          weight: SemiBold
          valueLabel:
            color: $info
            text-height: 6mm
        geometry:
          x: 0%
          y: 36%
          width: 100%
          height: 9%
      - type: realtime.bar
        key: environment.temperature.temperature
        title: false
        geometry:
          x: 0%
          y: 44%
          width: 100%
          height: 14%
        display:
          range:
            min: 30
            max: 100
          track:
            weight: 26%
            color: $rule
          fill:
            from: environment.temperature.low
            to: environment.temperature.high
            gradient: TemperatureGradient
            glow: *id001
          pointer:
            type: triangle
            color: $text
            side: before
          major:
            interval: 10
            side: after
            labels: true
            size: 30%
          value-label:
            visible: false
      - type: text
        text: LOW
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0.0%
          y: 60.0%
          width: 33.33%
          height: 6.0%
      - type: realtime.text
        key: environment.temperature.low
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $info
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 0.0%
          y: 66.0%
          width: 33.33%
          height: 14.0%
      - type: text
        text: HIGH
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 33.33%
          y: 60.0%
          width: 33.33%
          height: 6.0%
      - type: realtime.text
        key: environment.temperature.high
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $bad
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 33.33%
          y: 66.0%
          width: 33.33%
          height: 14.0%
      - type: text
        text: FEELS
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 66.67%
          y: 60.0%
          width: 33.33%
          height: 6.0%
      - type: realtime.text
        key: environment.temperature.feelsLike
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color:
              scale: $temperature
              of: environment.temperature.feelsLike
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 66.67%
          y: 66.0%
          width: 33.33%
          height: 14.0%
      - type: text
        text: DEW
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 0.0%
          y: 80.0%
          width: 33.33%
          height: 6.0%
      - type: realtime.text
        key: environment.temperature.dewpoint
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $good
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 0.0%
          y: 86.0%
          width: 33.33%
          height: 14.0%
      - type: text
        text: HUMID
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 33.33%
          y: 80.0%
          width: 33.33%
          height: 6.0%
      - type: realtime.text
        key: environment.humidity.humidity
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Inline
          precision: 0
          valueLabel:
            text-height: 8.5mm
            color: $info
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 33.33%
          y: 86.0%
          width: 33.33%
          height: 14.0%
      - type: text
        text: VPD KPA
        font: $display
        weight: Medium
        color: $muted
        alignment: BottomLeft
        text-height: 3.8mm
        geometry:
          x: 66.67%
          y: 80.0%
          width: 33.33%
          height: 6.0%
      - type: realtime.text
        key: environment.pressure.vaporPressureDeficit
        title: false
        alignment: BottomLeft
        display:
          font: $body
          weight: Regular
          unitPosition: Hidden
          precision: 1
          valueLabel:
            text-height: 8.5mm
            color: $accent
            matchingGroup:
              group: global.tile
              matchAll: true
        geometry:
          x: 66.67%
          y: 86.0%
          width: 33.33%
          height: 14.0%
    - type: graph
      name: forecast
      timeframe:
        days: 2
        hours: 12
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          alignment: BottomCenter
          spacingIntervals: 3, 6, 12
        lines:
          spacing: 8 mm
          weight: 0.5
      figures:
      - figure: glyphs
        margins:
          top: 7%
          bottom: 85%
        environment.temperature.dewpoint:
          plot:
            type: strip
            pins:
              key: environment.precipitation.precipitation
              size: 24
              at: 0.5
              color: $cloud
              steps:
              - - 0
                - wi:day-sunny
              - - 0.02
                - wi:sprinkle
              - - 0.1
                - wi:showers
              - - 0.3
                - wi:rain
      - figure: windarrows
        margins:
          top: 15%
          bottom: 79%
        environment.temperature.dewpoint:
          plot:
            type: strip
            pins:
              key: environment.wind.direction.direction
              glyph: wi:direction-up
              rotate: 180
              size: 20
              at: 0.5
              color: $wind
      - figure: temperature
        margins:
          bottom: 38%
          top: 27%
        environment.temperature.temperature:
          labels:
            enabled: true
          plot:
            type: plot
            gradient: TemperatureGradient
            weight: 1.0
            glow: *id001
            fill:
              opacity: 0.22
              base: 40
          resolution: 2
        environment.temperature.feelsLike:
          plot:
            type: plot
            gradient: TemperatureGradient
            weight: 0.35
            opacity: 0.6
          resolution: 2
        environment.temperature.dewpoint:
          plot:
            type: plot
            cap: square
            color: $good
            dashPattern: 5, 5
            weight: 0.35
      - figure: chance
        margins:
          bottom: 5%
          top: 68%
        min: 0
        max: 1
        environment.precipitation.probability:
          plot:
            type: plot
            color: $accent
            dashPattern: 3, 3
            weight: 0.5
            opacity: 0.9
      - figure: precipitation
        margins:
          bottom: 5%
          top: 68%
        min: 0
        max: 0.5
        environment.precipitation.precipitation:
          plot:
            type: bar
            color: $rain
            width: 0.9
            glow: *id001
          smooth: false
