  - type: stack
    name: ground
    direction: Horizontal
    size: 38%
    spacing: 4mm
    dividers:
      enabled: true
      opacity: 60%
      size: 88%
    items:
    - type: titled-group
      name: bedroom
      size: 22%
      title:
        text: BEDROOM
        height: 7mm
        font: $display
        weight: SemiBold
        color: $accent
        alignment: CenterLeft
        matchingGroup:
          group: global.head
          matchAll: true
      items:
      - preset: sparkline
        geometry:
          x: 0%
          y: 14%
          width: 50%
          height: 46%
        props:
          key: indoor.temperature.temperature#bedroom
          hours: 12
          figure: indoor
          plot:
            type: plot
            gradient: TemperatureGradient
            weight: 0.7
            opacity: 0.85
            glow: *id001
          top: 8%
          bottom: 4%
          min: 60
          max: 85
      - preset: sparkline
        geometry:
          x: 52%
          y: 14%
          width: 48%
          height: 46%
        props:
          key: indoor.humidity.humidity#bedroom
          hours: 12
          figure: humid
          plot:
            type: plot
            color: $info
            weight: 0.7
            opacity: 0.85
            glow: *id001
          top: 8%
          bottom: 4%
          min: 20
          max: 100
      - type: text
