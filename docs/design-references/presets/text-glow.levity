# Text glow: a halo drawn from the glyph outlines of tick labels and captions.
#
# `glow:` on a caption / sub-label spec, and on a tick label group (`major.labels`),
# draws a soft halo behind the glyphs. Left off, the text paints exactly as before.
# Forms are the same everywhere: `true`, `false`, or {strength, reach, passes, bloom}.
#
#   major.labels.glow   the halo behind every tick label of that group
#   caption.glow        the halo behind the caption
#   sub-label.glow      the halo behind the sub-label
- type: group
  name: main
  items:
    - type: realtime.gauge
      name: compass
      key: environment.wind.direction.direction
      title: false
      geometry: {x: 0%, y: 0%, width: 50%, height: 100%}
      display:
        radius: 94%
        arc: {start-angle: 0, end-angle: 360, weight: 3%, color: '#2a2a2e'}
        range: {min: 0, max: 360, wrap: true}
        major: {interval: 90, length: 7%, width: 2px, color: '#8d8d96', labels: {position: outside, offset: 4%, height: 12%, glow: {strength: 1.4, reach: 1.2}}}
        minor: {interval: 22.5, length: 40%, width: 1px, color: '#55555c'}
        micro: {enabled: false}
        needle: {type: arrow, length: 34%, width: 2.2%, head: 12%, tail: 28%, tail-dot: 5%, color: '#ffffff'}
        value-label: {visible: false}
        unit-label: {visible: false}
        caption: {text: WIND, size: 9%, gap: 4%, color: '#7fd4ff', glow: {strength: 1.6, reach: 1.4}}
        sub-label: {value: environment.wind.speed.speed, format: {precision: 0, show_unit: false}, size: 14%, gap: 1%, color: '#ffffff', glow: true}
    - type: realtime.gauge
      name: charge
      key: system.battery.charge
      title: false
      geometry: {x: 50%, y: 0%, width: 50%, height: 100%}
      display:
        radius: 94%
        arc: {start-angle: 0, end-angle: 360, weight: 6%, color: '#222226'}
        range: {min: 0, max: 100}
        major: {enabled: false}
        minor: {enabled: false}
        micro: {enabled: false}
        fill: {weight: 6%, color: '#ffffff'}
        needle: {visible: false}
        value-label: {position: center, size: 24%, format: {precision: 0}}
        unit-label: {visible: false}
        caption: {text: CHARGING, size: 6.5%, gap: 3%, color: '#ffd400', glow: {strength: 1.5, reach: 1.0}}
        sub-label: {text: '313 km', size: 6.5%, gap: 3%, color: '#7fd4ff', glow: true}
