# Today's temperature as a dial that fills from the range minimum up to the value.
# `fill:` with no `to` follows the gauge value; with no `from` it starts at range min.
- type: realtime.gauge
  name: gauge
  key: environment.temperature.temperature
  title: false
  display:
    arc: {weight: 5%}
    range: {min: 60, max: 110}
    fill: {weight: 5%, color: '#ff8a3d'}
    major:
      labels:
        format-spec: {show_unit: false, unit_symbol: false, precision: 0}
    value-label: {position: bottom}
