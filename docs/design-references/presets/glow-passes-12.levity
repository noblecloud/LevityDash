# The same gauge as glow-passes-4.levity at twelve passes: what the lifted cap
# buys. Each pass strokes the path again, wider and fainter - more of them make a
# smoother, longer halo, at the cost of that many more strokes per draw.
# Render with --scenario hot-clear-day.
- type: realtime.gauge
  name: glow
  key: environment.temperature.temperature
  title: false
  display:
    arc: {start-angle: -135, end-angle: 135, weight: 5%, color: '#1d1d24'}
    range: {min: 60, max: 110}
    fill: {weight: 5%, color: '#ff8a3d'}
    glow: {strength: 1.0, size: 0.7, passes: 12}
    needle: {type: dot, length: 6%, width: 7%, color: '#ffffff'}
    value-label: {position: center, size: 15%}
