# A slot that swaps its contents on a condition: UV while it is dry, rain detail while it rains.
#
# `type: switch` holds alternatives. Each child fills the slot, and the first whose `when:` holds
# is shown. A child with no `when:` always matches, so it is the default; put it last. The slot
# keeps its place in the board, so the space UV does not need goes to the rain panel, not to blank.
#
#   hold:   seconds a change must last before the slot flips (default 30s). A drizzle that starts
#           and stops at the threshold does not flap. The first pick is instant.
#   fade:   seconds of cross-fade (default 0.3s); 0 swaps at once.
#   cycle:  seconds each matching child stays up. With more than one match they take turns, so
#           `cycle: 8s` plus a `when:` on each child rotates only the ones that apply right now.
#           Without `cycle` the first match stays.
#
# `when:` takes a key, an expression or a bool, the same as a beam's `active:`. A missing value
# counts as false. A panel outside a switch may carry `when:` too, and shows only while it holds.
#
# Render both states:
#   render_dashboard.py dry.png --levity THIS --scenario uv-or-rain-dry --size 1500x520
#   render_dashboard.py wet.png --levity THIS --scenario uv-or-rain-wet --size 1500x520
- type: group
  name: main
  items:
    - type: realtime.gauge
      name: temperature
      key: environment.temperature.temperature
      title: false
      geometry: {x: 1%, y: 4%, width: 29%, height: 92%}
      display:
        radius: 90%
        arc: {gradient: TemperatureGradient, weight: 10%}
        range: {min: 30, max: 110}
        value-label: {position: below}

    - type: switch
      name: sky-slot
      hold: 0.2s
      fade: 0
      geometry: {x: 32%, y: 4%, width: 36%, height: 92%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: group
          name: rain
          when: environment.precipitation.precipitation > 0
          items:
            # Rate on a dial, today's total under it: a different shape from UV, in the same slot.
            - type: realtime.gauge
              name: rain-rate
              key: environment.precipitation.precipitation
              title: false
              geometry: {x: 0%, y: 0%, width: 100%, height: 72%}
              display:
                radius: 90%
                arc: {weight: 8%, gradient: {0: '#4aa3ff', 1: '#b06cff'}}
                range: {min: 0, max: 1}
                value-label: {position: below}
                unit-label: {visible: true, position: float-under, height: 10%}
            - type: text
              name: rain-today-title
              text: Today
              alignment: CenterLeft
              geometry: {x: 10%, y: 76%, width: 38%, height: 9%}
            - type: realtime.text
              name: rain-today
              key: environment.precipitation.daily
              title: false
              alignment: CenterRight
              geometry: {x: 40%, y: 72%, width: 50%, height: 16%}
        - type: realtime.gauge
          name: uv
          key: environment.light.uvi
          title: false
          display:
            radius: 88%
            arc: {weight: 8%}
            range: {min: 0, max: 12}
            value-label: {position: below}
            unit-label: {visible: true, position: float-under, height: 10%}

    - type: realtime.gauge
      name: humidity
      key: environment.humidity.humidity
      title: false
      geometry: {x: 70%, y: 4%, width: 29%, height: 92%}
      display:
        radius: 90%
        arc: {weight: 10%}
        range: {min: 0, max: 100}
        value-label: {position: below}
