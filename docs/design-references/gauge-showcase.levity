            major: {interval: 3, length: 7%, width: 3px, color: '#f2f2f2', labels: {enabled: false}}
            minor: {interval: 1, length: 50%, width: 1.5px, color: '#8d8d96', labels: {enabled: false}}
            micro: {enabled: false}
            value-label: {visible: false}
            unit-label: {visible: false}
            needle: {visible: false}
            markers:
            - {time: hour, type: line, length: 46%, width: 3.4%, tail: 8%, color: '#f2f2f2'}
            - {time: minute, type: line, length: 74%, width: 2.2%, tail: 8%, color: '#f2f2f2'}
