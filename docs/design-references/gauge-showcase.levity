# Gauge showcase v6: a board of gauge-ui style cards (github.com/thordursk/gauge-ui, MIT), laid out for a 2560x1440 screen.
# 30 cards on an 8 by 6 grid: 1x1 dials, 2x1 dials with a stats list, 1x2 columns and 2x2 hero cards.
# Cards vary on purpose: hairline (1%) to chunky (14-18%) arcs, sweeps of 90, 180, 240, 270, 300 and 360 degrees,
# corner dials (the pivot sits in a card corner, `anchor:`; the dial box sits inside the card padding, the number
# nests in the quarter, a caption fills the open side), needle designs, clocks, word and tick labels, segmented fills.
# Weather cards read the real sources (or a --scenario). Everything else reads made-up values
# from the Mock plugin (src/LevityDash/lib/plugins/builtin/Mock.py), which is off until
# Mock.ini says `enabled = True`.
#
# Look: dark grey track, one accent per card, Roboto Mono for numbers. Big numbers that sit in a card
# rather than on a dial are `realtime.text` items placed by geometry. Every size is a share of its card
# and cards are shares of the board, so the board scales; the shares were worked out in pixels at 2560x1440.
# Hex colours are quoted; unquoted, '#' starts a YAML comment.
# Render: render_dashboard.py OUT.png --levity THIS --scenario stormy-day --size 2560x1440 --settle 14
#
# The two clock cards pin every hand with `at: '10:08:36'`, as clock.levity does.
# A `time:` hand with no `at:` follows the wall clock, so two renders of this file
# would never agree - and a render is what the showcase is for.
- type: group
  name: main
  items:
    - type: group
      name: wind
      geometry: {x: 0.16%, y: 0.29%, width: 24.69%, height: 32.75%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: windTitle1
          text: Wind
          alignment: CenterLeft
          geometry: {x: 2.22%, y: 2.45%, width: 64%, height: 5.79%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffffff'}
        - type: text
          name: windCap2
          text: 'compass ring, needle, speed inside'
          alignment: CenterLeft
          geometry: {x: 2.22%, y: 8.92%, width: 66.46%, height: 4.01%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: windGauge3
          key: environment.wind.direction.direction
          title: false
          geometry: {x: 4.59%, y: 20.28%, width: 54.11%, height: 76.23%}
          display:
            radius: 95.23%
            arc: {start-angle: 0, end-angle: 360, weight: 3.75%, color: '#26262c', cap: flat}
            range: {min: 0, max: 360, wrap: true}
            major:
              interval: 90
              length: 5%
              width: 3px
              color: '#c9c9d0'
              labels:
                position: inside
                height: 15%
                color: '#c9c9d0'
                offset: 5%
                format: {precision: 0}
                text: compass
                rotate: false
            minor: {length: 40%, width: 1px, color: '#5d5d66', interval: 15}
            micro: {enabled: false}
            needle: {type: arrow, length: 34%, width: 2.4%, head: 12%, tail: 28%, tail-dot: 5%, color: '#ffffff'}
            value-label: {visible: false}
            unit-label: {visible: false}
            caption:
              value: environment.wind.speed.speed
              format: {precision: 0, show_unit: false}
              size: 16%
              gap: 0%
              color: '#ffffff'
            sub-label: {text: mph, size: 6.5%, gap: 1%}
        - type: text
          name: windLab4
          text: Speed
          alignment: CenterLeft
          geometry: {x: 63.29%, y: 24.96%, width: 23.73%, height: 5.35%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windValue5
          key: environment.wind.speed.speed
          title: false
          alignment: CenterRight
          geometry: {x: 81.65%, y: 24.07%, width: 15.82%, height: 7.13%}
          display: {font: Roboto Mono, color: '#ffffff', precision: 0, unit-string: '', unitPosition: inline}
        - type: text
          name: windLab6
          text: Gusts
          alignment: CenterLeft
          geometry: {x: 63.29%, y: 38.78%, width: 23.73%, height: 5.35%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windValue7
          key: environment.wind.speed.gust
          title: false
          alignment: CenterRight
          geometry: {x: 81.65%, y: 37.89%, width: 15.82%, height: 7.13%}
          display: {font: Roboto Mono, color: '#ffffff', precision: 0, unit-string: '', unitPosition: inline}
        - type: text
          name: windLab8
          text: Bearing
          alignment: CenterLeft
          geometry: {x: 63.29%, y: 52.6%, width: 23.73%, height: 5.35%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windValue9
          key: environment.wind.direction.direction
          title: false
          alignment: CenterRight
          geometry: {x: 81.65%, y: 51.71%, width: 15.82%, height: 7.13%}
          display: {font: Roboto Mono, color: '#ffffff', precision: 0, unit-string: '', unitPosition: inline}
        - type: text
          name: windLab10
          text: Clouds
          alignment: CenterLeft
          geometry: {x: 63.29%, y: 66.42%, width: 23.73%, height: 5.35%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windValue11
          key: environment.clouds.cover.cover
          title: false
          alignment: CenterRight
          geometry: {x: 81.65%, y: 65.53%, width: 15.82%, height: 7.13%}
          display: {font: Roboto Mono, color: '#ffffff', precision: 0, unit-string: '', unitPosition: inline}
        - type: text
          name: windLab12
          text: Humidity
          alignment: CenterLeft
          geometry: {x: 63.29%, y: 80.24%, width: 23.73%, height: 5.35%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windValue13
          key: environment.humidity.humidity
          title: false
          alignment: CenterRight
          geometry: {x: 81.65%, y: 79.35%, width: 15.82%, height: 7.13%}
          display: {font: Roboto Mono, color: '#ffffff', precision: 0, unit-string: '', unitPosition: inline}
    - type: group
      name: temp
      geometry: {x: 25.16%, y: 0.29%, width: 12.19%, height: 16.08%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
