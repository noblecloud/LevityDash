# Gauge showcase: one cell per gauge feature, each with a caption.
# Cells sit on relative geometry. Render with --scenario stormy-day.
# Hex colours are quoted; unquoted, '#' starts a YAML comment.
- type: group
  name: main
  items:
  - type: group
    name: plain
    geometry: {x: 0.0%, y: 0.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: plainGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display: {}
    - type: text
      text: "Plain realtime gauge"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: fill
    geometry: {x: 25.0%, y: 0.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: fillGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        fill: {weight: 5%, color: '#ff8a3d'}
        value-label: {position: below}
    - type: text
      text: "Fill: range min up to value"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: dayRange
    geometry: {x: 50.0%, y: 0.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: dayRangeGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        fill:
          from: min(environment.temperature.temperature, today)
          to: max(environment.temperature.temperature, today)
          weight: 5%
          color: '#ff8a3d'
        value-label: {position: below}
    - type: text
      text: "Fill: today's low to high"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: highLow
    geometry: {x: 75.0%, y: 0.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: highLowGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        value-label: {position: below}
        markers:
        - value: min(environment.temperature.temperature, today)
          type: marker
          length: 12%
          color: '#4aa3ff'
        - value: max(environment.temperature.temperature, today)
          type: marker
          length: 12%
          color: '#ff5a4a'
    - type: text
      text: "Markers: today's low, high"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: rain
    geometry: {x: 0.0%, y: 25.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: rainGauge
      key: environment.precipitation.precipitation
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 0, max: 0.7}
        major: {interval: 0.1}
        value-label: {position: below}
        unit-label: {visible: true, position: float-under, height: 10%}
    - type: text
      text: "Range under 1, floating unit"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: pressure
    geometry: {x: 25.0%, y: 25.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: pressureGauge
      key: environment.pressure.pressure
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 28, max: 32}
        value-label: {position: below}
        unit-label: {visible: true, position: float-under, height: 10%}
    - type: text
      text: "Pressure in inHg, 28 to 32"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: warp
    geometry: {x: 50.0%, y: 25.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: warpGauge
      key: environment.humidity.humidity
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        arc: {start-angle: -170, end-angle: 170, weight: 4%}
        range: {min: 0, max: 100}
        major: {labels: {curve: warp, height: 10%, position: outside}}
    - type: text
      text: "Tick labels: curve warp"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: glyphs
    geometry: {x: 75.0%, y: 25.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: glyphsGauge
      key: environment.humidity.humidity
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        arc: {start-angle: -170, end-angle: 170, weight: 4%}
        range: {min: 0, max: 100}
        major: {labels: {curve: glyphs, height: 10%, position: outside}}
    - type: text
      text: "Tick labels: curve glyphs"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: wide
    geometry: {x: 0.0%, y: 50.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: wideGauge
      key: environment.humidity.humidity
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        arc: {start-angle: -150, end-angle: 150}
        range: {min: 0, max: 100}
    - type: text
      text: "Wide sweep, 300 degrees"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: narrow
    geometry: {x: 25.0%, y: 50.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: narrowGauge
      key: environment.humidity.humidity
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        arc: {start-angle: -90, end-angle: 90}
        range: {min: 0, max: 100}
        value-label: {position: below}
    - type: text
      text: "Narrow sweep, 180 degrees"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: band
    geometry: {x: 50.0%, y: 50.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: bandGauge
      key: environment.humidity.humidity
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 0, max: 100}
        fill: {from: 30, to: 60, weight: 5%, color: '#4cc38a'}
        major: {interval: 25}
        value-label: {position: below}
    - type: text
      text: "Fixed fill band, 30 to 60"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: gradient
    geometry: {x: 75.0%, y: 50.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: gradientGauge
      key: environment.wind.speed.speed
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        radius: 92%
        arc: {gradient: WindSpeedGradient, weight: 10%}
        needle: {type: marker, width: 9%, length: 13%}
        major: {enabled: false, labels: {enabled: false}}
        minor: {enabled: false}
    - type: text
      text: "Gradient arc, no ticks"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: circle
    geometry: {x: 0.0%, y: 75.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: circleGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        needle: {type: circle}
    - type: text
      text: "Needle type: circle"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: triangle
    geometry: {x: 25.0%, y: 75.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: triangleGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        needle: {type: triangle}
    - type: text
      text: "Needle type: triangle"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: diamond
    geometry: {x: 50.0%, y: 75.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: diamondGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        needle: {type: diamond}
    - type: text
      text: "Needle type: diamond"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
  - type: group
    name: cap
    geometry: {x: 75.0%, y: 75.0%, width: 25.0%, height: 25.0%}
    items:
    - type: realtime.gauge
      name: capGauge
      key: environment.temperature.temperature
      title: false
      geometry: {x: 0%, y: 0%, width: 100%, height: 82%}
      display:
        range: {min: 40, max: 90}
        arc: {cap: round, weight: 9%}
        value-label: {position: below}
    - type: text
      text: "Round arc cap, heavy arc"
      geometry: {x: 3%, y: 86%, width: 94%, height: 9%}
      display: {text-height: 42%}
