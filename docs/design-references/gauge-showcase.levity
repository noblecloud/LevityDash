# Gauge showcase v5: a board of gauge-ui style cards (github.com/thordursk/gauge-ui, MIT).
# Cards vary on purpose: hairline (1%) to chunky (14-18%) arcs, sweeps of 90, 180, 240, 270, 300
# and 360 degrees, dials in a card corner with a big number beside them, dials left with a stats
# list right, a hero dial with corner arcs, signed dials, word labels, segmented fills, notches.
# Weather cards read the real sources (or a --scenario). Everything else reads made-up values
# from the Mock plugin (src/LevityDash/lib/plugins/builtin/Mock.py), which is off until
# Mock.ini says `enabled = True`.
#
# Look: dark grey track, one accent per card, some cards monochrome white on grey, Roboto Mono
# for numbers, values capped near 15% of a plain dial (`value-label: {size}`). Big numbers that sit
# in a card rather than on a dial are `realtime.text` items placed by geometry. Words inside a dial
# ("CHARGING", "of daylight left") are text items over the dial until the caption primitive lands.
# Board is 12 columns by 3 rows; every size is a share of its card, so the board scales.
# Hex colours are quoted; unquoted, '#' starts a YAML comment.
# Render: render_dashboard.py OUT.png --levity THIS --scenario stormy-day --size 1934x1170 --settle 14
- type: group
  name: main
  items:
    - type: group
      name: wind
      geometry: {x: 0.15%, y: 0.25%, width: 33.03%, height: 32.83%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: windTitle
          text: "Wind"
          alignment: CenterLeft
          geometry: {x: 4%, y: 3.5%, width: 60%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffffff'}
        - type: text
          name: windCap
          text: "compass ring, needle, speed inside"
          alignment: CenterLeft
          geometry: {x: 4%, y: 12%, width: 70%, height: 5.5%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: compassGauge
          key: environment.wind.direction.direction
          title: false
          geometry: {x: 2%, y: 22%, width: 46%, height: 74%}
          display:
            radius: 94%
            arc: {start-angle: 0, end-angle: 360, weight: 3.5%, color: '#26262c', cap: flat}
            range: {min: 0, max: 360, wrap: true}
            major:
              length: 5%
              width: 3px
              color: '#c9c9d0'
              interval: 90
              labels:
                position: inside
                height: 15%
                color: '#c9c9d0'
                offset: 5%
                format: {precision: 0}
                text: compass
                rotate: false
            minor: {length: 40%, width: 1px, color: '#5d5d66', interval: 15}
            micro: {enabled: false}
            needle: {type: arrow, length: 34%, width: 2.4%, head: 12%, tail: 28%, tail-dot: 5%, color: '#ffffff'}
            value-label: {visible: false}
            unit-label: {visible: false}
            caption: {value: environment.wind.speed.speed, format: {precision: 0, show_unit: false}, size: 16%, gap: 0%, color: '#ffffff'}
            sub-label: {text: mph, size: 6.5%, gap: 1%}
        - type: text
          name: windSL0
          text: "Speed (mph)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 33.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windSV0
          key: environment.wind.speed.speed
          title: false
          alignment: Center
          geometry: {x: 81%, y: 31.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unit-string: '', unitPosition: inline}
        - type: text
          name: windSL1
          text: "Gusts (mph)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 49.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windSV1
          key: environment.wind.speed.gust
          title: false
          alignment: Center
          geometry: {x: 81%, y: 47.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unit-string: '', unitPosition: inline}
        - type: text
          name: windSL2
          text: "Bearing"
          alignment: CenterLeft
          geometry: {x: 50%, y: 65.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windSV2
          key: environment.wind.direction.direction
          title: false
          alignment: Center
          geometry: {x: 81%, y: 63.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unitPosition: inline}
        - type: text
          name: windSL3
          text: "Clouds"
          alignment: CenterLeft
          geometry: {x: 50%, y: 81.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: windSV3
          key: environment.clouds.cover.cover
          title: false
          alignment: Center
          geometry: {x: 81%, y: 79.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unitPosition: inline}
    - type: group
      name: sun
      geometry: {x: 33.48%, y: 0.25%, width: 33.03%, height: 32.83%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: sunTitle
          text: "Sun"
          alignment: CenterLeft
          geometry: {x: 4%, y: 3.5%, width: 60%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffb454'}
        - type: text
          name: sunCap
          text: "half dial, dot rides the day, duration caption"
          alignment: CenterLeft
          geometry: {x: 4%, y: 12%, width: 70%, height: 5.5%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: sunGauge
          key: astronomy.sun.remaining
          title: false
          geometry: {x: 2%, y: 20%, width: 46%, height: 52%}
          display:
            radius: 146%
            arc: {start-angle: -90, end-angle: 90, weight: 2.2%, color: '#3a3a42', cap: round}
            range: {min: 7.52, max: 19.15}
            major: {enabled: false}
            minor: {interval: 0.5, length: 55%, width: 3px, color: '#8a8a94', labels: {enabled: false}}
            micro: {enabled: false}
            fill: {to: astronomy.sun.hour, weight: 2.2%, color: '#ffb454'}
            needle: {visible: false}
            markers:
            - {value: astronomy.sun.hour, type: dot, width: 8%, halo: 2.4%, halo-color: '#000000', color: '#ffffff'}
            value-label: {position: center, size: 10%, color: '#ffffff', format: duration}
            unit-label: {visible: false}
            sub-label: {text: of daylight left, size: 6.5%, gap: 3%}
        - type: text
          name: sunSL0
          text: "Sunrise"
          alignment: CenterLeft
          geometry: {x: 50%, y: 33.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: sunSV0
          text: "07:31"
          alignment: Center
          geometry: {x: 81%, y: 33.26%, width: 17%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, font: Roboto Mono}
        - type: text
          name: sunSL1
          text: "Sunset"
          alignment: CenterLeft
          geometry: {x: 50%, y: 49.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: sunSV1
          text: "19:09"
          alignment: Center
          geometry: {x: 81%, y: 49.26%, width: 17%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, font: Roboto Mono}
        - type: text
          name: sunSL2
          text: "Daylight"
          alignment: CenterLeft
          geometry: {x: 50%, y: 65.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: sunSV2
          text: "11h 38m"
          alignment: Center
          geometry: {x: 81%, y: 65.26%, width: 17%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, font: Roboto Mono}
        - type: text
          name: sunSL3
          text: "UV index"
          alignment: CenterLeft
          geometry: {x: 50%, y: 81.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: sunSV3
          key: environment.light.uvi
          title: false
          alignment: Center
          geometry: {x: 81%, y: 79.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unitPosition: inline}
    - type: group
      name: pressure
      geometry: {x: 66.82%, y: 0.25%, width: 33.03%, height: 32.83%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: pressureTitle
          text: "Pressure"
          alignment: CenterLeft
          geometry: {x: 4%, y: 3.5%, width: 60%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#4dd0c4'}
        - type: text
          name: pressureCap
          text: "barometer, word labels, set hand"
          alignment: CenterLeft
          geometry: {x: 4%, y: 12%, width: 70%, height: 5.5%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}, font: Roboto Mono}
        - type: realtime.gauge
          name: pressureGauge
          key: environment.pressure.pressure
          title: false
          geometry: {x: 2%, y: 22%, width: 46%, height: 76%}
          display:
            radius: 94%
            arc: {start-angle: -135, end-angle: 135, weight: 3%, color: '#26262c', cap: flat}
            range: {min: 28, max: 32}
            major:
              length: 6%
              width: 3px
              color: '#c9c9d0'
              interval: 1
              labels:
                position: inside
                height: 14%
                color: '#c9c9d0'
                offset: 3%
                format: {precision: 0}
                text: {28: Stormy, 29: Rain, 30: Change, 31: Fair, 32: Dry}
            minor: {length: 45%, width: 1px, color: '#5d5d66', interval: 0.1}
            micro: {enabled: false}
            needle: {type: tapered, length: 72%, width: 7%, tail: 16%, hub: 9%, hub-hole: 40%, hub-color: '#000000', color: '#4dd0c4'}
            markers:
            - {value: 'at(environment.pressure.pressure, -3h)', type: notch, width: 1.8%, length: 9%, color: '#ffffff'}
            value-label: {position: below, size: 10%, color: '#ffffff', value-padding: 4%, font: Roboto Mono}
        - type: text
          name: pressSL0
          text: "Now (inHg)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 33.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: pressSV0
          key: environment.pressure.pressure
          title: false
          alignment: Center
          geometry: {x: 81%, y: 31.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 2, unit-string: '', unitPosition: inline}
        - type: text
          name: pressSL1
          text: "Humidity"
          alignment: CenterLeft
          geometry: {x: 50%, y: 49.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: pressSV1
          key: environment.humidity.humidity
          title: false
          alignment: Center
          geometry: {x: 81%, y: 47.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unitPosition: inline}
        - type: text
          name: pressSL2
          text: "Dew point"
          alignment: CenterLeft
          geometry: {x: 50%, y: 65.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: pressSV2
          key: environment.temperature.dewpoint
          title: false
          alignment: Center
          geometry: {x: 81%, y: 63.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 0, unitPosition: inline}
        - type: text
          name: pressSL3
          text: "Rain rate (in/hr)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 81.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: pressSV3
          key: environment.precipitation.precipitation
          title: false
          alignment: Center
          geometry: {x: 81%, y: 79.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
    - type: group
      name: ev
      geometry: {x: 0.15%, y: 33.58%, width: 33.03%, height: 32.83%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: evTitle
          text: "EV charging"
          alignment: CenterLeft
          geometry: {x: 4%, y: 3.5%, width: 60%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffffff'}
        - type: text
          name: evSub
          text: "Wall box, 32 A"
          alignment: CenterRight
          geometry: {x: 52%, y: 3.5%, width: 44%, height: 6%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}}
        - type: realtime.gauge
          name: evGauge
          key: ev.charge.level
          title: false
          geometry: {x: 2%, y: 15%, width: 46%, height: 82%}
          display:
            radius: 94%
            arc: {start-angle: 0, end-angle: 360, weight: 8%, color: '#26262c', cap: flat}
            range: {min: 0, max: 100}
            fill: {weight: 8%, color: '#ffffff'}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            markers:
            - {value: 80, type: notch, width: 1.8%, length: 12%, color: '#ffffff'}
            value-label: {position: center, size: 22%, color: '#ffffff', format: {precision: 0}}
            unit-label: {visible: false}
            caption: {text: CHARGING, size: 6%, gap: 3%}
            sub-label: {value: ev.charge.range, size: 6.5%, gap: 3%}
        - type: text
          name: evSL0
          text: "Rate (kW)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 25.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: evSV0
          key: ev.charge.rate
          title: false
          alignment: Center
          geometry: {x: 81%, y: 23.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
        - type: text
          name: evSL1
          text: "Added (kWh)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 42.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: evSV1
          key: ev.charge.added
          title: false
          alignment: Center
          geometry: {x: 81%, y: 40.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
        - type: text
          name: evSL2
          text: "Limit"
          alignment: CenterLeft
          geometry: {x: 50%, y: 59.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: evSV2
          text: "80%"
          alignment: Center
          geometry: {x: 81%, y: 59.26%, width: 17%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, font: Roboto Mono}
        - type: text
          name: evSL3
          text: "Ready"
          alignment: CenterLeft
          geometry: {x: 50%, y: 76.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: evSV3
          text: "15:42"
          alignment: Center
          geometry: {x: 81%, y: 76.26%, width: 17%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, font: Roboto Mono}
    - type: group
      name: energy
      geometry: {x: 33.48%, y: 33.58%, width: 33.03%, height: 32.83%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: energyTitle
          text: "Energy"
          alignment: CenterLeft
          geometry: {x: 4%, y: 3.5%, width: 60%, height: 8%}
          display: {matchingGroup: {group: global.title, matchAll: true}, color: '#ffd23f'}
        - type: text
          name: energySub
          text: "Grid, kW"
          alignment: CenterRight
          geometry: {x: 52%, y: 3.5%, width: 44%, height: 6%}
          opacity: 0.6
          display: {matchingGroup: {group: global.cap, matchAll: true}}
        - type: realtime.gauge
          name: energyGauge
          key: power.energy.net
          title: false
          geometry: {x: 0%, y: 14%, width: 46%, height: 52%}
          display:
            radius: 136%
            arc: {start-angle: -90, end-angle: 90, weight: 9%, color: '#26262c', cap: flat}
            range: {min: -10, max: 10}
            fill: {weight: 9%, from: 0, color: '#ffd23f', opacity: 0.55}
            major:
              length: 9%
              width: 3px
              color: '#c9c9d0'
              interval: 5
              labels:
                position: inside
                height: 11%
                color: '#8d8d96'
                offset: 4%
                format: {precision: 0}
                font: Roboto Mono
                sign: true
            minor: {length: 50%, width: 1px, color: '#5d5d66', interval: 1}
            micro: {enabled: false}
            needle: {type: tapered, length: 80%, width: 9%, tail: 8%, hub: 7%, hub-hole: 40%, hub-color: '#000000', color: '#ffffff'}
            value-label: {visible: false}
        - type: text
          name: energyExp
          text: "Export"
          alignment: CenterLeft
          geometry: {x: 3%, y: 84%, width: 16%, height: 7%}
          display: {matchingGroup: {group: global.capC, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: energyImp
          text: "Import"
          alignment: CenterRight
          geometry: {x: 28%, y: 84%, width: 16%, height: 7%}
          display: {matchingGroup: {group: global.capC, matchAll: true}, color: '#8d8d96'}
        - type: text
          name: energySL0
          text: "Solar (kW)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 25.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: energySV0
          key: power.energy.solar
          title: false
          alignment: Center
          geometry: {x: 81%, y: 23.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
        - type: text
          name: energySL1
          text: "House (kW)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 42.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: energySV1
          key: power.energy.house
          title: false
          alignment: Center
          geometry: {x: 81%, y: 40.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
        - type: text
          name: energySL2
          text: "Car (kW)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 59.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: energySV2
          key: power.energy.car
          title: false
          alignment: Center
          geometry: {x: 81%, y: 57.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
        - type: text
          name: energySL3
          text: "Today (kWh)"
          alignment: CenterLeft
          geometry: {x: 50%, y: 76.26%, width: 31%, height: 6.48%}
          display: {matchingGroup: {group: global.stat, matchAll: true}, color: '#8d8d96'}
        - type: realtime.text
          name: energySV3
          key: power.energy.today
          title: false
          alignment: Center
          geometry: {x: 81%, y: 74.55%, width: 17%, height: 9.9%}
          display: {font: Roboto Mono, precision: 1, unit-string: '', unitPosition: inline}
    - type: group
      name: water
      geometry: {x: 66.82%, y: 33.58%, width: 16.37%, height: 16.17%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: waterTitle
          text: "Water"
          alignment: CenterLeft
          geometry: {x: 4%, y: 5%, width: 60%, height: 13%}
          display: {matchingGroup: {group: global.titleS, matchAll: true}, color: '#4aa3ff'}
        - type: realtime.text
          name: waterHero
          key: home.water.today
          title: false
          alignment: CenterLeft
          geometry: {x: 5%, y: 33%, width: 46%, height: 30%}
          display: {color: '#ffffff', precision: 0, unit-string: ' L'}
        - type: text
          name: waterFoot
          text: "Today, of 250 L average"
          alignment: CenterLeft
          geometry: {x: 5%, y: 72%, width: 90%, height: 12%}
          opacity: 0.6
          display: {matchingGroup: {group: global.capS, matchAll: true}}
        - type: realtime.gauge
          name: waterGauge
          key: home.water.today
          title: false
          geometry: {x: 52%, y: 4%, width: 46%, height: 62%}
          display:
            radius: 150%
            arc: {start-angle: -60, end-angle: 60, weight: 11%, color: '#2e2e35', cap: round}
            range: {min: 0, max: 250}
            fill: {weight: 11%, color: '#4aa3ff'}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {type: circle, width: 0%, color: '#4aa3ff'}
            value-label: {visible: false}
    - type: group
      name: washer
      geometry: {x: 83.48%, y: 33.58%, width: 16.37%, height: 16.17%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
      items:
        - type: text
          name: washerTitle
          text: "Washer"
          alignment: CenterLeft
          geometry: {x: 4%, y: 5%, width: 60%, height: 13%}
          display: {matchingGroup: {group: global.titleS, matchAll: true}, color: '#b48cff'}
        - type: realtime.text
          name: washerHero
          key: home.washer.minutes
          title: false
          alignment: CenterLeft
          geometry: {x: 5%, y: 33%, width: 46%, height: 30%}
          display: {color: '#ffffff', precision: 0, unit-string: ''}
        - type: text
          name: washerFoot
          text: "Rinsing, minutes left"
          alignment: CenterLeft
          geometry: {x: 5%, y: 72%, width: 90%, height: 12%}
          opacity: 0.6
          display: {matchingGroup: {group: global.capS, matchAll: true}}
        - type: realtime.gauge
          name: washerGauge
          key: home.washer.minutes
          title: false
          geometry: {x: 52%, y: 4%, width: 46%, height: 62%}
          display:
            radius: 125%
            arc: {start-angle: -75, end-angle: 75, weight: 11%, color: '#26262c', cap: round}
            range: {min: 0, max: 60}
            fill: {weight: 11%, color: '#b48cff'}
            major: {enabled: false}
