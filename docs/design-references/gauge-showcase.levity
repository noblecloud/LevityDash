            range: {min: 0, max: 5000}
            fill: {weight: 21.05%, color: '#ffd23f', segments: 20, gap: 4%}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            value-label: {position: center, size: 19%, color: '#ffffff', value-padding: 2%, font: Roboto Mono, format: {precision: 0}}
            unit-label: {visible: false}
            caption: {text: watts, size: 10%, gap: 2%}
    - type: group
      name: cput
      geometry: {x: 87.66%, y: 66.96%, width: 12.19%, height: 16.08%}
      border: {enabled: true, color: '#ffffff', opacity: 0.14, weight: 1}
