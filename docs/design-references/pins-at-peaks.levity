# Pins only where the line turns: `pins: {only: extremes}`.
# Icons: a condition glyph at each high and low of the temperature line. Values: the temperature itself
# (no steps, so it prints) in the line's colour. `only` is peaks, troughs or extremes; `prominence` is how far a
# turn must stand out, as a share of the line's range. Troughs take the offset's other side.
# Render: render_dashboard.py OUT.png --levity docs/design-references/pins-at-peaks.levity --scenario rain-day --size 1600x600
- type: graph
  name: temperature
  timeframe: {days: 1, hours: 12}
  annotations:
    dayLabels: {enabled: false}
    hourLabels: {alignment: BottomCenter}
  figures:
  - figure: temperature
    margins: {bottom: 25%, top: 30%}
    environment.temperature.temperature:
      plot:
        type: plot
        gradient: TemperatureGradient
        weight: 1.2
        pins:
          key: environment.precipitation.precipitation
          only: extremes
          size: 40
          offset: -1.3
          steps:
          - [0,    'wi:day-sunny']
          - [0.02, 'wi:sprinkle']
          - [0.1,  'wi:showers']
          - [0.3,  'wi:rain']
      resolution: 2
