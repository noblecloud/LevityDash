# Grow: the greenhouse showcase. A bright May afternoon with one shelf running dry.
#
# Set like a page of an almanac: a light paper theme, no cards, hairline rules and five numbered sections. Numerals in
# Fraunces (Black for the readings, hollow for the high and low), asides and names in Instrument Serif italic, section
# titles in tracked capitals.
#
# Invented data: everything under garden.* (air, light, shelf, water): a grow-controller plugin that does not exist yet.
# Fonts: Fraunces and Instrument Serif (both OFL).
#
# Generated by docs/design-references/showcase/grow.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity docs/design-references/showcase/grow.levity
#           --scenario docs/design-references/showcase/scenarios/grow.yaml --size 2880x1800 --freeze-time 2026-05-14T14:15:00
theme:
  extends: default
  mode: light
  colors:
    background: '#f2ead8'
    surface: '#e9dfc8'
    text: '#1c2618'
    muted: '#4f5c47'
    faint: '#6f7a64'
    rule: '#cdbf9f'
    accent: '#2c6a36'
    good: '#2c6a36'
    warn: '#b96c0c'
    bad: '#b0341c'
    info: '#1f6a8c'
    violet: '#6f4585'
    series-1: '#2c6a36'
    series-2: '#b96c0c'
    series-3: '#1f6a8c'
    series-4: '#b0341c'
    series-5: '#6f4585'
    series-6: '#1c2618'
  fonts:
    display: Fraunces
    body: Instrument Serif
    mono: Fraunces
items:
- type: group
  name: board
  items:
  - type: text
    text: Greenhouse
    font: $display
    weight: Black
    color: $text
    alignment: BottomLeft
    geometry:
      x: 2%
      y: 1%
      width: 44%
      height: 12.4%
    tracking: -0.035
    format-hint: Greenhouse
  - type: text
    text: a daily almanac of the glass room
    font: $body
    weight: Regular
    color: $muted
    alignment: CenterLeft
    geometry:
      x: 2.3%
      y: 13.4%
      width: 40%
      height: 2.4%
    italic: true
  - type: clock
    name: clock
    geometry:
      x: 54%
      y: 1%
      width: 44%
      height: 15%
    items:
    - format: '%A'
      filters:
      - Upper
      tracking: 0.34
      font: $display
      weight: SemiBold
      color: $accent
      alignment: BottomRight
      margins: 0
      format-hint: WEDNESDAY
      geometry:
        x: 40%
        y: 6%
        width: 60%
        height: 10%
    - format: '%-d %B'
      font: $display
      weight: Light
      italic: true
      color: $text
      alignment: BottomRight
      margins: 0
      tracking: -0.02
      format-hint: 14 May
      geometry:
        x: 20%
        y: 16%
        width: 80%
        height: 52%
    - format: '%-I:%M %p'
      filters:
      - Lower
      font: $body
      weight: Regular
      italic: true
      color: $muted
      alignment: CenterRight
      margins: 0
      format-hint: 10:00 pm
      geometry:
        x: 50%
        y: 84%
        width: 50%
        height: 16%
  - type: group
    geometry:
      x: 2%
      y: 17%
      width: 96%
      height: 0.28%
    border:
      enabled: true
      radius: 0
      fill: $text
      weight: 0
  - type: group
    geometry:
      x: 2%
      y: 17.6%
      width: 96%
      height: 0.08%
    border:
      enabled: true
      radius: 0
      fill: $text
      weight: 0
  - type: text
    text: i.
    font: $body
    weight: Regular
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 2%
      y: 19.6%
      width: 2.4%
      height: 2.2%
    matchingGroup:
      group: global.numeral
      matchAll: true
    italic: true
  - type: text
    text: THE AIR
    font: $display
    weight: Medium
    color: $text
    alignment: BottomLeft
    geometry:
      x: 4.6%
      y: 20.1%
      width: 28.4%
      height: 1.45%
    matchingGroup:
      group: global.head
      matchAll: true
    tracking: 0.24
    format-hint: HEADING
  - type: group
    geometry:
      x: 2%
      y: 22.3%
      width: 31%
      height: 0.1%
    border:
      enabled: true
      radius: 0
      fill: $text
      weight: 0
  - type: realtime.text
    key: garden.air.vpd
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 2
      valueLabel:
        color: $accent
        font: $display
        weight: Black
        tracking: -0.04
      format-hint: '0.00'
    geometry:
      x: 1.6%
      y: 23.2%
      width: 23%
      height: 19.4%
  - type: text
    text: kPa
    font: $body
    weight: Regular
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 25.4%
      y: 35.0%
      width: 7%
      height: 5%
    italic: true
  - type: text
    text: vapour pressure deficit, the pull of the air on a leaf
    font: $body
    weight: Regular
    color: $muted
    alignment: CenterLeft
    geometry:
      x: 2%
      y: 43.0%
      width: 31%
      height: 2.4%
    matchingGroup:
      group: global.aside
      matchAll: true
    italic: true
  - type: realtime.bar
    key: garden.air.vpd
    title: false
    geometry:
      x: 2%
      y: 46.6%
      width: 31%
      height: 3.4%
    display:
      range:
        min: 0.2
        max: 2.0
      track:
        weight: 26%
        color: $rule
        cap: flat
      fill:
        color: $text
        opacity: 0
      value-label:
        visible: false
      zones:
      - from: 0.4
        to: 0.8
        color: $info
        weight: 26%
      - from: 0.8
        to: 1.2
        color: $good
        weight: 26%
      - from: 1.2
        to: 1.6
        color: $warn
        weight: 26%
      - from: 1.6
        to: 2.0
        color: $bad
        weight: 26%
      pointer:
        type: triangle
        color: $text
        side: before
        size: 46%
  - type: text
    text: cuttings
    font: $body
    weight: Regular
    color: $info
    alignment: Center
    geometry:
      x: 5.444%
      y: 49.8%
      width: 6.889%
      height: 2.2%
    matchingGroup:
      group: global.zone
      matchAll: true
    italic: true
  - type: text
    text: leaf
    font: $body
    weight: Regular
    color: $good
    alignment: Center
    geometry:
      x: 12.333%
      y: 49.8%
      width: 6.889%
      height: 2.2%
    matchingGroup:
      group: global.zone
      matchAll: true
    italic: true
  - type: text
