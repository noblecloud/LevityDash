    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 2%
      y: 54.6%
      width: 14%
      height: 1.45%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.18
    format-hint: HEADING
  - type: mini-graph
    geometry:
      x: 2%
      y: 56.6%
      width: 14%
      height: 11%
    timeframe:
      hours: 24
      lookback:
        hours: 48
      offset:
        hours: -24
    annotations:
      dayLabels:
        enabled: false
      hourLabels:
        enabled: false
      lines:
        enabled: false
    indicator:
      opacity: 0
    figures:
    - figure: fig1
      margins:
        top: 45%
        bottom: 2%
      garden.air.temperature:
        plot:
          type: plot
          weight: 0.4
          opacity: 0.55
          fill:
            opacity: 0.35
            fade: true
          color: $warn
  - type: realtime.text
    key: garden.air.temperature
