        x: 28.065%
        y: 58.452%
        width: 35.484%
        height: 4.524%
      display:
        range:
          min: 0
          max: 100
        track:
          weight: 100%
          color: $rule
          cap: flat
        fill:
          color: zone
          segments: 20
          gap: 22%
          cap: flat
        value-label:
          visible: false
        zones: &id001
        - to: 60
          color: $good
          opacity: 0
        - from: 60
          to: 85
          color: $warn
          opacity: 0
        - from: 85
          color: $bad
          opacity: 0
