# Rack: the homelab showcase. A weekday evening with one node hot, one service slow, one down and a backup overdue.
#
# Every number is set in a dot-matrix face (Doto) and every label in a monospace one (JetBrains Mono), written as code
# comments. Segmented bars for the nodes, pools and drive bays, a needle dial for the power draw, a battery for the UPS,
# and a beam round the one thing that needs attention.
#
# Invented data: everything under homelab.* (a Proxmox, UniFi, ZFS, NUT, Pi-hole and uptime plugin that do not exist yet).
# Fonts: Doto and JetBrains Mono (both OFL).
#
# Generated by docs/design-references/showcase/rack.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity docs/design-references/showcase/rack.levity
#           --scenario docs/design-references/showcase/scenarios/rack.yaml --size 2880x1800 --freeze-time 2026-03-12T21:30:00
theme:
  extends: default
  colors:
    background: '#030604'
    surface: '#08110b'
    text: '#dcffe6'
    muted: '#77b78a'
    faint: '#467256'
    rule: '#16301f'
    accent: '#3dff7a'
    good: '#3dff7a'
    warn: '#ffb000'
    bad: '#ff3b30'
    info: '#4de3ff'
    violet: '#b48cff'
    series-1: '#3dff7a'
    series-2: '#4de3ff'
    series-3: '#ffb000'
    series-4: '#b48cff'
    series-5: '#ff3b30'
    series-6: '#dcffe6'
  fonts:
    display: Doto
    body: JetBrains Mono
    mono: JetBrains Mono
items:
- type: group
  name: board
  items:
  - type: text
    text: RACK/01
    font: $display
    weight: Black
    color: $accent
    alignment: CenterLeft
    geometry:
      x: 2%
      y: 2%
      width: 24%
      height: 6.4%
    tracking: 0.04
    format-hint: RACK/01
  - type: text
    text: homelab · 4 nodes · 41 guests · up 212 days
    font: $mono
    weight: Light
    color: $muted
    alignment: CenterLeft
    geometry:
      x: 27%
      y: 4.4%
      width: 42%
      height: 2.2%
    italic: true
  - type: clock
    name: clock
    geometry:
      x: 70%
      y: 2%
      width: 28%
      height: 6.4%
    items:
    - format: '%Y-%m-%d'
      font: $mono
      weight: Light
      color: $muted
      alignment: CenterRight
      margins: 0
      format-hint: '0000-00-00'
      geometry:
        x: 0%
        y: 34%
        width: 52%
        height: 36%
    - format: '%H:%M'
      font: $display
      weight: Black
      color: $text
      alignment: CenterRight
      margins: 0
      tracking: 0.04
      format-hint: 00:00
      geometry:
        x: 56%
        y: 0%
        width: 44%
        height: 100%
  - type: group
    name: clusterCard
    geometry:
      x: 2%
      y: 10.5%
      width: 31%
      height: 42%
    items:
    - type: text
      text: // cluster.cpu  %
      font: $mono
      weight: Regular
      color: $accent
      alignment: BottomLeft
      geometry:
        x: 4.194%
        y: 4.286%
        width: 91.613%
        height: 3.571%
      matchingGroup:
        group: global.note
        matchAll: true
      format-hint: heading
    - type: mini-graph
      geometry:
        x: 4.194%
        y: 11.905%
        width: 54.839%
        height: 35.714%
      timeframe:
        hours: 24
        lookback:
          hours: 48
        offset:
          hours: -24
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
        opacity: 0
      figures:
      - figure: fig1
        margins:
          top: 35%
          bottom: 2%
        homelab.cluster.cpu:
          plot:
            type: plot
            weight: 0.45
            opacity: 0.7
            fill:
              opacity: 0.3
              fade: true
            color: $accent
            glow: &id002
              strength: 1.3
              reach: 2.0
              passes: 6
        min: 0
        max: 100
    - type: realtime.text
      key: homelab.cluster.cpu
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $accent
          font: $display
          weight: Black
          matchingGroup:
            group: global.hero
            matchAll: true
        format-hint: '00'
      geometry:
        x: 4.194%
        y: 10.476%
        width: 54.839%
        height: 35.714%
    - type: text
      text: load
      font: $mono
      weight: Regular
      color: $faint
      alignment: BottomLeft
      geometry:
        x: 64.194%
        y: 10.476%
        width: 29.032%
        height: 3.571%
      matchingGroup:
        group: global.note
        matchAll: true
      format-hint: heading
    - type: realtime.text
