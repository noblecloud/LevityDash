      display:
        radius: 96%
        arc:
          start-angle: -130
          end-angle: 130
          weight: 6%
          color: $rule
          cap: round
        range:
          min: 0
          max: 200
        major:
          enabled: false
          labels:
            enabled: false
        minor:
          enabled: false
        micro:
          enabled: false
        needle:
          visible: false
        fill:
          weight: 6%
          color: zone
          cap: round
          glow: *id001
        value-label:
          visible: true
          position: center
          size: 30%
          format:
            precision: 0
        unit-label:
          visible: false
        zones:
        - from: 0
          to: 50
          color: $good
        - from: 50
          to: 100
          color: $warn
        - from: 100
          to: 150
          color: '#ff9a1f'
        - from: 150
          to: 200
          color: $bad
