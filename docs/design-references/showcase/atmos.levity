# Atmos: the weather showcase. A June evening before a wet Sunday.
#
# Three bands. Top: the temperature in a heavy face beside the clock in a thin one, with the day's high and low as hollow
# numerals and the sun's arc. Middle: two and a half days of forecast with the day names behind it, and today's
# temperature round a 24 hour clock. Bottom: five cards (wind rose, rain, pressure with a tendency switch, air quality,
# rooms).
#
# Invented data: environment.airQuality.* (index, pm25, ozone, pollen) and environment.precipitation.{tomorrow, probabilityNext24, peakNext24}.
# Fonts: SF Pro Display and SF Compact Display (Apple; not bundled). Set theme fonts to change them.
#
# Generated by docs/design-references/showcase/atmos.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity docs/design-references/showcase/atmos.levity
#           --scenario docs/design-references/showcase/scenarios/atmos.yaml --size 2880x1800 --freeze-time 2026-06-20T18:40:00
theme:
  extends: default
  colors:
    background: '#000000'
    surface: '#0c0a1a'
    text: '#f4f1ff'
    muted: '#b9b3dd'
    faint: '#7d76a8'
    rule: '#2a2550'
    accent: '#00f0ff'
    good: '#39ff88'
    warn: '#ffe600'
    bad: '#ff4a3d'
    info: '#38b6ff'
    rain: '#3d8bff'
    wind: '#b6ff00'
    pink: '#ff2bd6'
    violet: '#a98bff'
    series-1: '#00e5ff'
    series-2: '#ff9a1f'
    series-3: '#b6ff00'
    series-4: '#ffe600'
    series-5: '#8a5cff'
    series-6: '#ff2bd6'
  fonts:
    display: SF Compact Display
    body: SF Pro Display
    mono: Roboto Mono
  scales:
    TemperatureGradient:
      10°F: '#8a2bff'
      30°F: '#3d6bff'
      45°F: '#00e5ff'
      58°F: '#00ffa8'
      68°F: '#b6ff00'
      77°F: '#ffe600'
      86°F: '#ff9a1f'
      96°F: '#ff4a3d'
      108°F: '#ff2a2a'
    PressureGradient:
      0: '#8a5cff'
      1: '#00e5ff'
items:
- type: group
  name: board
  items:
  - type: text
    text: OUTSIDE
    font: $display
    weight: Medium
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 2%
      y: 3%
      width: 20%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.temperature
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color:
          scale: $temperature
          of: environment.temperature.temperature
        font: $body
        weight: Black
        tracking: -0.045
      format-hint: 00°
    geometry:
      x: 1.7%
      y: 5%
      width: 21%
      height: 21.5%
  - type: text
    text: HIGH
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 24%
      y: 6.2%
      width: 8%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.high
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $bad
        font: $body
        weight: Black
        matchingGroup:
          group: global.hollow
          matchAll: true
        outline: 2.5
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 24%
      y: 8.6%
      width: 9%
      height: 7.6%
  - type: text
    text: LOW
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 24%
      y: 16.6%
      width: 8%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.low
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $info
        font: $body
        weight: Black
        matchingGroup:
          group: global.hollow
          matchAll: true
        outline: 2.5
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 24%
      y: 19%
      width: 9%
      height: 7.6%
  - type: realtime.bar
    key: environment.temperature.temperature
    title: false
    geometry:
      x: 2%
      y: 27.6%
      width: 31%
      height: 2.6%
    display:
      range:
        min: 40
        max: 100
      track:
        weight: 34%
        color: $rule
      fill:
        color: $accent
        from: environment.temperature.low
        to: environment.temperature.high
        gradient: TemperatureGradient
        glow: &id001
          strength: 1.4
          reach: 2.0
          passes: 6
      value-label:
        visible: false
      pointer:
        type: triangle
        color: $text
        side: before
  - type: realtime.text
    key: environment.condition.condition
    title: false
    alignment: CenterLeft
    geometry:
      x: 2%
      y: 30.3%
      width: 14%
      height: 2.6%
    display:
      valueLabel:
        color: $muted
        font: $body
        weight: Light
        italic: true
  - type: text
    text: feels
    font: $body
    weight: Light
    color: $faint
    alignment: CenterRight
    geometry:
      x: 16.5%
      y: 30.3%
      width: 4%
      height: 2.6%
    italic: true
  - type: realtime.text
    key: environment.temperature.feelsLike
    title: false
    alignment: CenterLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $text
        font: $body
        weight: Medium
      format-hint: 00°
    geometry:
      x: 21%
      y: 30.3%
      width: 4%
      height: 2.6%
  - type: text
    text: dew
    font: $body
    weight: Light
    color: $faint
    alignment: CenterRight
    geometry:
      x: 25%
      y: 30.3%
      width: 3%
      height: 2.6%
    italic: true
  - type: realtime.text
    key: environment.temperature.dewpoint
    title: false
    alignment: CenterLeft
    display:
      unitPosition: Inline
      precision: 0
      valueLabel:
        color: $good
        font: $body
        weight: Medium
      format-hint: 00°
    geometry:
      x: 28.5%
      y: 30.3%
      width: 4%
      height: 2.6%
  - type: clock
    name: clock
    geometry:
      x: 36%
      y: 3%
      width: 31%
      height: 30%
    items:
    - format: '%A'
      filters:
      - Upper
      tracking: 0.32
      font: $display
      weight: SemiBold
      color: $accent
      alignment: BottomLeft
      format-hint: WEDNESDAY
      margins: 0
      geometry:
        x: 1.29%
        y: 0.0%
        width: 64.516%
        height: 5.0%
    - format: '%-I:%M'
      font: $body
      weight: Thin
      tracking: -0.02
      alignment: BottomLeft
      format-hint: '10:00'
      margins: 0
      geometry:
        x: 0.0%
        y: 6.667%
        width: 83.871%
        height: 71.667%
    - format: '%p'
      tracking: 0.2
      font: $display
      weight: SemiBold
      color: $muted
      alignment: BottomLeft
      format-hint: PM
      margins: 0
      geometry:
        x: 83.871%
        y: 71.333%
        width: 12.903%
        height: 5.667%
    - type: moon
      glowStrength: 0
      geometry:
        x: 82.581%
        y: 11.333%
        width: 17.419%
        height: 28.667%
    - format: '%B %-d'
      filters:
      - AddOrdinal
      font: $body
      weight: Light
      italic: true
      color: $muted
      alignment: CenterLeft
      format-hint: September 30th
      margins: 0
      geometry:
        x: 1.29%
        y: 91.0%
        width: 51.613%
        height: 8.667%
  - type: text
    text: DAYLIGHT LEFT
    font: $display
    weight: Medium
    color: $warn
    alignment: BottomLeft
    geometry:
      x: 70%
      y: 3%
      width: 20%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.gauge
    key: astronomy.sun.remaining
    title: false
    geometry:
      x: 70%
      y: 6%
      width: 18.5%
      height: 21%
    display:
      radius: 96%
      arc:
        start-angle: -90
        end-angle: 90
        weight: 3.2%
        color: $rule
        cap: round
      range:
        min: 5.37
        max: 20.97
      major:
        enabled: false
        labels:
          enabled: false
      minor:
        enabled: false
      micro:
        enabled: false
      needle:
        visible: false
      fill:
        weight: 3.2%
        color: $warn
        cap: round
        glow: *id001
        to: astronomy.sun.hour
      value-label:
        visible: true
        position: center
        size: 17%
        format: duration
      unit-label:
        visible: false
      markers:
      - value: astronomy.sun.hour
        type: dot
        width: 9%
        halo: 2.4%
        halo-color: $background
        color: $warn
  - type: text
    text: SUNRISE
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 90.5%
      y: 6%
      width: 7.5%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: astronomy.sun.rise
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 90.5%
      y: 7.9%
      width: 7.5%
      height: 5.6%
  - type: text
    text: SUNSET
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 90.5%
      y: 15.2%
      width: 7.5%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: astronomy.sun.set
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $pink
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 90.5%
      y: 17.1%
      width: 7.5%
      height: 5.6%
  - type: text
    text: UV
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 70%
      y: 24.6%
      width: 6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.light.uvi
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color:
          scale: UVIndexGradient
          of: environment.light.uvi
        font: $body
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '00'
    geometry:
      x: 70%
      y: 26.5%
      width: 6%
      height: 5.6%
  - type: text
    text: CLOUD %
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 77%
      y: 24.6%
      width: 6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.clouds.cover.cover
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $violet
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '000'
      format:
        unit_symbol: false
    geometry:
      x: 77%
      y: 26.5%
      width: 6%
      height: 5.6%
  - type: text
    text: HUMID %
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 84%
      y: 24.6%
      width: 6%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.humidity.humidity
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $info
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '000'
      format:
        unit_symbol: false
    geometry:
      x: 84%
      y: 26.5%
      width: 6%
      height: 5.6%
  - type: text
    text: VIS MI
    font: $display
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 91%
      y: 24.6%
      width: 7%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: realtime.text
    key: environment.visibility
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $text
        font: $body
        weight: Regular
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '00'
    geometry:
      x: 91%
      y: 26.5%
      width: 7%
      height: 5.6%
  - type: graph
    name: forecast
    geometry:
      x: 2%
      y: 35.5%
      width: 69%
      height: 31%
    timeframe:
      days: 2
      hours: 18
      offset:
        hours: -5
    annotations:
      dayLabels:
        position: Center
        alignment: Center
        opacity: 13%
        height: 40%
      hourLabels:
        alignment: BottomCenter
        spacingIntervals: 6, 12
        height: 4.2%
      lines:
        spacing: 12 mm
        weight: 0.4
    figures:
    - figure: sky
      margins:
        top: 4%
        bottom: 86%
      environment.temperature.dewpoint:
        plot:
          type: strip
          pins:
            key: environment.precipitation.precipitation
            size: 34
            at: 0.5
            color: $violet
            spacing: 3.2
            steps:
            - - 0
              - wi:day-sunny
            - - 0.02
              - wi:sprinkle
            - - 0.1
              - wi:showers
            - - 0.25
              - wi:rain
    - figure: arrows
      margins:
        top: 15%
        bottom: 78%
      environment.temperature.dewpoint:
        plot:
          type: strip
          pins:
            key: environment.wind.direction.direction
            glyph: wi:direction-up
            rotate: 180
            size: 26
            at: 0.5
            spacing: 3.4
            color: $wind
    - figure: temperature
      margins:
        top: 30%
        bottom: 30%
      environment.temperature.temperature:
        labels:
          enabled: true
        plot:
          type: plot
          gradient: TemperatureGradient
          weight: 1.1
          glow: *id001
          fill:
            opacity: 0.4
            fade: true
        resolution: 2
      environment.temperature.dewpoint:
        plot:
          type: plot
          color: $good
          dashPattern: 5, 5
          weight: 0.35
          cap: square
    - figure: chance
      margins:
        top: 70%
        bottom: 9%
      min: 0
      max: 1
      environment.precipitation.probability:
        plot:
          type: plot
          color: $pink
          dashPattern: 3, 3
          weight: 0.45
          opacity: 0.9
    - figure: rain
      margins:
        top: 70%
        bottom: 9%
      min: 0
      max: 0.45
      environment.precipitation.precipitation:
        plot:
          type: bar
          color: $rain
          width: 0.86
          glow: *id001
        smooth: false
  - type: text
    text: TODAY ROUND THE CLOCK
    font: $display
    weight: Medium
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 74%
      y: 35.5%
      width: 24%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.14
    format-hint: HEADING
  - type: polar
    name: dayClock
    plot: clock
    key: environment.temperature.temperature
    window: today
    gradient:
    - at: 30
      color: '#3d6bff'
    - at: 45
      color: '#00e5ff'
    - at: 58
      color: '#00ffa8'
    - at: 68
      color: '#b6ff00'
    - at: 77
      color: '#ffe600'
    - at: 86
      color: '#ff9a1f'
    - at: 96
      color: '#ff4a3d'
    geometry:
      x: 74.5%
      y: 38.6%
      width: 23%
      height: 28%
  - type: group
    name: windCard
    geometry:
      x: 2.0%
      y: 69.5%
      width: 18.24%
      height: 27.5%
    items:
    - type: text
      text: WIND · MPH
      font: $display
      weight: Medium
      color: $wind
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 6.182%
        width: 86.842%
        height: 5.455%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.14
      format-hint: HEADING
    - type: mini-graph
      geometry:
        x: 6.579%
        y: 13.818%
        width: 41.667%
        height: 34.545%
      timeframe:
        hours: 12
        lookback:
          hours: 0
        offset:
          hours: 0
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
        opacity: 0
      figures:
      - figure: fig1
        margins:
          top: 55%
          bottom: 2%
        environment.wind.speed.speed:
          plot:
            type: plot
            weight: 0.45
            opacity: 0.6
            fill:
              opacity: 0.25
              fade: true
            color: $wind
            glow: *id001
        min: 0
    - type: realtime.text
      key: environment.wind.speed.speed
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $wind
          font: $body
          weight: Bold
          matchingGroup:
            group: global.hero2
            matchAll: true
          tracking: -0.03
        format-hint: '00'
      geometry:
        x: 6.579%
        y: 13.818%
        width: 41.667%
        height: 34.545%
    - type: polar
      name: rose
      plot: rose
      direction: environment.wind.direction.direction
      speed: environment.wind.speed.speed
      window: 24h
      legend: false
      rings: 3
      compass: 4
      gradient:
      - at: 0
        color: '#3d8bff'
      - at: 6
        color: '#00e5ff'
      - at: 11
        color: '#b6ff00'
      - at: 17
        color: '#ffe600'
      geometry:
        x: 46.053%
        y: 2.182%
        width: 50.439%
        height: 56.0%
    - type: text
      text: GUST
      font: $display
      weight: Medium
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 60.364%
        width: 27.412%
        height: 5.455%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.14
      format-hint: HEADING
    - type: realtime.text
      key: environment.wind.speed.gust
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $warn
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '00'
      geometry:
        x: 6.579%
        y: 67.273%
        width: 27.412%
        height: 20.364%
    - type: text
      text: PEAK
      font: $display
      weight: Medium
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 36.184%
        y: 60.364%
        width: 27.412%
        height: 5.455%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.14
      format-hint: HEADING
    - type: realtime.text
      key: max(environment.wind.speed.gust, today)
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $bad
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: '00'
      geometry:
        x: 36.184%
        y: 67.273%
        width: 27.412%
        height: 20.364%
    - type: text
      text: FROM
      font: $display
      weight: Medium
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 65.789%
        y: 60.364%
        width: 27.412%
        height: 5.455%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.14
      format-hint: HEADING
    - type: realtime.text
      key: environment.wind.direction.direction
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $info
          font: $body
          weight: Regular
          matchingGroup:
            group: global.tile
            matchAll: true
        format-hint: SSW
      geometry:
        x: 65.789%
        y: 67.273%
        width: 27.412%
        height: 20.364%
    border:
      enabled: true
      radius: 24px
      fill: $surface
      weight: 0
  - type: group
    name: rainCard
    geometry:
      x: 21.44%
      y: 69.5%
      width: 18.24%
      height: 27.5%
    items:
    - type: text
      text: RAIN · NEXT 24 H
      font: $display
      weight: Medium
      color: $rain
      alignment: BottomLeft
      geometry:
        x: 6.579%
        y: 6.182%
        width: 86.842%
        height: 5.455%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.14
      format-hint: HEADING
    - type: realtime.text
      key: environment.precipitation.probabilityNext24
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Inline
        precision: 0
        valueLabel:
          color: $rain
          font: $body
          weight: Bold
          matchingGroup:
            group: global.hero2
            matchAll: true
          tracking: -0.03
        format-hint: 00%
      geometry:
        x: 6.579%
        y: 13.818%
        width: 49.342%
        height: 34.545%
    - type: text
      text: chance
      font: $body
      weight: Light
