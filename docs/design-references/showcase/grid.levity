        y: 10.55%
        width: 56.391%
        height: 43.578%
    - type: text
      text: '%'
      font: $display
      weight: Thin
      color: $good
      alignment: BottomLeft
      geometry:
        x: 62.782%
        y: 35.321%
        width: 18.797%
        height: 17.431%
      matchingGroup:
        group: global.unit
        matchAll: true
      format-hint: '%'
    - type: realtime.bar
      key: energy.battery.charge
      title: false
      geometry:
        x: 4.887%
        y: 57.339%
        width: 90.226%
        height: 14.679%
      display:
        range:
          min: 0
          max: 100
        track:
          weight: 100%
          color: $muted
        fill:
          color: $good
          segments: 10
          gap: 12%
        value-label:
          visible: false
        style: battery
        markers:
        - value: energy.battery.reserve
          type: line
          color: $bad
    - type: text
      text: FILLING KW
      font: $display
      weight: Bold
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 4.887%
        y: 76.606%
        width: 30.075%
        height: 4.358%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.2
      format-hint: HEADING
    - type: realtime.text
