        width: 13.704%
        height: 4.279%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.2
      format-hint: HEADING
    - type: graph
      name: day
      geometry:
        x: 2.407%
        y: 12.162%
        width: 95.185%
        height: 84.234%
      timeframe:
        hours: 24
        lookback:
          hours: 30
        offset:
          hours: -13.5
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          alignment: BottomCenter
          spacingIntervals: '3'
          height: 5%
        lines:
          weight: 0.3
      figures:
      - figure: solar
        margins:
          top: 6%
          bottom: 10%
        min: -3
        max: 8.4
        energy.solar.power:
          plot:
            type: plot
            color: $accent
            weight: 0.9
            glow: *id001
            fill:
              opacity: 0.4
              fade: true
      - figure: street
        margins:
          top: 6%
          bottom: 10%
        min: -3
        max: 8.4
        energy.grid.power:
          plot:
            type: plot
            color: $info
            weight: 0.45
            dashPattern: 4, 4
      - figure: home
        margins:
          top: 6%
          bottom: 10%
        min: -3
        max: 8.4
        energy.home.power:
          plot:
            type: plot
            color: $text
            weight: 0.5
    border:
      enabled: true
      radius: 24px
      fill: $surface
      weight: 0
