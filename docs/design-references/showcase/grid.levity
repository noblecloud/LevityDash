        width: 100.0%
        height: 71.698%
      timeframe:
        hours: 24
        lookback:
          hours: 48
        offset:
          hours: -24
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
