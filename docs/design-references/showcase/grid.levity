# Grid: the home-energy showcase. A clear July lunchtime with the array near its peak.
#
# One typeface, Big Shoulders Display, at its two ends: Black for every number, Thin for the unit beside it, tracked
# Bold capitals for labels. Yellow is the sun, white the house, cyan the street, green the battery, orange the car.
#
# Invented data: everything under energy.* (solar, home, grid, battery, today, vehicle): an inverter, battery and
# charger plugin that do not exist yet.
# Fonts: Big Shoulders Display (OFL).
#
# Generated by docs/design-references/showcase/grid.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity docs/design-references/showcase/grid.levity
#           --scenario docs/design-references/showcase/scenarios/grid.yaml --size 2880x1800 --freeze-time 2026-07-09T13:30:00
theme:
  extends: default
  colors:
    background: '#04060c'
    surface: '#0b101c'
    text: '#f3f6ff'
    muted: '#9aa6c4'
    faint: '#66708c'
    rule: '#1c2540'
    accent: '#ffd60a'
    good: '#3dff8f'
    warn: '#ff8a1f'
    bad: '#ff4a3d'
    info: '#2ee6ff'
    violet: '#a98bff'
    series-1: '#ffd60a'
    series-2: '#2ee6ff'
    series-3: '#3dff8f'
    series-4: '#ff8a1f'
    series-5: '#a98bff'
    series-6: '#ff4a3d'
  fonts:
    display: Big Shoulders Display
    body: Big Shoulders Display
    mono: JetBrains Mono
items:
- type: group
  name: board
  items:
  - type: text
    text: GRID
    font: $display
    weight: Black
    color: $accent
    alignment: CenterLeft
    geometry:
      x: 2%
      y: 1.6%
      width: 12%
      height: 5%
    tracking: 0.3
    format-hint: GRID
  - type: text
    text: 9.6 KWP ON THE ROOF   ·   13.5 KWH IN THE GARAGE   ·   ONE CAR
    font: $display
    weight: Light
    color: $muted
    alignment: CenterLeft
    geometry:
      x: 15%
      y: 2.9%
      width: 55%
      height: 2.4%
    tracking: 0.22
  - type: clock
    name: clock
    geometry:
      x: 78%
      y: 1.6%
      width: 20%
      height: 5%
    items:
    - format: '%H:%M'
      font: $display
      weight: Thin
      color: $text
      alignment: CenterRight
      margins: 0
      tracking: 0.06
      format-hint: 00:00
      geometry:
        x: 0%
        y: 0%
        width: 100%
        height: 100%
  - type: group
    name: solarCard
    geometry:
      x: 2%
      y: 8.4%
      width: 40%
      height: 43.6%
    items:
    - type: text
      text: SOLAR
      font: $display
      weight: Bold
      color: $accent
      alignment: BottomLeft
      geometry:
        x: 3.25%
        y: 4.587%
        width: 93.5%
        height: 4.358%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.2
      format-hint: HEADING
    - type: mini-graph
      geometry:
        x: 0.0%
        y: 20.642%
        width: 100.0%
        height: 79.358%
      timeframe:
        hours: 16
        lookback:
          hours: 30
        offset:
          hours: -8.3
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
        opacity: 0.5
      figures:
      - figure: sun
        margins:
          top: 38%
          bottom: 0%
        min: 0
        max: 8.4
        energy.solar.power:
          plot:
            type: plot
            color: $accent
            weight: 0.7
            opacity: 0.9
            glow: &id001
              strength: 1.3
              reach: 2.0
              passes: 6
            fill:
              opacity: 0.45
              fade: true
    - type: realtime.text
      key: energy.solar.power
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $accent
          font: $display
          weight: Black
          tracking: 0.01
        format-hint: '0.00'
      geometry:
        x: 2.5%
        y: 10.55%
        width: 75.0%
        height: 61.927%
    - type: text
      text: KW
      font: $display
      weight: Thin
      color: $accent
      alignment: BottomLeft
      geometry:
        x: 79.25%
        y: 49.541%
        width: 17.5%
        height: 20.642%
      matchingGroup:
        group: global.unit
        matchAll: true
      format-hint: KW
    - type: text
      text: PEAK TODAY
      font: $display
      weight: Bold
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 3.25%
        y: 76.606%
        width: 22.5%
        height: 4.358%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.2
      format-hint: HEADING
    - type: realtime.text
      key: energy.solar.peak
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $text
          font: $display
          weight: Black
          matchingGroup:
            group: global.tile
            matchAll: true
          tracking: 0.01
        format-hint: '0.00'
      geometry:
        x: 3.25%
        y: 82.11%
        width: 22.5%
        height: 16.055%
    - type: text
      text: OF ARRAY %
      font: $display
      weight: Bold
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 30.75%
        y: 76.606%
        width: 22.5%
        height: 4.358%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.2
      format-hint: HEADING
    - type: realtime.text
      key: energy.solar.power * 100 / energy.solar.capacity
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 0
        valueLabel:
          color: $muted
          font: $display
          weight: Black
          matchingGroup:
            group: global.tile
            matchAll: true
          tracking: 0.01
        format-hint: '00'
      geometry:
        x: 30.75%
        y: 82.11%
        width: 22.5%
        height: 16.055%
    border:
      enabled: true
      radius: 24px
      fill: $surface
      weight: 0
  - type: group
    name: homeCard
    geometry:
      x: 43.2%
      y: 8.4%
      width: 27%
      height: 21.2%
    items:
    - type: text
      text: HOME
      font: $display
      weight: Bold
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 4.815%
        y: 9.434%
        width: 90.37%
        height: 8.962%
      matchingGroup:
        group: global.cap
        matchAll: true
      tracking: 0.2
      format-hint: HEADING
    - type: mini-graph
      geometry:
        x: 0.0%
        y: 28.302%
        width: 100.0%
        height: 71.698%
      timeframe:
        hours: 24
        lookback:
          hours: 48
        offset:
          hours: -24
      annotations:
        dayLabels:
          enabled: false
        hourLabels:
          enabled: false
        lines:
          enabled: false
      indicator:
        opacity: 0
      figures:
      - figure: fig1
        margins:
          top: 40%
          bottom: 0%
        energy.home.power:
          plot:
            type: plot
            weight: 0.45
            opacity: 0.4
            fill:
              opacity: 0.3
              fade: true
            color: $text
        min: 0
    - type: realtime.text
      key: energy.home.power
      title: false
      alignment: BottomLeft
      display:
        unitPosition: Hidden
        precision: 2
        valueLabel:
          color: $text
          font: $display
          weight: Black
          matchingGroup:
            group: global.mid
            matchAll: true
          tracking: 0.01
        format-hint: '0.00'
      geometry:
        x: 4.815%
        y: 23.585%
        width: 59.259%
        height: 66.038%
    - type: text
      text: KW
      font: $display
      weight: Thin
      color: $muted
      alignment: BottomLeft
      geometry:
        x: 65.556%
        y: 58.491%
        width: 22.222%
        height: 28.302%
      matchingGroup:
        group: global.unit
        matchAll: true
      format-hint: KW
    border:
      enabled: true
      radius: 24px
      fill: $surface
      weight: 0
  - type: group
    name: streetCard
    geometry:
      x: 43.2%
      y: 30.8%
      width: 27%
      height: 21.2%
    items:
    - type: text
