# Tide: the coast showcase. A September afternoon with the tide coming in.
#
# No cards: a gradient ground, hairline rules and one wide rounded face (Unbounded) in Black for the sea level, Light
# for the clock and hollow for the turns of the tide, with Space Grotesk for labels. Two days of water across the
# middle with the day names behind it; a compass strip, a swell sparkline and a wind rose below.
#
# Invented data: everything under marine.* (tide, wind, swell, water): a tide-table and buoy plugin that do not exist yet.
# Fonts: Unbounded and Space Grotesk (both OFL).
#
# Generated by docs/design-references/showcase/tide.py; edit that and run build.py.
# Render: render_dashboard.py OUT.png --levity docs/design-references/showcase/tide.levity
#           --scenario docs/design-references/showcase/scenarios/tide.yaml --size 2880x1800 --freeze-time 2026-09-18T16:20:00
theme:
  extends: default
  colors:
    background: '#020a18'
    surface: '#061a2b'
    text: '#eefaff'
    muted: '#9cc3d6'
    faint: '#6590a6'
    rule: '#143a52'
    accent: '#35f0d0'
    good: '#35f0d0'
    warn: '#ffc24a'
    bad: '#ff6b5e'
    info: '#4db8ff'
    violet: '#9d8cff'
    series-1: '#35f0d0'
    series-2: '#4db8ff'
    series-3: '#ffc24a'
    series-4: '#9d8cff'
    series-5: '#ff6b5e'
    series-6: '#eefaff'
  fonts:
    display: Unbounded
    body: Space Grotesk
    mono: Space Grotesk
  scales:
    sky:
      0: '#010611'
      1: '#06323d'
background:
  gradient: $sky
  angle: 180
items:
- type: group
  name: board
  items:
  - type: text
    text: HALF MOON BAY   ·   SEA LEVEL ABOVE THE CHART
    font: $body
    weight: Medium
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 2%
      y: 3%
      width: 44%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.tide.height
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 1
      valueLabel:
        color: $text
        font: $display
        weight: Black
        tracking: -0.05
      format-hint: '0.0'
    geometry:
      x: 1.6%
      y: 6%
      width: 31%
      height: 25%
  - type: text
    text: ft
    font: $display
    weight: Light
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 26%
      y: 21.4%
      width: 8%
      height: 8%
  - type: switch
    name: tendency
    hold: 10m
    geometry:
      x: 2%
      y: 31.6%
      width: 24%
      height: 2.6%
    items:
    - type: text
      text: RISING  ↑
      font: $body
      weight: Bold
      color: $accent
      alignment: CenterLeft
      geometry:
        x: 0%
        y: 0%
        width: 100%
        height: 100%
      tracking: 0.3
      when: marine.tide.height - at(marine.tide.height, -1h) > 0
    - type: text
      text: FALLING  ↓
      font: $body
      weight: Bold
      color: $warn
      alignment: CenterLeft
      geometry:
        x: 0%
        y: 0%
        width: 100%
        height: 100%
      tracking: 0.3
  - type: text
    text: HIGH WATER
    font: $body
    weight: Medium
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 46%
      y: 6.6%
      width: 14%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.tide.nextHigh
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $accent
        font: $display
        weight: Black
        matchingGroup:
          group: global.turn
          matchAll: true
        outline: 2.5
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 46%
      y: 9%
      width: 17%
      height: 8.4%
  - type: realtime.text
    key: marine.tide.highHeight
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 1
      valueLabel:
        color: $text
        font: $display
        weight: Light
        matchingGroup:
          group: global.turnft
          matchAll: true
      format-hint: '0.0'
    geometry:
      x: 63.6%
      y: 11.4%
      width: 6%
      height: 5%
  - type: text
    text: LOW WATER
    font: $body
    weight: Medium
    color: $info
    alignment: BottomLeft
    geometry:
      x: 46%
      y: 20.6%
      width: 14%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.tide.nextLow
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $info
        font: $display
        weight: Black
        matchingGroup:
          group: global.turn
          matchAll: true
        outline: 2.5
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 46%
      y: 23%
      width: 17%
      height: 8.4%
  - type: realtime.text
    key: marine.tide.lowHeight
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 1
      valueLabel:
        color: $text
        font: $display
        weight: Light
        matchingGroup:
          group: global.turnft
          matchAll: true
      format-hint: '0.0'
    geometry:
      x: 63.6%
      y: 25.4%
      width: 6%
      height: 5%
  - type: clock
    name: clock
    geometry:
      x: 72%
      y: 3%
      width: 26%
      height: 16%
    items:
    - format: '%A %-d %B'
      filters:
      - Upper
      tracking: 0.2
      font: $body
      weight: Medium
      color: $muted
      alignment: BottomRight
      margins: 0
      format-hint: WEDNESDAY 30 SEPTEMBER
      geometry:
        x: 0%
        y: 0%
        width: 100%
        height: 9.4%
    - format: '%-I:%M'
      font: $display
      weight: Light
      color: $text
      alignment: BottomRight
      margins: 0
      tracking: -0.03
      format-hint: '10:00'
      geometry:
        x: 0%
        y: 18%
        width: 100%
        height: 82%
  - type: moon
    glowStrength: 0
    geometry:
      x: 92%
      y: 21.6%
      width: 6%
      height: 9.6%
  - type: text
    text: SUNSET
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 74%
      y: 21.6%
      width: 9%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: astronomy.sun.set
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $display
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: 0:00
      format: '%-I:%M'
    geometry:
      x: 74%
      y: 23.7%
      width: 9%
      height: 6%
  - type: group
    geometry:
      x: 2%
      y: 36.4%
      width: 96%
      height: 0.1%
    border:
      enabled: true
      radius: 0
      fill: $rule
      weight: 0
  - type: graph
    name: water
    geometry:
      x: 2%
      y: 37.4%
      width: 96%
      height: 30.6%
    timeframe:
      hours: 44
      lookback:
        hours: 14
      offset:
        hours: -6
    annotations:
      dayLabels:
        position: Center
        alignment: Center
        opacity: 10%
        height: 46%
      hourLabels:
        alignment: BottomCenter
        spacingIntervals: 3, 6
        height: 4.6%
      lines:
        weight: 0.3
    figures:
    - figure: tide
      margins:
        top: 22%
        bottom: 12%
      min: -0.5
      max: 6.6
      marine.tide.height:
        labels:
          enabled: true
        plot:
          type: plot
          color: $accent
          weight: 1.0
          glow: &id001
            strength: 1.2
            reach: 2.0
            passes: 6
          fill:
            opacity: 0.5
            fade: true
  - type: group
    geometry:
      x: 2%
      y: 69%
      width: 96%
      height: 0.1%
    border:
      enabled: true
      radius: 0
      fill: $rule
      weight: 0
  - type: group
    geometry:
      x: 25.2%
      y: 71.4%
      width: 0.06%
      height: 26%
    border:
      enabled: true
      radius: 0
      fill: $rule
      weight: 0
  - type: group
    geometry:
      x: 49.7%
      y: 71.4%
      width: 0.06%
      height: 26%
    border:
      enabled: true
      radius: 0
      fill: $rule
      weight: 0
  - type: group
    geometry:
      x: 74.2%
      y: 71.4%
      width: 0.06%
      height: 26%
    border:
      enabled: true
      radius: 0
      fill: $rule
      weight: 0
  - type: text
    text: WIND · KNOTS
    font: $body
    weight: Medium
    color: $warn
    alignment: BottomLeft
    geometry:
      x: 2%
      y: 71.4%
      width: 22.5%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.wind.speed
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $warn
        font: $display
        weight: Black
        matchingGroup:
          group: global.hero
          matchAll: true
        tracking: -0.04
      format-hint: '00'
    geometry:
      x: 1.8%
      y: 74.0%
      width: 12%
      height: 11%
  - type: text
    text: GUST
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 15.4%
      y: 76.0%
      width: 8%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.wind.gust
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $text
        font: $display
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '00'
    geometry:
      x: 15.4%
      y: 78.1%
      width: 8%
      height: 6%
  - type: polar
    name: heading
    plot: carousel
    direction: marine.wind.direction
    view: 120
    compass: 16
    legend: false
    geometry:
      x: 2%
      y: 86.8%
      width: 22.5%
      height: 10.6%
  - type: text
    text: SWELL · FEET
    font: $body
    weight: Medium
    color: $info
    alignment: BottomLeft
    geometry:
      x: 26.5%
      y: 71.4%
      width: 22.5%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: mini-graph
    geometry:
      x: 26.5%
      y: 74.0%
      width: 22.5%
      height: 11%
    timeframe:
      hours: 24
      lookback:
        hours: 0
      offset:
        hours: 0
    annotations:
      dayLabels:
        enabled: false
      hourLabels:
        enabled: false
      lines:
        enabled: false
    indicator:
      opacity: 0
    figures:
    - figure: fig1
      margins:
        top: 40%
        bottom: 2%
      marine.swell.height:
        plot:
          type: plot
          weight: 0.45
          opacity: 0.6
          fill:
            opacity: 0.3
            fade: true
          color: $info
          glow: *id001
      min: 3
      max: 7.5
  - type: realtime.text
    key: marine.swell.height
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 1
      valueLabel:
        color: $info
        font: $display
        weight: Black
        matchingGroup:
          group: global.hero
          matchAll: true
        tracking: -0.04
      format-hint: '0.0'
    geometry:
      x: 26.3%
      y: 74.0%
      width: 12%
      height: 11%
  - type: text
    text: EVERY, SEC
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 26.5%
      y: 87.8%
      width: 9%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.swell.period
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $text
        font: $display
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '00'
    geometry:
      x: 26.5%
      y: 89.9%
      width: 9%
      height: 6%
  - type: text
    text: FROM
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 37.0%
      y: 87.8%
      width: 11%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.swell.direction
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $info
        font: $display
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: WNW
    geometry:
      x: 37.0%
      y: 89.9%
      width: 11%
      height: 6%
  - type: text
    text: WATER · °F
    font: $body
    weight: Medium
    color: $accent
    alignment: BottomLeft
    geometry:
      x: 51%
      y: 71.4%
      width: 22.5%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: marine.water.temperature
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $accent
        font: $display
        weight: Black
        matchingGroup:
          group: global.hero
          matchAll: true
        tracking: -0.04
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 50.8%
      y: 74.0%
      width: 12%
      height: 11%
  - type: realtime.bar
    key: marine.water.temperature
    title: false
    geometry:
      x: 51%
      y: 85.8%
      width: 22.5%
      height: 0.9%
    display:
      range:
        min: 48
        max: 70
      track:
        weight: 100%
        color: $rule
      fill:
        color: $accent
        glow: *id001
      value-label:
        visible: false
      markers:
      - value: environment.temperature.temperature
        type: triangle
        color: $text
  - type: text
    text: AIR
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 51%
      y: 87.8%
      width: 9%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: environment.temperature.temperature
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $text
        font: $display
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '00'
      format:
        unit_symbol: false
    geometry:
      x: 51%
      y: 89.9%
      width: 9%
      height: 6%
  - type: text
    text: SEEN, MILES
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 61.5%
      y: 87.8%
      width: 11%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: realtime.text
    key: environment.visibility
    title: false
    alignment: BottomLeft
    display:
      unitPosition: Hidden
      precision: 0
      valueLabel:
        color: $text
        font: $display
        weight: Medium
        matchingGroup:
          group: global.tile
          matchAll: true
      format-hint: '00'
    geometry:
      x: 61.5%
      y: 89.9%
      width: 11%
      height: 6%
  - type: text
    text: WIND, THE LAST DAY
    font: $body
    weight: Medium
    color: $muted
    alignment: BottomLeft
    geometry:
      x: 75.5%
      y: 71.4%
      width: 22.5%
      height: 1.5%
    matchingGroup:
      group: global.cap
      matchAll: true
    tracking: 0.2
    format-hint: HEADING
  - type: polar
    name: rose
    plot: rose
    direction: marine.wind.direction
    speed: marine.wind.speed
    window: 24h
    legend: false
    rings: 3
    compass: 8
    gradient:
    - at: 0
      color: '#4db8ff'
    - at: 8
      color: '#35f0d0'
    - at: 14
      color: '#ffc24a'
    geometry:
      x: 77.5%
      y: 73.8%
      width: 18.5%
      height: 23.8%
