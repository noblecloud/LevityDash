# Station: a dense everyday weather board for a 15in 16:10 screen.
#
# Built from the options reference and cross-section.levity, without a mockup.
# Every hero carries its context: today's range, the last hour's change, the
# peak still to come. One layered graph at the bottom holds the day. The right
# slot is a switch: lightning takes it when a strike is near, rain while it
# rains, and UV and sky always take turns. The middle band holds the bedroom
# and the terrarium, and a second slot that turns through what needs a look.
#
# Render: render_dashboard.py OUT.png --levity docs/design-references/boards/station.levity
#           --scenario station-day --size 1440x900
#
# Hex colours are quoted. Unquoted, YAML reads '#' as a comment.
theme:
  extends: default
  colors:
    muted: '#a3a7b0'
    faint: '#8b8f98'
    rule: '#34363d'
    accent: '#ff9124'
    good: '#14e3c0'
    warn: '#ffd400'
    bad: '#ff3048'
    info: '#1a8cff'
vars:
  t: environment.temperature.temperature
  rain: environment.precipitation.precipitation
  prob: environment.precipitation.probability
  pres: environment.pressure.pressure
  ws: environment.wind.speed.speed
  wg: environment.wind.speed.gust
  uv: environment.light.uvi
items:
- type: stack
  name: main
  defaultType: group
  padding: 1.5mm
  spacing: 2mm
  dividers: {enabled: true, opacity: 60%, size: 98%}
  items:

  # ================= NOW ===================================================
  - type: stack
    name: now
    direction: Horizontal
    size: 40%
    spacing: 2.5mm
    dividers: {enabled: true, opacity: 60%, size: 90%}
    shared:
      display:
        font: Roboto Mono
    items:

    # Temperature: the hero, today's range on a bar under it, and the readings
    # that change how the number feels.
    - type: group
      name: temperature
      size: 31%
      items:
      - type: realtime.text
        key: $t
        title: false
        display:
          font: Nunito
          unitPosition: Inline
          valueLabel: {margins: 2%}
        geometry: {x: 0%, y: 0%, width: 58%, height: 52%}
      - type: value-stack
        shared:
          title: {color: $muted}
        geometry: {x: 60%, y: 3%, width: 40%, height: 49%}
        spacing: 0.6mm
        items:
        - environment.temperature.feelsLike: {title: {text: Feels}, display: {valueLabel: {color: $accent}}}
        - environment.temperature.dewpoint:  {title: {text: Dew pt}, display: {valueLabel: {color: $good}}}
        - environment.temperature.heatIndex: {title: {text: Heat idx}}
        - environment.humidity.humidity:     {title: {text: Humidity}}
        - environment.temperature.wetBulb:   {title: {text: Wet bulb}}
      - type: realtime.bar
        key: $t
        title: false
        geometry: {x: 0%, y: 54%, width: 100%, height: 22%}
        display:
          range: {min: 50, max: 100}
          track: {weight: 18%}
          fill:
            from: 'min($t, today)'
            to: 'max($t, today)'
            gradient: TemperatureGradient
          pointer: {type: triangle, color: $text, side: before}
          markers:
          - {value: 'min($t, today)', type: line, color: $info}
          - {value: 'max($t, today)', type: line, color: $bad}
          major: {interval: 10, side: after, labels: true}
          value-label: {visible: false}
      - type: value-stack
        shared:
          title: {color: $muted, matchingGroup: {group: rowTitle@temperature, matchAll: true}}
          display:
            unitPosition: Hidden
            valueLabel: {matchingGroup: {group: rowValue@temperature, matchAll: true}}
        direction: Horizontal
        geometry: {x: 0%, y: 78%, width: 100%, height: 22%}
        spacing: 1mm
        items:
        - {type: realtime.text, key: 'min($t, today)', title: {text: Low}, display: {valueLabel: {color: $info}}}
        - {type: realtime.text, key: 'max($t, today)', title: {text: High}, display: {valueLabel: {color: $bad}}}
        - {type: realtime.text, key: '$t - at($t, -1h)', title: {text: 1 hr}, display: {valueLabel: {color: $warn}}}
        - {type: realtime.text, key: 'avg($t, today)', title: {text: Avg}}

    # Wind: a compass whose middle is the speed, gust and peak beside it.
    - type: group
      name: wind
      size: 21%
      items:
      - type: realtime.gauge
        key: environment.wind.direction.direction
        title: false
        geometry: {x: 0%, y: 0%, width: 100%, height: 72%}
        display:
          radius: 92%
          arc: {start-angle: 0, end-angle: 360, weight: 3%, color: $rule}
          range: {min: 0, max: 360, wrap: true}
          major: {interval: 90, length: 8%, width: 2px, color: $faint, labels: {position: inside, offset: 4%, height: 9%, rotate: false, text: compass}}
          minor: {interval: 22.5, length: 40%, width: 1px, color: $rule}
          micro: {enabled: false}
          needle: {type: arrow, length: 34%, width: 2.4%, head: 12%, tail: 28%, tail-dot: 5%, color: $accent}
          value-label: {visible: false}
          unit-label: {visible: false}
          caption: {value: $ws, format: {precision: 0, show_unit: false}, size: 17%, gap: 0%, color: $text}
          sub-label: {text: mph, size: 6.5%, gap: 1%}
      - type: value-stack
        shared:
          title: {color: $muted, matchingGroup: {group: rowTitle@wind, matchAll: true}}
          display:
            unitPosition: Hidden
            valueLabel: {matchingGroup: {group: rowValue@wind, matchAll: true}}
        direction: Horizontal
        geometry: {x: 0%, y: 76%, width: 100%, height: 24%}
        spacing: 1mm
        items:
        - {type: realtime.text, key: $wg, title: {text: Gust}, display: {valueLabel: {color: $accent}}}
        - {type: realtime.text, key: 'max($wg, today)', title: {text: Peak}, display: {valueLabel: {color: $bad}}}
        - {type: realtime.text, key: 'avg($ws, 3h)', title: {text: Avg 3h}}

    # Rain and pressure: the chance now, what is due, and the slope that says
    # whether it is coming.
    - type: group
      name: rain
      size: 24%
      items:
      - type: realtime.text
        key: $prob
        title: {text: Rain chance, height: 18%, color: $muted}
        display:
          precision: 0
          font: Nunito
          unitPosition: Inline
          valueLabel: {color: $info}
        geometry: {x: 0%, y: 0%, width: 48%, height: 38%}
      - type: value-stack
        shared:
          title: {color: $muted}
        geometry: {x: 50%, y: 2%, width: 50%, height: 38%}
        spacing: 0.5mm
        items:
        - {type: realtime.text, key: 'max($prob, today)', title: {text: Peak}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: $rain, title: {text: Rate}}
        - environment.precipitation.daily: {title: {text: Due today}}
        - environment.yesterday.precipitation.precipitation: {title: {text: Yesterday}}
      - type: realtime.text
        key: $pres
        title: {text: Pressure, height: 18%, color: $muted}
        display:
          unitPosition: FloatUnder
        geometry: {x: 0%, y: 44%, width: 48%, height: 34%}
      - type: mini-graph
        timeframe: {hours: 12}
        annotations:
          dayLabels: {enabled: false}
          hourLabels: {enabled: false}
        indicator: {color: white, opacity: 0.3}
        margins: {top: 14%, bottom: 10%}
        figures:
        - figure: pressure
          min: 29.9
          max: 30.1
          environment.pressure.pressure:
            plot: {type: plot, color: '#ff9124', weight: 0.5}
        geometry: {x: 50%, y: 46%, width: 50%, height: 32%}
      - type: value-stack
        shared:
          title: {color: $muted, matchingGroup: {group: rowTitle@rain, matchAll: true}}
          display:
            unitPosition: Hidden
            valueLabel: {matchingGroup: {group: rowValue@rain, matchAll: true}}
        direction: Horizontal
        geometry: {x: 0%, y: 80%, width: 100%, height: 20%}
        spacing: 1mm
        items:
        - {type: realtime.text, key: '$pres - at($pres, -3h)', title: {text: 3 hr}, display: {valueLabel: {color: $accent}}}
        - {type: realtime.text, key: 'min($pres, today)', title: {text: Low}}
        - {type: realtime.text, key: 'max($pres, today)', title: {text: High}}

    # The slot: lightning when a strike is within 10 mi, otherwise UV and sky
    # take turns.
    - type: switch
      name: slot
      cycle: 20s
      fade: 0.4s
      items:
      - type: group
        name: lightning
        when: environment.lightning.distance < 10mi
        items:
        - type: realtime.text
          key: environment.lightning.distance
          title: {text: Lightning, height: 14%, color: $bad}
          display: {font: Nunito, unitPosition: Inline, valueLabel: {color: $warn}}
          geometry: {x: 0%, y: 0%, width: 100%, height: 50%}
        - type: value-stack
          shared:
            title: {color: $muted}
          geometry: {x: 0%, y: 54%, width: 100%, height: 46%}
          items:
          - environment.lightning.count: {title: {text: Strikes}}
          - environment.precipitation.precipitation: {title: {text: Rain rate}}
          - environment.wind.speed.gust: {title: {text: Gust}}
      - type: group
        name: rain-now
        when: '$rain > 0'
        items:
        - type: realtime.text
          key: $rain
          title: {text: Raining, height: 14%, color: $info}
          display: {font: Nunito, unitPosition: Inline, valueLabel: {color: $info}}
          geometry: {x: 0%, y: 0%, width: 100%, height: 50%}
        - type: value-stack
          shared:
            title: {color: $muted}
          geometry: {x: 0%, y: 54%, width: 100%, height: 46%}
          items:
          - environment.precipitation.daily: {title: {text: Today}}
          - {type: realtime.text, key: 'max($rain, 1h)', title: {text: Peak 1h}}
          - {type: realtime.text, key: 'at($rain, 1h)', title: {text: Rate +1h}}
      - type: group
        name: uv
        items:
        - type: realtime.gauge
          key: $uv
          title: false
          geometry: {x: 0%, y: 0%, width: 100%, height: 62%}
          display:
            radius: 92%
            arc: {start-angle: -125, end-angle: 125, weight: 7%, color: $rule}
            range: {min: 0, max: 12}
            zones:
            - {to: 3, color: $good, opacity: 0}
            - {from: 3, to: 6, color: $warn, opacity: 0}
            - {from: 6, to: 8, color: $accent, opacity: 0}
            - {from: 8, to: 11, color: $bad, opacity: 0}
            - {from: 11, color: '#b03cff', opacity: 0}
            fill: {weight: 7%, color: zone}
            markers:
            - {value: 'max($uv, today)', type: marker, length: 12%, color: $text}
            major: {interval: 3, labels: {position: inside, height: 8%}}
            minor: {enabled: false}
            needle: {visible: false}
            value-label: {position: center, size: 22%}
            unit-label: {visible: false}
            sub-label: {text: UV index, size: 7%}
        - type: value-stack
          shared:
            title: {color: $muted}
          geometry: {x: 0%, y: 64%, width: 100%, height: 36%}
          spacing: 0.5mm
          items:
          - {type: realtime.text, key: 'max($uv, today)', title: {text: Peak}}
          - {type: realtime.text, key: 'at($uv, 1h)', title: {text: UV +1h}}
          - {type: realtime.text, key: 'at($uv, 3h)', title: {text: UV +3h}}
          - environment.light.irradiance.irradiance: {title: {text: Sun}}
          - environment.light.illuminance: {title: {text: Light}}
      - type: group
        name: sky
        items:
        - type: realtime.text
          key: environment.clouds.cover.cover
          title: {text: Cloud, height: 14%, color: $muted}
          display: {font: Nunito, unitPosition: Inline, precision: 0}
          geometry: {x: 0%, y: 0%, width: 100%, height: 34%}
        - type: value-stack
          shared:
            title: {color: $muted}
          geometry: {x: 0%, y: 40%, width: 100%, height: 60%}
          items:
          - environment.clouds.cover.low:  {title: {text: Low}, display: {precision: 0}}
          - environment.clouds.cover.mid:  {title: {text: Mid}, display: {precision: 0}}
          - environment.clouds.cover.high: {title: {text: High}, display: {precision: 0}}
          - environment.visibility:        {title: {text: Visibility}}

  # ================= ROOMS =================================================
  # Inside: the bedroom and the terrarium, each against its own day. The right
  # slot turns through whatever needs a look now: heat, storms on the way,
  # a terrarium out of range, a flat sensor battery. With nothing to flag it
  # shows inside against outside.
  - type: stack
    name: rooms
    direction: Horizontal
    size: 23%
    spacing: 2.5mm
    dividers: {enabled: true, opacity: 60%, size: 90%}
    shared:
      display:
        font: Roboto Mono
    items:

    # Bedroom: the hero, its day against the outdoor line, then the readings.
    - type: titled-group
      name: indoor
      size: 31%
      title: {text: Indoor, height: 0.5cm, color: $muted}
      items:
      - type: realtime.text
        key: indoor.temperature.temperature#bedroom
        title: false
        display: {font: Nunito, unitPosition: Inline}
        geometry: {x: 0%, y: 0%, width: 40%, height: 58%}
      - type: mini-graph
        timeframe: {hours: 24}
        annotations:
          dayLabels: {enabled: false}
          hourLabels: {enabled: false}
        indicator: {color: white, opacity: 0.3}
        margins: {top: 8%, bottom: 8%}
        figures:
        - figure: temperature
          min: 60
          max: 90
          environment.temperature.temperature:
            plot: {type: plot, color: '#8b8f98', weight: 0.25, dashPattern: '2, 3'}
          indoor.temperature.temperature#bedroom:
            plot: {type: plot, gradient: TemperatureGradient, weight: 0.5}
        geometry: {x: 42%, y: 0%, width: 58%, height: 58%}
      - type: value-stack
        shared:
          title: {color: $muted, matchingGroup: {group: rowTitle@indoor, matchAll: true}}
          display:
            unitPosition: Hidden
            valueLabel: {matchingGroup: {group: rowValue@indoor, matchAll: true}}
        direction: Horizontal
        spacing: 1mm
        geometry: {x: 0%, y: 62%, width: 100%, height: 38%}
        items:
        - {type: realtime.text, key: indoor.humidity.humidity#bedroom, title: {text: Humid}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: indoor.temperature.dewpoint#bedroom, title: {text: Dew pt}, display: {precision: 0, valueLabel: {color: $good}}}
        - {type: realtime.text, key: 'indoor.temperature.temperature#bedroom - $t', title: {text: vs out}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: 'max(indoor.temperature.temperature#bedroom, today)', title: {text: High}, display: {precision: 0}}
        - {type: realtime.text, key: indoor.battery.battery#bedroom, title: {text: Batt}, display: {precision: 0}}

    # Terrarium: temperature and humidity side by side, since humidity is the
    # one the plants care about. The graph puts both on one day.
    - type: titled-group
      name: terrarium
      size: 37%
      title: {text: Terrarium, height: 0.5cm, color: $good}
      items:
      - type: realtime.text
        key: indoor.temperature.temperature#terrarium
        title: false
        display: {font: Nunito, unitPosition: Inline}
        geometry: {x: 0%, y: 0%, width: 31%, height: 58%}
      - type: realtime.text
        key: indoor.humidity.humidity#terrarium
        title: false
        display: {font: Nunito, unitPosition: Inline, precision: 0, valueLabel: {color: $info}}
        geometry: {x: 32%, y: 0%, width: 30%, height: 58%}
      - type: mini-graph
        timeframe: {hours: 24}
        annotations:
          dayLabels: {enabled: false}
          hourLabels: {enabled: false}
        indicator: {color: white, opacity: 0.3}
        margins: {top: 8%, bottom: 8%}
        figures:
        - figure: humidity
          indoor.humidity.humidity#terrarium:
            plot: {type: plot, color: '#1a8cff', weight: 0.4}
        - figure: temperature
          min: 70
          max: 90
          indoor.temperature.temperature#terrarium:
            plot: {type: plot, gradient: TemperatureGradient, weight: 0.5}
        geometry: {x: 64%, y: 0%, width: 36%, height: 58%}
      - type: value-stack
        shared:
          title: {color: $muted, matchingGroup: {group: rowTitle@terrarium, matchAll: true}}
          display:
            unitPosition: Hidden
            valueLabel: {matchingGroup: {group: rowValue@terrarium, matchAll: true}}
        direction: Horizontal
        spacing: 1mm
        geometry: {x: 0%, y: 62%, width: 100%, height: 38%}
        items:
        - {type: realtime.text, key: indoor.temperature.dewpoint#terrarium, title: {text: Dew pt}, display: {precision: 0, valueLabel: {color: $good}}}
        - {type: realtime.text, key: indoor.temperature.heatIndex#terrarium, title: {text: Heat idx}, display: {precision: 0}}
        - {type: realtime.text, key: 'min(indoor.temperature.temperature#terrarium, today)', title: {text: Low}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: 'max(indoor.temperature.temperature#terrarium, today)', title: {text: High}, display: {precision: 0, valueLabel: {color: $bad}}}
        - {type: realtime.text, key: 'min(indoor.humidity.humidity#terrarium, today)', title: {text: RH low}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: indoor.battery.battery#terrarium, title: {text: Batt}, display: {precision: 0, valueLabel: {color: $bad}}}

    # Watch: a rotating slot of conditional panels. Each one takes part in the
    # turn only while its condition holds; the last has none and always does.
    - type: switch
      name: watch
      cycle: 10s
      fade: 0.4s
      hold: 10s
      items:
      - type: group
        name: heat
        when: 'environment.temperature.heatIndex > 90°F'
        items:
        - type: realtime.text
          key: 'environment.temperature.heatIndex'
          title: {text: Heat, height: 18%, color: $bad}
          display: {font: Nunito, unitPosition: Inline, valueLabel: {color: $bad}}
          geometry: {x: 0%, y: 0%, width: 38%, height: 100%}
        - type: value-stack
          shared:
            title: {color: $muted}
          spacing: 0.4mm
          geometry: {x: 40%, y: 0%, width: 60%, height: 100%}
          items:
          - {type: realtime.text, key: environment.temperature.feelsLike, title: {text: Feels}, display: {valueLabel: {color: $accent}}}
          - environment.temperature.wetBulb: {title: {text: Wet bulb}}
          - {type: realtime.text, key: $uv, title: {text: UV}}
          - {type: realtime.text, key: 'max(environment.temperature.heatIndex, today)', title: {text: Peak}}
      - type: group
        name: storms
        when: 'at($prob, 2h) > 60%'
        items:
        - type: realtime.text
          key: 'at($prob, 2h)'
          title: {text: Storms ahead, height: 18%, color: $info}
          display: {font: Nunito, unitPosition: Inline, precision: 0, valueLabel: {color: $info}}
          geometry: {x: 0%, y: 0%, width: 38%, height: 100%}
        - type: value-stack
          shared:
            title: {color: $muted}
          spacing: 0.4mm
          geometry: {x: 40%, y: 0%, width: 60%, height: 100%}
          items:
          - {type: realtime.text, key: 'at($rain, 2h)', title: {text: Rate +2h}}
          - {type: realtime.text, key: 'at($wg, 2h)', title: {text: Gust +2h}, display: {valueLabel: {color: $accent}}}
          - {type: realtime.text, key: '$pres - at($pres, -3h)', title: {text: Press 3h}}
          - {type: realtime.text, key: environment.lightning.distance, title: {text: Strike}}
      - type: group
        name: terrarium-dry
        when: 'indoor.humidity.humidity#terrarium < 70%'
        items:
        - type: realtime.text
          key: 'indoor.humidity.humidity#terrarium'
          title: {text: Terrarium dry, height: 18%, color: $warn}
          display: {font: Nunito, unitPosition: Inline, precision: 0, valueLabel: {color: $warn}}
          geometry: {x: 0%, y: 0%, width: 38%, height: 100%}
        - type: value-stack
          shared:
            title: {color: $muted}
          spacing: 0.4mm
          geometry: {x: 40%, y: 0%, width: 60%, height: 100%}
          items:
          - {type: realtime.text, key: 'min(indoor.humidity.humidity#terrarium, today)', title: {text: Low}, display: {precision: 0}}
          - {type: realtime.text, key: indoor.temperature.temperature#terrarium, title: {text: Temp}}
      - type: group
        name: terrarium-hot
        when: 'indoor.temperature.temperature#terrarium > 86°F'
        items:
        - type: realtime.text
          key: 'indoor.temperature.temperature#terrarium'
          title: {text: Terrarium hot, height: 18%, color: $bad}
          display: {font: Nunito, unitPosition: Inline, valueLabel: {color: $bad}}
          geometry: {x: 0%, y: 0%, width: 38%, height: 100%}
        - type: value-stack
          shared:
            title: {color: $muted}
          spacing: 0.4mm
          geometry: {x: 40%, y: 0%, width: 60%, height: 100%}
          items:
          - {type: realtime.text, key: indoor.humidity.humidity#terrarium, title: {text: Humid}, display: {precision: 0}}
          - {type: realtime.text, key: 'max(indoor.temperature.temperature#terrarium, today)', title: {text: High}}
      - type: group
        name: battery
        when: 'indoor.battery.battery#terrarium < 20%'
        items:
        - type: realtime.text
          key: 'indoor.battery.battery#terrarium'
          title: {text: Sensor battery, height: 18%, color: $warn}
          display: {font: Nunito, unitPosition: Inline, precision: 0, valueLabel: {color: $warn}}
          geometry: {x: 0%, y: 0%, width: 38%, height: 100%}
        - type: value-stack
          shared:
            title: {color: $muted}
          spacing: 0.4mm
          geometry: {x: 40%, y: 0%, width: 60%, height: 100%}
          items:
          - {type: realtime.text, key: indoor.battery.battery#bedroom, title: {text: Bedroom}, display: {precision: 0}}
          - {type: realtime.text, key: indoor.battery.battery#terrarium, title: {text: Terrarium}, display: {precision: 0, valueLabel: {color: $warn}}}
      - type: group
        name: inside-out
        items:
        - type: realtime.text
          key: 'indoor.temperature.temperature#bedroom - $t'
          title: {text: Inside vs out, height: 18%, color: $muted}
          display: {font: Nunito, unitPosition: Inline, precision: 0, valueLabel: {color: $info}}
          geometry: {x: 0%, y: 0%, width: 38%, height: 100%}
        - type: value-stack
          shared:
            title: {color: $muted}
          spacing: 0.4mm
          geometry: {x: 40%, y: 0%, width: 60%, height: 100%}
          items:
          - {type: realtime.text, key: 'indoor.temperature.dewpoint#bedroom - environment.temperature.dewpoint', title: {text: Dew pt}, display: {precision: 0}}
          - {type: realtime.text, key: 'indoor.temperature.heatIndex#bedroom - environment.temperature.heatIndex', title: {text: Heat idx}, display: {precision: 0}}
          - {type: realtime.text, key: 'indoor.temperature.temperature#terrarium - indoor.temperature.temperature#bedroom', title: {text: Terr vs rm}, display: {precision: 0}}

  # ================= DAY ===================================================
  # One graph for the day: temperature, feels and dew point on top; rain as
  # bars with its chance as a line underneath; pressure on its own axis.
  - type: stack
    name: day
    direction: Horizontal
    spacing: 2.5mm
    dividers: {enabled: true, opacity: 60%, size: 90%}
    items:
    - type: graph
      name: today
      timeframe: {days: 1}
      annotations:
        dayLabels: {enabled: false}
        hourLabels: {alignment: BottomCenter, spacingIntervals: '1, 3, 6'}
        lines: {spacing: 8 mm, weight: 0.6}
      figures:
      - figure: temperature
        margins: {top: 10%, bottom: 36%}
        environment.temperature.temperature:
          labels: {enabled: true}
          plot: {type: plot, gradient: TemperatureGradient, weight: 1}
          resolution: 2
        environment.temperature.feelsLike:
          plot: {type: plot, color: '#ff9124', weight: 0.4, dashPattern: '4, 4'}
          resolution: 2
        environment.temperature.dewpoint:
          plot: {type: plot, color: '#14e3c0', weight: 0.5}
          resolution: 2
      - figure: pressure
        margins: {top: 16%, bottom: 40%}
        min: 29.85
        max: 30.15
        environment.pressure.pressure:
          plot: {type: plot, color: '#e0e3e8', weight: 0.3, dashPattern: '1, 3'}
      - figure: rain
        margins: {top: 70%, bottom: 6%}
        max: 0.5
        environment.precipitation.precipitation:
          plot: {type: bar, gradient: PrecipitationRateGradient, width: 0.8, radius: 0.25}
      - figure: chance
        margins: {top: 70%, bottom: 6%}
        min: 0
        max: 1
        environment.precipitation.probability:
          plot: {type: plot, color: '#1a8cff', weight: 0.4}

    # What the next hours bring, read straight off the forecast.
    - type: titled-group
      name: ahead
      size: 18%
      title: {text: Ahead, height: 0.5cm}
      items:
      - type: value-stack
        shared:
          title: {color: $muted}
        spacing: 0.5mm
        items:
        - {type: realtime.text, key: 'at($t, 1h)', title: {text: Temp +1h}}
        - {type: realtime.text, key: 'at($t, 3h)', title: {text: Temp +3h}}
        - {type: realtime.text, key: 'at($t, 6h)', title: {text: Temp +6h}}
        - {type: realtime.text, key: 'at(environment.temperature.feelsLike, 3h)', title: {text: Feels +3h}, display: {valueLabel: {color: $accent}}}
        - {type: realtime.text, key: 'at(environment.humidity.humidity, 3h)', title: {text: Humid +3h}}
        - spacer: {size: 1.5mm}
        - {type: realtime.text, key: 'at($prob, 1h)', title: {text: Rain +1h}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: 'at($prob, 3h)', title: {text: Rain +3h}, display: {precision: 0, valueLabel: {color: $info}}}
        - {type: realtime.text, key: 'at($rain, 2h)', title: {text: Rate +2h}, display: {valueLabel: {color: $info}}}
        - spacer: {size: 1.5mm}
        - {type: realtime.text, key: 'at($ws, 2h)', title: {text: Wind +2h}}
        - {type: realtime.text, key: 'at($wg, 2h)', title: {text: Gust +2h}, display: {valueLabel: {color: $accent}}}
        - {type: realtime.text, key: 'at($pres, 3h)', title: {text: Press +3h}}
        - {type: realtime.text, key: 'at(environment.clouds.cover.cover, 3h)', title: {text: Cloud +3h}, display: {precision: 0}}
