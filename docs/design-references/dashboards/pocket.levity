# Pocket: the day on a phone, portrait. A 1170 x 2532 screen (19.5:9).
#
# One column of panels, placed by a grid with named areas, so the picture of the layout is the layout. From the
# top: the temperature now with three readings beside it and today's range under it; a strip that turns to what
# needs a look (a switch of `when:` panels; the one with no `when:` is the quiet fallback); the next four hours;
# the next three days; and three rings.
#
# The two tables are real tables: one column of row names, one column per quantity, and the quantity's unit
# said once at the head of its column. Every column of numbers is right-aligned, so its digits share one edge.
#
# Type: five sizes, each one dashboard-wide size group with `matchAll`, pinned with `text-height` (the `vars:`
# below are the whole scale): labels `global.title`, values `global.value`, headers `global.head`, ring readings
# `global.big` and the temperature now `global.hero`. One numeral face, Nunito, for every number. Colour means a
# quantity: temperature orange, rain blue, wind teal, humidity violet, cloud grey; red only for an alert.
#
# Space: a 64 px margin at the sides, 64 px between panels, 24 px inside a panel.
#
# Render: render_dashboard.py OUT.png --levity docs/design-references/dashboards/pocket.levity
#           --scenario week-ahead --size 1170x2532 --freeze-time 2026-10-07T15:40:00
#
# Hex colours are quoted. Unquoted, YAML reads '#' as a comment.
theme:
  extends: default
  colors:
    background: '#050505'
    muted: '#b0b0b8'
    faint: '#80808a'
    rule: '#2c2c33'
    bad: '#ff3048'
    hue-temp: '#ff9124'
    hue-rain: '#2f95ff'
    hue-wind: '#14e3c0'
    hue-humid: '#b48cff'
    hue-cloud: '#a9b3c0'
  fonts:
    display: Nunito
    mono: Roboto Mono
    body: Roboto
vars:
  t: environment.temperature.temperature
  # the type scale
  label: 36px
  value: 40px
  head: 62px
  big: 84px
  hero: 230px
items:
- type: grid
  name: board
  geometry: {x: 5.47%, y: 4%, width: 89.06%, height: 93%}
  spacing: 0
  padding: 0
  grid:
    columns: [1fr]
    rows: [21fr, 11fr, 22fr, 18fr, 16fr]
    gap: 64px
    areas:
    - now
    - watch
    - hours
    - days
    - rings
  items:

  # ================= NOW ===================================================
  - type: group
    name: now
    grid: {area: now}
    items:
    - &head {type: text, text: Outside, alignment: Left, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 14%}}
    - type: realtime.text
      key: $t
      title: {visible: false}
      geometry: {x: 0%, y: 16%, width: 50%, height: 52%}
      display:
        precision: 0
        weight: Light
        format-hint: '00°'
        valueLabel: {alignment: Left, margins: 0px, color: $hue-temp, text-height: $hero, matchingGroup: {group: global.hero, matchAll: true}}
    # three readings beside the temperature: a name on the left, the value on the right
    - type: grid
      geometry: {x: 56%, y: 22%, width: 44%, height: 42%}
      spacing: 0
      grid: {columns: [1fr], rows: [1fr, 1fr, 1fr]}
      shared: &rows
        title: {color: $muted, alignment: Left, position: Left, size: 0.55, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
        display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
      items:
      - {type: realtime.text, key: environment.temperature.feelsLike, title: Feels, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}}
      - {type: realtime.text, key: environment.temperature.dewpoint, title: Dew pt, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}}
      - {type: realtime.text, key: environment.wind.speed.speed, title: Wind mph, display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}}
    # today's range: a bar from the low to the high with the pointer at now, the two ends named under it
    - type: realtime.bar
      key: $t
      title: {visible: false}
      geometry: {x: 0%, y: 74%, width: 100%, height: 8%}
      display:
        range: {min: 30, max: 90}
        track: {weight: 30%, color: $rule}
        fill: {from: environment.temperature.low, to: environment.temperature.high, gradient: TemperatureGradient}
        pointer: {type: triangle, color: $text, side: before}
        value-label: {visible: false}
    - type: grid
      geometry: {x: 0%, y: 86%, width: 100%, height: 14%}
      spacing: 0
      grid: {columns: [1fr, 1fr], rows: [1fr], gap: 64px}
      shared: *rows
      items:
      - {type: realtime.text, key: environment.temperature.low, title: Low today, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {column: 1}}
      - {type: realtime.text, key: environment.temperature.high, title: High today, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {column: 2}}

  # ================= THE STRIP =============================================
  # Three panels, ranked. The first whose `when:` holds shows; the one with no `when:` is the quiet fallback.
  # Each is a header that says what needs a look and a row of readings.
  - type: switch
    name: watch
    grid: {area: watch}
    hold: 8s
    fade: 0.4s
    items:
    - type: group
      name: frost
      when: 'at(environment.temperature.low, 5d) < 36°F'
      items:
      - {<<: *head, text: Frost on Monday night, color: $bad, geometry: {x: 0%, y: 0%, width: 100%, height: 28%}}
      - type: grid
        geometry: {x: 0%, y: 40%, width: 100%, height: 60%}
        spacing: 0
        grid: {columns: [1fr, 1fr, 1fr], rows: [1fr], gap: 64px}
        shared: &cells
          title: {color: $muted, position: Top, size: 0.45, alignment: BottomLeft, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
          display: {unitPosition: Hidden, valueLabel: {alignment: TopLeft, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
        items:
        - {type: realtime.text, key: 'at(environment.temperature.low, 4d)', title: Sun low, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}}
        - {type: realtime.text, key: 'at(environment.temperature.low, 5d)', title: Mon low, display: {precision: 0, format-hint: '00°', valueLabel: {color: $bad}}}
        - {type: realtime.text, key: 'at(environment.temperature.low, 6d)', title: Tue low, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}}
    - type: group
      name: rain
      when: 'at(environment.precipitation.probability, 36h) > 60%'
      items:
      - {<<: *head, text: Rain on Friday, color: $bad, geometry: {x: 0%, y: 0%, width: 100%, height: 28%}}
      - type: grid
        geometry: {x: 0%, y: 40%, width: 100%, height: 60%}
        spacing: 0
        grid: {columns: [1fr, 1fr, 1fr], rows: [1fr], gap: 64px}
        shared: *cells
        items:
        - {type: realtime.text, key: 'at(environment.precipitation.probability, 36h)', title: Chance, display: {precision: 0, format-hint: '00%', valueLabel: {color: $hue-rain}}}
        - {type: realtime.text, key: 'at(environment.precipitation.daily, 2d)', title: Fri in, display: {precision: 2, format-hint: '0.00', valueLabel: {color: $hue-rain}}}
        - {type: realtime.text, key: 'at(environment.precipitation.daily, 3d)', title: Sat in, display: {precision: 2, format-hint: '0.00', valueLabel: {color: $hue-rain}}}
    - type: group
      name: fine
      items:
      - {<<: *head, text: Fine tomorrow, geometry: {x: 0%, y: 0%, width: 100%, height: 28%}}
      - type: grid
        geometry: {x: 0%, y: 40%, width: 100%, height: 60%}
        spacing: 0
        grid: {columns: [1fr, 1fr, 1fr], rows: [1fr], gap: 64px}
        shared: *cells
        items:
        - {type: realtime.text, key: 'at(environment.temperature.high, 1d)', title: High, display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}}
        - {type: realtime.text, key: environment.light.uvi, title: UV index, display: {precision: 1, format-hint: '0.0'}}
        - {type: realtime.text, key: environment.clouds.cover.cover, title: Cloud, display: {precision: 0, format-hint: '00%', valueLabel: {color: $hue-cloud}}}

  # ================= THE NEXT FOUR HOURS ===================================
  # A table: the hours down the left, one column per quantity, each unit once at the head of its column.
  - type: grid
    name: hours
    grid: {area: hours}
    spacing: 0
    grid:
      columns: [1.2fr, 1fr, 1fr, 1fr, 1fr]
      rows: [1.3fr, 1fr, 1fr, 1fr, 1fr, 1fr]
      gap: [0, 24px]
    shared: &cell
      title: {visible: false}
      display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
    items:
    - {type: text, text: Next hours, alignment: Left, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, grid: {row: 1, column: 1, column-span: 5}}
    - &colhead {type: text, text: Temp, alignment: Right, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, grid: {row: 2, column: 2}}
    - {<<: *colhead, text: Feels, grid: {row: 2, column: 3}}
    - {<<: *colhead, text: Rain, grid: {row: 2, column: 4}}
    - {<<: *colhead, text: Gust mph, grid: {row: 2, column: 5}}
    - &rowhead {<<: *colhead, text: In 1 h, alignment: Left, grid: {row: 3, column: 1}}
    - {<<: *rowhead, text: In 2 h, grid: {row: 4, column: 1}}
    - {<<: *rowhead, text: In 3 h, grid: {row: 5, column: 1}}
    - {<<: *rowhead, text: In 4 h, grid: {row: 6, column: 1}}
    - {type: realtime.text, key: 'at($t, 1h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 3, column: 2}}
    - {type: realtime.text, key: 'at($t, 2h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 4, column: 2}}
    - {type: realtime.text, key: 'at($t, 3h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 5, column: 2}}
    - {type: realtime.text, key: 'at($t, 4h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 6, column: 2}}
    - {type: realtime.text, key: 'at(environment.temperature.feelsLike, 1h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 3, column: 3}}
    - {type: realtime.text, key: 'at(environment.temperature.feelsLike, 2h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 4, column: 3}}
    - {type: realtime.text, key: 'at(environment.temperature.feelsLike, 3h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 5, column: 3}}
    - {type: realtime.text, key: 'at(environment.temperature.feelsLike, 4h)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 6, column: 3}}
    - {type: realtime.text, key: 'at(environment.precipitation.probability, 1h)', display: {precision: 0, format-hint: '00%', valueLabel: {color: $hue-rain}}, grid: {row: 3, column: 4}}
    - {type: realtime.text, key: 'at(environment.precipitation.probability, 2h)', display: {precision: 0, format-hint: '00%', valueLabel: {color: $hue-rain}}, grid: {row: 4, column: 4}}
    - {type: realtime.text, key: 'at(environment.precipitation.probability, 3h)', display: {precision: 0, format-hint: '00%', valueLabel: {color: $hue-rain}}, grid: {row: 5, column: 4}}
    - {type: realtime.text, key: 'at(environment.precipitation.probability, 4h)', display: {precision: 0, format-hint: '00%', valueLabel: {color: $hue-rain}}, grid: {row: 6, column: 4}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gust, 1h)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 3, column: 5}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gust, 2h)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 4, column: 5}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gust, 3h)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 5, column: 5}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gust, 4h)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 6, column: 5}}

  # ================= THE NEXT THREE DAYS ====================================
  - type: grid
    name: days
    grid: {area: days}
    spacing: 0
    grid:
      columns: [1.2fr, 1fr, 1fr, 1fr, 1fr]
      rows: [1.3fr, 1fr, 1fr, 1fr, 1fr]
      gap: [0, 24px]
    shared: *cell
    items:
    - {type: text, text: Next days, alignment: Left, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, grid: {row: 1, column: 1, column-span: 5}}
    - {<<: *colhead, text: High, grid: {row: 2, column: 2}}
    - {<<: *colhead, text: Low, grid: {row: 2, column: 3}}
    - {<<: *colhead, text: Rain in, grid: {row: 2, column: 4}}
    - {<<: *colhead, text: Gust mph, grid: {row: 2, column: 5}}
    - {<<: *rowhead, text: Thursday, grid: {row: 3, column: 1}}
    - {<<: *rowhead, text: Friday, grid: {row: 4, column: 1}}
    - {<<: *rowhead, text: Saturday, grid: {row: 5, column: 1}}
    - {type: realtime.text, key: 'at(environment.temperature.high, 1d)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 3, column: 2}}
    - {type: realtime.text, key: 'at(environment.temperature.high, 2d)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 4, column: 2}}
    - {type: realtime.text, key: 'at(environment.temperature.high, 3d)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 5, column: 2}}
    - {type: realtime.text, key: 'at(environment.temperature.low, 1d)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 3, column: 3}}
    - {type: realtime.text, key: 'at(environment.temperature.low, 2d)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 4, column: 3}}
    - {type: realtime.text, key: 'at(environment.temperature.low, 3d)', display: {precision: 0, format-hint: '00°', valueLabel: {color: $hue-temp}}, grid: {row: 5, column: 3}}
    - {type: realtime.text, key: 'at(environment.precipitation.daily, 1d)', display: {precision: 2, format-hint: '0.00', valueLabel: {color: $hue-rain}}, grid: {row: 3, column: 4}}
    - {type: realtime.text, key: 'at(environment.precipitation.daily, 2d)', display: {precision: 2, format-hint: '0.00', valueLabel: {color: $hue-rain}}, grid: {row: 4, column: 4}}
    - {type: realtime.text, key: 'at(environment.precipitation.daily, 3d)', display: {precision: 2, format-hint: '0.00', valueLabel: {color: $hue-rain}}, grid: {row: 5, column: 4}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gustMax, 1d)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 3, column: 5}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gustMax, 2d)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 4, column: 5}}
    - {type: realtime.text, key: 'at(environment.wind.speed.gustMax, 3d)', display: {precision: 0, format-hint: '00', valueLabel: {color: $hue-wind}}, grid: {row: 5, column: 5}}

  # ================= THREE RINGS ===========================================
  # Each ring: the gauge, its reading in the middle (global.big) and a label under it (global.title).
  - type: grid
    name: rings
    grid: {area: rings}
    spacing: 0
    grid: {columns: [1fr, 1fr, 1fr], rows: [1fr], gap: 64px}
    items:
    - type: group
      items:
      - &arc
        type: realtime.gauge
        key: environment.clouds.cover.cover
        title: {visible: false}
        geometry: {x: 0%, y: 0%, width: 100%, height: 100%}
        display: &arcdisplay
          radius: 96%
          arc: {start-angle: -135, end-angle: 135, weight: 7%, color: $rule}
          range: {min: 0, max: 100}
          fill: {weight: 7%, color: $hue-cloud}
          major: {enabled: false}
          minor: {enabled: false}
          micro: {enabled: false}
          needle: {visible: false}
          value-label: {visible: false}
          unit-label: {visible: false}
      - &ringvalue
        type: realtime.text
        key: environment.clouds.cover.cover
        title: {visible: false}
        geometry: {x: 13%, y: 34%, width: 74%, height: 26%}
        display: {precision: 0, unitPosition: Hidden, weight: Light, format-hint: '000%', valueLabel: {alignment: Center, margins: 0px, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
      - &ringlabel {type: text, text: Cloud, alignment: Center, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 10%, y: 85%, width: 80%, height: 12%}}
    - type: group
      items:
      - {<<: *arc, key: environment.precipitation.probability, display: {<<: *arcdisplay, fill: {weight: 7%, color: $hue-rain}}}
      - {<<: *ringvalue, key: environment.precipitation.probability}
      - {<<: *ringlabel, text: Rain chance}
    - type: group
      items:
      - {<<: *arc, key: environment.humidity.humidity, display: {<<: *arcdisplay, fill: {weight: 7%, color: $hue-humid}}}
      - {<<: *ringvalue, key: environment.humidity.humidity}
      - {<<: *ringlabel, text: Humidity}
