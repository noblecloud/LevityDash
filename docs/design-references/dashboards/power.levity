# Power: where the house's electricity goes. A 15in 16:10 screen, written for a weekday evening with solar and an EV.
#
# Not weather: every key is a power in kW or an energy in kWh (`home.power.*`, `home.energy.*`; on a real install these
# come from a plugin or a smart meter). The numbers that are made on the dashboard use units algebra: the draw times
# a span of time is an energy (`home.power.total * 1h`), an energy over a span is a power (`home.energy.today / 19h`),
# and `to(x, kWh)` says which unit the answer is shown in, since an algebra result is SI (J, W) until told otherwise.
# `units.levity` is the weather-side tour of the same algebra; this one is a working board.
#
# Top left is the draw now with the three questions it begs: what is this hour at this draw, what is a day of it, what
# was the average so far. Beside it is the day as a graph of draw, solar and the heat pump on one scale. The row of
# rings is the circuits against a 3 kW scale. The right column is a switch whose items turn on by `when:` with unit
# literals (`> 4 kW`), so a heavy evening or a car on charge takes the slot. The floor is today's energy: used,
# yesterday, made, and bought (used minus made).
#
# Type: each text role is one dashboard-wide size group with `matchAll`, pinned with `text-height`. The `vars:` below
# are the whole scale: labels (`global.title`), values (`global.value`), headers and the ring readings
# (`global.head`), the big figures (`global.big`) and the draw now (`global.hero`). Units are said once, in a label or
# a header, never after each number. Each source keeps one colour (draw, solar, heat pump, car, kitchen) and the
# headers and labels stay text and muted.
#
# Space: a 96 px margin, 96 px between columns and 64 px between rows.
#
# Render: render_dashboard.py OUT.png --levity docs/design-references/dashboards/power.levity
#           --scenario energy-day --size 2880x1800 --freeze-time 2026-10-15T19:30:00
#
# Hex colours are quoted. Unquoted, YAML reads '#' as a comment.
theme:
  extends: default
  colors:
    background: '#07090c'
    muted: '#aab2bd'
    faint: '#7c8591'
    rule: '#262c35'
    accent: '#ffb347'
    good: '#14e3c0'
    warn: '#ffd400'
    bad: '#ff3048'
    info: '#3da5ff'
    solar: '#ffd400'
    draw: '#ff6a3d'
  fonts:
    display: Nunito
    mono: Roboto Mono
    body: Roboto
vars:
  pw: home.power.total
  pv: home.power.solar
  used: home.energy.today
  made: home.energy.solar
  # the type scale: label, value, header, the big figures, and the draw now
  label: 32px
  value: 32px
  head: 56px
  big: 110px
  hero: 150px
items:
- type: grid
  name: board
  geometry: {x: 3.333%, y: 5.333%, width: 93.333%, height: 89.333%}
  spacing: 0
  padding: 0
  grid:
    columns: [1fr, 1fr, 1fr, 1fr]
    rows: [42fr, 26fr, 32fr]
    gap: [64px, 96px]
    areas:
    - now graph graph slot
    - rings rings rings slot
    - used yest made bought
  items:

  # ================= THE DRAW NOW ==========================================
  - type: group
    name: now
    grid: {area: now}
    items:
    - {type: text, text: House draw, alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 10%}}
    - {type: text, text: Kilowatts now, alignment: TopLeft, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 0%, y: 12%, width: 100%, height: 6%}}
    - type: realtime.text
      key: '$pw'
      title: {visible: false}
      geometry: {x: 0%, y: 20%, width: 100%, height: 30%}
      display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '0.0', valueLabel: {alignment: Left, margins: 0px, color: $draw, text-height: $hero, matchingGroup: {group: global.hero, matchAll: true}}}
    - type: grid
      geometry: {x: 0%, y: 58%, width: 100%, height: 42%}
      spacing: 0
      grid: {columns: [1fr], rows: [1fr, 1fr, 1fr]}
      shared:
        title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
        display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
      items:
      - {type: realtime.text, key: 'to($pw * 1h, kWh)', title: 'This hour, kWh', display: {precision: 1, format-hint: '00.0'}}
      - {type: realtime.text, key: 'to($pw * 24h, kWh)', title: 'A day of it, kWh', display: {precision: 0, format-hint: '000', valueLabel: {color: $bad}}}
      - {type: realtime.text, key: 'to($used / 19h, kW)', title: 'Average so far, kW', display: {precision: 2, format-hint: '0.00', valueLabel: {color: $good}}}

  # ================= THE DAY ===============================================
  # Draw, solar and the heat pump on one kW scale, in the colours they have everywhere else on the board.
  - type: group
    name: day
    grid: {area: graph}
    items:
    - {type: text, text: The day, alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 10%}}
    - {type: text, text: 'Draw, solar and heat pump, kW', alignment: TopLeft, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 0%, y: 12%, width: 100%, height: 6%}}
    - type: graph
      geometry: {x: 0%, y: 22%, width: 100%, height: 78%}
      timeframe: {days: 1}
      annotations:
        dayLabels: {enabled: false}
        hourLabels: {alignment: BottomCenter, spacingIntervals: '3, 6, 12'}
        lines: {spacing: 10 mm, weight: 0.4}
      figures:
      - figure: power
        margins: {top: 6%, bottom: 14%}
        min: 0
        max: 5
        home.power.total:
          plot: {type: plot, color: '#ff6a3d', weight: 1.0}
          resolution: 2
        home.power.solar:
          plot: {type: plot, color: '#ffd400', weight: 0.7}
          resolution: 2
        home.power.hvac:
          plot: {type: plot, color: '#3da5ff', weight: 0.4, dashPattern: '4, 4'}
          resolution: 2

  # ================= THE CIRCUITS ==========================================
  # Each ring is a circuit against a 3 kW scale (solar against 4 kW), its reading at the header size.
  - type: group
    name: rings
    grid: {area: rings}
    items:
    - {type: text, text: Circuits, alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 16%}}
    - {type: text, text: 'Kilowatts, against 3 kW', alignment: TopLeft, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 0%, y: 19%, width: 100%, height: 9%}}
    - type: stack
      geometry: {x: 0%, y: 32%, width: 100%, height: 68%}
      direction: Horizontal
      spacing: 48px
      items:
      - type: group
        items:
        - type: realtime.gauge
          key: home.power.hvac
          title: {visible: false}
          geometry: {x: 0%, y: 0%, width: 100%, height: 100%}
          display:
            radius: 96%
            arc: {start-angle: -120, end-angle: 120, weight: 7%, color: $rule}
            range: {min: 0, max: 3}
            fill: {weight: 7%, color: $info}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            value-label: {visible: false}
            unit-label: {visible: false}
        - type: realtime.text
          key: home.power.hvac
          title: {visible: false}
          geometry: {x: 13%, y: 34%, width: 74%, height: 30%}
          display: {precision: 1, unitPosition: Hidden, format-hint: '0.0', valueLabel: {alignment: Center, margins: 0px, color: $info, text-height: $head, matchingGroup: {group: global.head, matchAll: true}}}
        - {type: text, text: Heat pump, alignment: Center, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 5%, y: 82%, width: 90%, height: 14%}}
      - type: group
        items:
        - type: realtime.gauge
          key: home.power.ev
          title: {visible: false}
          geometry: {x: 0%, y: 0%, width: 100%, height: 100%}
          display:
            radius: 96%
            arc: {start-angle: -120, end-angle: 120, weight: 7%, color: $rule}
            range: {min: 0, max: 3}
            fill: {weight: 7%, color: $good}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            value-label: {visible: false}
            unit-label: {visible: false}
        - type: realtime.text
          key: home.power.ev
          title: {visible: false}
          geometry: {x: 13%, y: 34%, width: 74%, height: 30%}
          display: {precision: 1, unitPosition: Hidden, format-hint: '0.0', valueLabel: {alignment: Center, margins: 0px, color: $good, text-height: $head, matchingGroup: {group: global.head, matchAll: true}}}
        - {type: text, text: Car, alignment: Center, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 5%, y: 82%, width: 90%, height: 14%}}
      - type: group
        items:
        - type: realtime.gauge
          key: home.power.kitchen
          title: {visible: false}
          geometry: {x: 0%, y: 0%, width: 100%, height: 100%}
          display:
            radius: 96%
            arc: {start-angle: -120, end-angle: 120, weight: 7%, color: $rule}
            range: {min: 0, max: 3}
            fill: {weight: 7%, color: $accent}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            value-label: {visible: false}
            unit-label: {visible: false}
        - type: realtime.text
          key: home.power.kitchen
          title: {visible: false}
          geometry: {x: 13%, y: 34%, width: 74%, height: 30%}
          display: {precision: 1, unitPosition: Hidden, format-hint: '0.0', valueLabel: {alignment: Center, margins: 0px, color: $accent, text-height: $head, matchingGroup: {group: global.head, matchAll: true}}}
        - {type: text, text: Kitchen, alignment: Center, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 5%, y: 82%, width: 90%, height: 14%}}
      - type: group
        items:
        - type: realtime.gauge
          key: home.power.water
          title: {visible: false}
          geometry: {x: 0%, y: 0%, width: 100%, height: 100%}
          display:
            radius: 96%
            arc: {start-angle: -120, end-angle: 120, weight: 7%, color: $rule}
            range: {min: 0, max: 3}
            fill: {weight: 7%, color: $draw}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            value-label: {visible: false}
            unit-label: {visible: false}
        - type: realtime.text
          key: home.power.water
          title: {visible: false}
          geometry: {x: 13%, y: 34%, width: 74%, height: 30%}
          display: {precision: 1, unitPosition: Hidden, format-hint: '0.0', valueLabel: {alignment: Center, margins: 0px, color: $draw, text-height: $head, matchingGroup: {group: global.head, matchAll: true}}}
        - {type: text, text: Water heater, alignment: Center, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 5%, y: 82%, width: 90%, height: 14%}}
      - type: group
        items:
        - type: realtime.gauge
          key: home.power.solar
          title: {visible: false}
          geometry: {x: 0%, y: 0%, width: 100%, height: 100%}
          display:
            radius: 96%
            arc: {start-angle: -120, end-angle: 120, weight: 7%, color: $rule}
            range: {min: 0, max: 4}
            fill: {weight: 7%, color: $solar}
            major: {enabled: false}
            minor: {enabled: false}
            micro: {enabled: false}
            needle: {visible: false}
            value-label: {visible: false}
            unit-label: {visible: false}
        - type: realtime.text
          key: home.power.solar
          title: {visible: false}
          geometry: {x: 13%, y: 34%, width: 74%, height: 30%}
          display: {precision: 1, unitPosition: Hidden, format-hint: '0.0', valueLabel: {alignment: Center, margins: 0px, color: $solar, text-height: $head, matchingGroup: {group: global.head, matchAll: true}}}
        - {type: text, text: Solar, alignment: Center, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 5%, y: 82%, width: 90%, height: 14%}}

  # ================= THE SLOT ==============================================
  # A switch. A notice with `when:` joins the rotation while its unit-literal test holds; the last is always there.
  - type: switch
    name: slot
    grid: {area: slot}
    cycle: 10s
    fade: 0.4s
    hold: 10s
    items:
    - type: group
      name: heavy
      when: '$pw > 4 kW'
      items:
      - {type: text, text: Heavy draw, color: $bad, alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 6%}}
      - {type: text, text: 'Over the 4 kW line, kW', alignment: TopLeft, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 0%, y: 7.5%, width: 100%, height: 3.5%}}
      - type: realtime.text
        key: '$pw - 4 kW'
        title: {visible: false}
        geometry: {x: 0%, y: 13%, width: 100%, height: 15%}
        display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $bad, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
      - type: grid
        geometry: {x: 0%, y: 34%, width: 100%, height: 24%}
        spacing: 0
        grid: {columns: [1fr], rows: [1fr, 1fr, 1fr]}
        shared:
          title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
          display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
        items:
        - {type: realtime.text, key: '$pv', title: 'Solar now, kW', display: {precision: 1, format-hint: '0.0', valueLabel: {color: $solar}}}
        - {type: realtime.text, key: '$pw - $pv', title: 'From the grid, kW', display: {precision: 1, format-hint: '0.0'}}
        - {type: realtime.text, key: 'max($pw, 24h)', title: 'Peak today, kW', display: {precision: 1, format-hint: '0.0', valueLabel: {color: $draw}}}
    - type: group
      name: charging
      when: 'home.power.ev > 1 kW'
      items:
      - {type: text, text: Car charging, alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 6%}}
      - {type: text, text: 'Added in 4 h at this rate, kWh', alignment: TopLeft, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 0%, y: 7.5%, width: 100%, height: 3.5%}}
      - type: realtime.text
        key: 'to(home.power.ev * 4h, kWh)'
        title: {visible: false}
        geometry: {x: 0%, y: 13%, width: 100%, height: 15%}
        display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $good, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
      - type: grid
        geometry: {x: 0%, y: 34%, width: 100%, height: 16%}
        spacing: 0
        grid: {columns: [1fr], rows: [1fr, 1fr]}
        shared:
          title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
          display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
        items:
        - {type: realtime.text, key: 'home.power.ev', title: 'Charger, kW', display: {precision: 1, format-hint: '0.0', valueLabel: {color: $good}}}
        - {type: realtime.text, key: 'to(home.power.ev * 1h, kWh)', title: 'Each hour, kWh', display: {precision: 1, format-hint: '0.0', valueLabel: {color: $good}}}
    - type: group
      name: quiet
      items:
      - {type: text, text: Baseline, alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 6%}}
      - {type: text, text: 'A night at this draw, kWh', alignment: TopLeft, font: Roboto, weight: Light, color: $muted, text-height: $label, matchingGroup: {group: global.title, matchAll: true}, geometry: {x: 0%, y: 7.5%, width: 100%, height: 3.5%}}
      - type: realtime.text
        key: 'to(home.power.total * 8h, kWh)'
        title: {visible: false}
        geometry: {x: 0%, y: 13%, width: 100%, height: 15%}
        display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $draw, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
      - type: grid
        geometry: {x: 0%, y: 34%, width: 100%, height: 8%}
        spacing: 0
        grid: {columns: [1fr], rows: [1fr]}
        shared:
          title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
          display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
        items:
        - {type: realtime.text, key: 'home.power.total', title: 'Now, kW', display: {precision: 1, format-hint: '0.0', valueLabel: {color: $draw}}}

  # ================= TODAY'S ENERGY ========================================
  # Four columns on one pattern: a header with the unit, the figure, and one row under it.
  - type: group
    name: used
    grid: {area: used}
    items:
    - {type: text, text: 'Used today, kWh', alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 18%}}
    - type: realtime.text
      key: '$used'
      title: {visible: false}
      geometry: {x: 0%, y: 22%, width: 100%, height: 46%}
      display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $draw, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
    - type: grid
      geometry: {x: 0%, y: 78%, width: 100%, height: 22%}
      spacing: 0
      grid: {columns: [1fr], rows: [1fr]}
      shared:
        title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
        display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
      items:
      - {type: realtime.text, key: 'to($used / 19h, kW)', title: 'Average, kW', display: {precision: 2, format-hint: '0.00'}}
  - type: group
    name: yest
    grid: {area: yest}
    items:
    - {type: text, text: 'Yesterday, kWh', alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 18%}}
    - type: realtime.text
      key: 'home.energy.yesterday'
      title: {visible: false}
      geometry: {x: 0%, y: 22%, width: 100%, height: 46%}
      display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $muted, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
    - type: grid
      geometry: {x: 0%, y: 78%, width: 100%, height: 22%}
      spacing: 0
      grid: {columns: [1fr], rows: [1fr]}
      shared:
        title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
        display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
      items:
      - {type: realtime.text, key: '$used - home.energy.yesterday', title: 'Today so far, kWh', display: {precision: 1, format-hint: '-00.0', valueLabel: {color: $good}}}
  - type: group
    name: made
    grid: {area: made}
    items:
    - {type: text, text: 'Solar today, kWh', alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 18%}}
    - type: realtime.text
      key: '$made'
      title: {visible: false}
      geometry: {x: 0%, y: 22%, width: 100%, height: 46%}
      display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $solar, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
    - type: grid
      geometry: {x: 0%, y: 78%, width: 100%, height: 22%}
      spacing: 0
      grid: {columns: [1fr], rows: [1fr]}
      shared:
        title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
        display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
      items:
      - {type: realtime.text, key: '$pv', title: 'Now, kW', display: {precision: 1, format-hint: '0.0', valueLabel: {color: $solar}}}
  - type: group
    name: bought
    grid: {area: bought}
    items:
    - {type: text, text: 'From the grid, kWh', alignment: BottomLeft, weight: SemiBold, text-height: $head, matchingGroup: {group: global.head, matchAll: true}, geometry: {x: 0%, y: 0%, width: 100%, height: 18%}}
    - type: realtime.text
      key: '$used - $made'
      title: {visible: false}
      geometry: {x: 0%, y: 22%, width: 100%, height: 46%}
      display: {precision: 1, weight: Light, unitPosition: Hidden, format-hint: '00.0', valueLabel: {alignment: Left, margins: 0px, color: $text, text-height: $big, matchingGroup: {group: global.big, matchAll: true}}}
    - type: grid
      geometry: {x: 0%, y: 78%, width: 100%, height: 22%}
      spacing: 0
      grid: {columns: [1fr], rows: [1fr]}
      shared:
        title: {color: $muted, alignment: Left, position: Left, size: 0.62, margins: 0px, text-height: $label, matchingGroup: {group: global.title, matchAll: true}}
        display: {unitPosition: Hidden, valueLabel: {alignment: Right, margins: 0px, text-height: $value, matchingGroup: {group: global.value, matchAll: true}}}
      items:
      - {type: realtime.text, key: 'to(($used - $made) / 19h, kW)', title: 'Average, kW', display: {precision: 2, format-hint: '0.00'}}
