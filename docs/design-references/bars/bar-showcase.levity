# Every bar style on one board: progress, battery, segmented, gradient, zones, markers and a pointer, a
# thermometer, and the same bars standing up. Design size 2880x1800; every size is a share of its card.
#
#   render_dashboard.py out.png --levity docs/design-references/bars/bar-showcase.levity \
#       --scenario bar-cards --size 2880x1800
theme: dusk
items:
  - type: group
    name: board
    items:
      - type: text
        name: heading
        text: Bars
        font: $display
        color: $muted
        geometry: {x: 3%, y: 3%, width: 20%, height: 6%}

      # -- lying down --------------------------------------------------------------------------------
      # Each bar is a `readout-bar` preset use: the properties are the key, caption, scale and track
      # weight; the rest of what a bar does is a field of the use, merged over the template.
      - type: group
        name: lying
        geometry: {x: 3%, y: 11%, width: 60%, height: 86%}
        items:
          - preset: readout-bar
            name: charge
            geometry: {x: 0%, y: 0%, width: 100%, height: 10%}
            props: {key: system.battery.charge, caption: Charge}
            display:
              fill: {color: zone}
              zones:
                - {to: 20, color: $bad, opacity: 0}
                - {from: 20, to: 50, color: $warn, opacity: 0}
                - {from: 50, color: $good, opacity: 0}
          - preset: readout-bar
            name: cell
            geometry: {x: 0%, y: 13%, width: 100%, height: 11%}
            props: {key: system.battery.low}
            display:
              style: battery
              fill: {color: zone}
              zones:
                - {to: 20, color: $bad, opacity: 0}
                - {from: 20, to: 50, color: $warn, opacity: 0}
                - {from: 50, color: $good, opacity: 0}
          - preset: readout-bar
            name: disk
            geometry: {x: 0%, y: 27%, width: 100%, height: 10%}
            props: {key: system.disk.used, caption: Disk, weight: 40%}
            display:
              track: {cap: flat}
              fill: {color: zone, segments: 20, gap: 4%}
              zones:
                - {to: 60, color: $good, opacity: 0}
                - {from: 60, to: 85, color: $warn, opacity: 0}
                - {from: 85, color: $bad, opacity: 0}
          - preset: readout-bar
            name: humidity
            geometry: {x: 0%, y: 40%, width: 100%, height: 12%}
            props: {caption: Humidity, weight: 22%}
            display:
              fill: {gradient: $load}
              major: {interval: 25, side: after, labels: true}
          - preset: readout-bar
            name: wind
            geometry: {x: 0%, y: 55%, width: 100%, height: 12%}
            props: {key: environment.wind.speed.speed, max: 20, caption: Wind and gusts, weight: 22%}
            display:
              fill: {color: $series-2}
              markers:
                - {value: environment.wind.speed.gust, type: triangle, color: $warn, side: before}
              major: {interval: 5, side: after, labels: true}
              unit-label: {visible: true}
          - preset: readout-bar
            name: uv
            geometry: {x: 0%, y: 70%, width: 100%, height: 12%}
            props: {key: environment.light.uvi, max: 12, caption: UV index, weight: 30%}
            display:
              track: {cap: flat}
              zones:
                - {from: 0, to: 3, color: $good}
                - {from: 3, to: 6, color: $warn}
                - {from: 6, to: 8, color: $accent}
                - {from: 8, to: 12, color: $bad}
              pointer: {type: dot, color: $text, size: 40%}
              major: {interval: 2, side: after, labels: true}
          - preset: readout-bar
            name: day
            geometry: {x: 0%, y: 85%, width: 100%, height: 14%}
            props: {key: environment.temperature.temperature, min: 60, max: 110, caption: Today, weight: 20%}
            display:
              fill:
                from: min(environment.temperature.temperature, today)
                to: max(environment.temperature.temperature, today)
                color: $accent
                opacity: 0.6
              pointer: {type: triangle, color: $text}
              major: {interval: 10, side: after, labels: true}
              minor: {count: 5, side: after}
              markers:
                - value: min(environment.temperature.temperature, today)
                  type: line
                  color: $info
                - value: max(environment.temperature.temperature, today)
                  type: line
                  color: $bad

      # -- standing up -------------------------------------------------------------------------------
      - type: group
        name: standing
        geometry: {x: 67%, y: 11%, width: 30%, height: 86%}
        items:
          - type: realtime.bar
            name: thermometer
            key: environment.temperature.temperature
            title: false
            geometry: {x: 0%, y: 0%, width: 34%, height: 100%}
            display:
              style: thermometer
              range: {min: 60, max: 110}
              fill: {gradient: $temperature}
              major: {interval: 10, side: after, labels: true}
              value-label: {position: inside, format: {precision: 0}, size: 14%}
          - preset: readout-bar
            name: humidity-tall
            geometry: {x: 40%, y: 0%, width: 18%, height: 100%}
            props: {caption: RH, weight: 40%}
            display:
              orientation: vertical
              fill: {gradient: $load}
          - preset: readout-bar
            name: charge-tall
            geometry: {x: 61%, y: 0%, width: 18%, height: 100%}
            props: {key: system.battery.charge, caption: Charge, weight: 40%}
            display:
              orientation: vertical
              track: {cap: flat}
              fill: {color: zone, segments: 10, gap: 3%}
              zones:
                - {to: 20, color: $bad, opacity: 0}
                - {from: 20, to: 50, color: $warn, opacity: 0}
                - {from: 50, color: $good, opacity: 0}
          - preset: readout-bar
            name: uv-tall
            geometry: {x: 82%, y: 0%, width: 18%, height: 100%}
            props: {key: environment.light.uvi, max: 12, caption: UV, weight: 40%}
            display:
              orientation: vertical
              track: {cap: flat}
              zones:
                - {from: 0, to: 3, color: $good}
                - {from: 3, to: 6, color: $warn}
                - {from: 6, to: 8, color: $accent}
                - {from: 8, to: 12, color: $bad}
              pointer: {type: triangle, color: $text, side: after}
