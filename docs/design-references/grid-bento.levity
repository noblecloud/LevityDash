# Bento packing with the grid engine: dense auto-placement, item spans, and `shrink`.
# An explicit 4 x 3 grid. Items without a `column` or `row` fill the first hole (`dense: true`).
# `shrink: true` lets a wide item give up columns when no full-width hole is left in the three rows.
# The strip at the bottom uses `repeat(auto-fill, ...)`, so its column count follows the width.
# Render: render_dashboard.py OUT.png --levity THIS --scenario hot-clear-day --size 2880x1800
# Titles are written `title: {text: ...}`, not `title: text`: a bare string replaces the whole `shared: title:`
# mapping and drops its matchingGroup, so the titles would size on their own boxes.
- type: group
  name: main
  items:
    - type: grid
      name: bento
      geometry: {x: 2%, y: 2%, width: 96%, height: 66%}
      spacing: 14px
      grid: {columns: [1fr, 1fr, 1fr, 1fr], rows: [1fr, 1fr, 1fr], dense: true}
      shared:
        title: {matchingGroup: {group: bentoTitle@bento, matchAll: true}}
        display: {valueLabel: {matchingGroup: {group: bentoValue@bento, matchAll: true}}}
      items:
        - {type: realtime.text, key: environment.temperature.temperature, title: {text: Temperature}, grid: {column-span: 2, row-span: 2}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.humidity.humidity, title: {text: Humidity}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.pressure.pressure, title: {text: Pressure}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.precipitation.precipitation, title: {text: Rain}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.light.uvi, title: {text: UV}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.wind.speed.speed, title: {text: Wind}, grid: {column-span: 3}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.wind.gust.gust, title: {text: Gust}, grid: {column-span: 3, shrink: true}, border: {enabled: true, edges: all}}

    - type: grid
      name: strip
      geometry: {x: 2%, y: 72%, width: 96%, height: 24%}
      spacing: 12px
      grid: {columns: 'repeat(auto-fill, minmax(200px, 1fr))', rows: [1fr]}
      shared:
        title: {matchingGroup: {group: stripTitle@strip, matchAll: true}}
        display: {valueLabel: {matchingGroup: {group: stripValue@strip, matchAll: true}}}
      items:
        - {type: realtime.text, key: environment.temperature.dewpoint, title: {text: Dewpoint}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.wind.direction.direction, title: {text: Direction}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.light.uvi, title: {text: UV index}, border: {enabled: true, edges: all}}
        - {type: realtime.text, key: environment.precipitation.precipitation, title: {text: Precip}, border: {enabled: true, edges: all}}
