# Bars in a graph: `plot: {type: bar}`.
#
# Precipitation amount as bars with the chance of rain as a line over them, and
# the temperature line above both. Bars are drawn per source sample (an hour
# here), rise from `base` (default 0), and take the plot's gradient as value
# against height. Layer a line over bars by giving each its own figure with the
# same margins; figures keep their own axis.
#
# Hex colours are quoted. Unquoted, YAML reads '#' as a comment.
- type: graph
  name: forecast
  timeframe: {days: 1, hours: 12}
  annotations:
    dayLabels: {alignment: TopCenter}
    hourLabels: {alignment: BottomCenter, spacingIntervals: '1, 3, 6'}
    lines: {spacing: 8 mm, weight: 0.8}
  figures:
  - figure: temperature
    margins: {bottom: 42%, top: 8%}
    environment.temperature.temperature:
      labels: {enabled: true}
      plot: {type: plot, gradient: TemperatureGradient}
      resolution: 2
  - figure: precipitation
    margins: {bottom: 0%, top: 62%}
    max: 0.5
    environment.precipitation.precipitation:
      plot: {type: bar, gradient: PrecipitationRateGradient, width: 0.8, radius: 0.25}
  - figure: humidity
    margins: {bottom: 0%, top: 62%}
    min: 0
    max: 1
    environment.humidity.humidity:
      plot: {type: plot, color: '#5882ff', weight: 0.3, dashPattern: '5, 5'}
