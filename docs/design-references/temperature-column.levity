# Temperature column: each row is [ring][name][value].
#
# Intent: make the *list* scannable. Every ring shares one 50-110F range, so
# needle position is comparable down the column - you can see at a glance that
# the terrarium sits high and the dew point sits low, without reading a digit.
#
# Column-major, not row-major: `shared:` applies flatly to every direct child
# of a stack, with no per-type dispatch - so a row mixing [gauge, text,
# realtime.text] can't give `shared` to "just the gauge". Three parallel
# column-stacks (gauges | titles | values) each hold same-typed children, so
# one `shared:` per column covers all five rows and each line item is just its
# `key:` or `text:`. Outer `spacing: 0` keeps the columns adjoining, so each
# column's own divider lines land at the same y as its neighbours' and read as
# one continuous rule rather than three broken segments.
- type: stack
  name: temperatures
  direction: Horizontal
  spacing: 0px
  geometry: {fillParent: true}
  items:

    - type: stack
      name: gauges
      direction: Vertical
      spacing: 6px
      dividers: {enabled: true, opacity: 0.15, size: 0.9}
      shared:
        title: false
        display:
          radius: 88%
          arc: {gradient: TemperatureGradient, weight: 22%, cap: FlatCap}
          needle: {width: 9%, length: 78%}
          major: {enabled: false, labels: {enabled: false}}
          minor: {enabled: false}
          micro: {enabled: false}
          value-label: {visible: false}
          unit-label: {visible: false}
          range: {min: 50, max: 110}
      geometry: {x: 0%, y: 0%, width: 10%, height: 100%}
      items:
        - type: realtime.gauge
          key: environment.temperature.temperature
        - type: realtime.gauge
          key: environment.temperature.feelsLike
        - type: realtime.gauge
          key: environment.temperature.dewpoint
        - type: realtime.gauge
          key: indoor.temperature.temperature#bedroom
        - type: realtime.gauge
          key: indoor.temperature.temperature#terrarium

    - type: stack
      name: titles
      direction: Vertical
      spacing: 6px
      dividers: {enabled: true, opacity: 0.15, size: 0.9}
      shared:
        alignment: CenterLeft
        display: {font: Nunito, text-height: 46%}
      geometry: {x: 10%, y: 0%, width: 54%, height: 100%}
      items:
        - type: text
          text: Outdoor
        - type: text
          text: Feels Like
        - type: text
          text: Dew Point
        - type: text
          text: Bedroom
        - type: text
          text: Terrarium

    - type: stack
      name: values
      direction: Vertical
      spacing: 6px
      dividers: {enabled: true, opacity: 0.15, size: 0.9}
      shared:
        title: false
        display:
          font: Roboto Mono
          unitPosition: Hidden
          valueLabel: {matchingGroup: value@temps}
      geometry: {x: 64%, y: 0%, width: 36%, height: 100%}
      items:
        - type: realtime.text
          key: environment.temperature.temperature
        - type: realtime.text
          key: environment.temperature.feelsLike
        - type: realtime.text
          key: environment.temperature.dewpoint
        - type: realtime.text
          key: indoor.temperature.temperature#bedroom
        - type: realtime.text
          key: indoor.temperature.temperature#terrarium
