# Cards that follow the theme: a tinted surface, two corner radii (a tile that holds cards, a card inside it) and the accent as ink.
# The radii, `$surface` and `$accent-text` come from the theme, so `default` draws square black cards and `neon` draws
# rounded indigo ones. Render it under each theme to compare:
#   render_dashboard.py OUT.png --levity docs/design-references/themed-cards.levity --scenario hot-clear-day --size 2880x1800 --theme neon
theme: neon
background: $sky
items:
  - type: group
    name: main
    items:
      - type: grid
        name: tile
        geometry: {x: 2%, y: 3%, width: 96%, height: 94%}
        spacing: $space_3
        padding: $space_3
        border: {enabled: true, edges: all, radius: $radius_tile, fill: $sunk, weight: 0}
        grid: {columns: [1fr, 1fr, 1fr, 1fr], rows: [1fr, 1fr, 1fr], dense: true}
        shared:
          title: {matchingGroup: {group: cardTitle@tile, matchAll: true}}
          display: {valueLabel: {matchingGroup: {group: cardValue@tile, matchAll: true}}}
        items:
          - {type: realtime.text, key: environment.temperature.temperature, title: {text: Temperature}, display: {valueLabel: {color: $accent-text}}, grid: {column-span: 2, row-span: 2}, border: &card {enabled: true, edges: all, radius: $radius_card, fill: $surface, weight: 0}}
          - {type: realtime.text, key: environment.humidity.humidity, title: {text: Humidity}, border: *card}
          - {type: realtime.text, key: environment.pressure.pressure, title: {text: Pressure}, border: *card}
          - {type: realtime.text, key: environment.precipitation.precipitation, title: {text: Rain}, border: *card}
          - {type: realtime.text, key: environment.light.uvi, title: {text: UV}, border: *card}
          - {type: realtime.text, key: environment.wind.speed.speed, title: {text: Wind}, grid: {column-span: 3}, border: *card}
          - {type: realtime.text, key: environment.wind.gust.gust, title: {text: Gust}, grid: {column-span: 3, shrink: true}, border: *card}
