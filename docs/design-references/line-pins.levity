# Marks from another reading riding a line, each at its own time and height.
# Here the condition icon key puts its weather glyph on the temperature line.
# For a plain number, `steps` maps it to the glyph of the last row it reaches;
# an icon value (a condition icon key) needs no steps. `size` is pixels (or 5mm),
# `offset` is in sizes (negative = above the line), `spacing` the least gap
# between marks in sizes. Marks follow their key: a new reading redraws the plot.
# `key` takes an expression too, worked out at each sample time, so a pin can
# show the glyph only while it is raining (see the second figure's `key`).
- type: graph
  name: temperature
  timeframe: {days: 1, hours: 12}
  annotations:
    dayLabels: {enabled: false}
    hourLabels: {alignment: BottomCenter}
  figures:
  - figure: temperature
    margins: {bottom: 20%, top: 25%}
    environment.temperature.temperature:
      plot:
        type: plot
        gradient: TemperatureGradient
        pins:
          key: environment.condition.icon
          size: 22
      resolution: 2
