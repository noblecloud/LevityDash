# Two graphs of different height in one stack. Their day labels are in one size group (`parent.days`, match-all): the day names match across both graphs.
- type: stack
  name: board
  direction: Vertical
  geometry: {x: 1%, y: 1%, width: 98%, height: 98%}
  spacing: 2.5mm
  items:
  - type: graph
    name: graph0
    size: 49%
    timeframe: {days: 1}
    annotations:
      dayLabels: {position: Top, alignment: Center, opacity: 30%, height: 14%, matchingGroup: {group: parent.days, matchAll: true}}
      hourLabels: {alignment: BottomCenter, spacingIntervals: '1, 2, 3'}
    figures:
    - figure: temperature
      margins: {top: 42%, bottom: 24%}
      environment.temperature.temperature:
        plot: {type: plot, gradient: TemperatureGradient, weight: 0.9}
        resolution: 2
  - type: graph
    name: graph1
    size: 51%
    timeframe: {days: 1}
    annotations:
      dayLabels: {position: Top, alignment: Center, opacity: 30%, height: 14%, matchingGroup: {group: parent.days, matchAll: true}}
      hourLabels: {alignment: BottomCenter, spacingIntervals: '1, 2, 3'}
    figures:
    - figure: temperature
      margins: {top: 42%, bottom: 24%}
      environment.temperature.dewpoint:
        plot: {type: plot, gradient: TemperatureGradient, weight: 0.9}
        resolution: 2
